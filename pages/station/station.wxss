/* pages/station/station.wxss */
.station-page { padding: 28rpx 24rpx 60rpx; }
.st-hero { text-align: center; padding: 36rpx 0 30rpx; }
.st-hero-emoji { font-size: 72rpx; }
.st-hero-title { font-size: 38rpx; font-weight: 700; color: #3f3a52; margin-top: 10rpx; }
.st-hero-sub { font-size: 25rpx; color: #9a93ab; margin-top: 8rpx; }

.st-cards { display: flex; flex-direction: column; gap: 16rpx; }
.st-card { background: #fff; border-radius: 16rpx; padding: 4rpx 24rpx; box-shadow: 0 2rpx 10rpx rgba(80, 66, 122, 0.06); }
.st-head { display: flex; align-items: center; gap: 14rpx; padding: 26rpx 0; }
.st-emoji { font-size: 40rpx; }
.st-title { flex: 1; font-size: 28rpx; font-weight: 600; color: #403a4e; }
.st-arrow { font-size: 26rpx; color: #b8b1c6; transition: transform 0.2s; }
.st-arrow.up { transform: rotate(180deg); }
.st-body { padding: 6rpx 0 24rpx 54rpx; border-top: 1rpx dashed #efeafa; }
.st-line { font-size: 26rpx; color: #6b6480; line-height: 1.9; }

.st-actions { display: flex; gap: 16rpx; margin-top: 36rpx; }
.st-btn { flex: 1; text-align: center; padding: 20rpx 0; border-radius: 999rpx; font-size: 27rpx; }
.st-btn.primary { background: #7c6ec1; color: #fff; }
.st-btn.ghost { background: #fff; color: #7c6ec1; border: 1rpx solid #d6ceef; }
.st-foot { margin-top: 40rpx; font-size: 22rpx; color: #b0a9c0; line-height: 1.7; text-align: center; }

.daily-line { margin:18rpx 24rpx 6rpx; font-size:26rpx; color:#5a6a8b; background:linear-gradient(90deg,#fdf6ec,#fff); border:1rpx solid #f0e2cc; border-radius:14rpx; padding:16rpx 20rpx; line-height:1.6; }

.st-fav { color: #ffb347; font-size: 26rpx; margin-left: 10rpx; }

.daily-line { position: relative; padding-right: 120rpx; }
.dl-shuffle { position: absolute; right: 0; top: 50%; transform: translateY(-50%); font-size: 20rpx; color: #5b8def; border: 1rpx solid #d9e4f8; border-radius: 999rpx; padding: 4rpx 14rpx; }

.st-copy { display: inline-block; margin-top: 14rpx; font-size: 22rpx; color: #5b8def; border: 1rpx solid #cfe0fb; border-radius: 999rpx; padding: 8rpx 26rpx; }

.tag-filter { display: flex; flex-wrap: wrap; margin: 16rpx 24rpx 0; }
.tf-chip { font-size: 23rpx; color: #5b6b8c; background: #fff; border: 1rpx solid #e2e7f2; border-radius: 999rpx; padding: 8rpx 24rpx; margin: 0 12rpx 12rpx 0; }
.tf-chip.on { background: #5b8def; color: #fff; border-color: #5b8def; }

.fav-summary { margin: 14rpx 24rpx 0; font-size: 22rpx; color: #b07a2a; background: #fdf6ea; border: 1rpx solid #f0dcbc; border-radius: 12rpx; padding: 10rpx 18rpx; }

.top-read { margin: 14rpx 24rpx 0; font-size: 22rpx; color: #3f6498; background: #f0f7ff; border: 1rpx solid #d3e5fa; border-radius: 12rpx; padding: 10rpx 18rpx; line-height: 1.6; }

.draw-msg { margin: 14rpx 24rpx 0; font-size: 22rpx; color: #8a5a8c; background: #faf5fd; border: 1rpx solid #eadcf5; border-radius: 12rpx; padding: 10rpx 18rpx; line-height: 1.6; }

.read-total { margin: 16rpx 24rpx 0; font-size: 22rpx; color: #3f6498; background: #f0f7ff; border: 1rpx solid #d3e5fa; border-radius: 12rpx; padding: 10rpx 18rpx; text-align: center; }

.new-badge { display: inline-block; margin-left: 14rpx; font-size: 19rpx; color: #e05656; background: #fdeeee; border: 1rpx solid #f2c9c9; border-radius: 999rpx; padding: 2rpx 12rpx; vertical-align: middle; }
