<view class="station-page {{stLarge ? 'large' : ''}}">
  <view class="st-hero">
    <view class="st-hero-emoji">🔋</view>
    <view class="st-hero-title">情绪充电站</view>
    <view class="st-hero-sub">不是鸡汤，是能马上做的小事<text class="new-badge" wx:if="{{newCount}}">{{newCount}} 张待看 NEW</text></view>
    <view class="st-large-toggle" bindtap="toggleLarge" role="button" aria-label="切换大字模式">{{stLarge ? '📖 标准字' : '🔎 大字模式'}}</view>
  </view>

  <!-- 最近心情推荐：读最近一次心情，按情绪给 3 张卡（安静、不打扰） -->
  <view class="st-rec" wx:if="{{recCards}}" role="note" aria-label="按最近心情推荐卡片">
    <view class="st-rec-t">🌊 你最近一次心情偏「{{recMood}}」——这几张卡也许对得上</view>
    <view class="st-rec-reason" wx:if="{{recReason}}">{{recReason}}</view>
    <view class="st-rec-list">
      <view class="st-rec-item" wx:for="{{recCards}}" wx:key="index" data-idx="{{item.index}}" bindtap="openRec" role="button" aria-label="打开{{item.title}}">{{item.title}} ›</view>
    </view>
  </view>

  <view class="draw-msg" wx:if="{{drawMsg}}" role="note" aria-label="抽中提示">🎴 {{drawMsg}}
        <view class="draw-fav {{drawFaved ? 'done' : ''}}" bindtap="favDrawnCard" role="button" aria-label="收下这张卡">{{drawFaved ? "⭐ 已收下" : "☆ 收下这张"}}</view>
    <view class="draw-other" wx:if="{{drawOther}}" bindtap="openDrawOther" role="button" aria-label="展开另一张推荐卡片">也许这张也有用：「{{drawOther}}」›</view>
  </view>
  <view class="fav-stale" wx:if="{{favStale}}" role="note" aria-label="收藏提醒">{{favStale}}</view>
  <view class="week-reads" wx:if="{{weekReads}}" role="note" aria-label="本周充电小结">{{weekReads}}</view>
  <view class="draw-hist" wx:if="{{drawHist.length}}" role="group" aria-label="最近抽过的卡">
    <text class="dh-t">最近抽过：</text>
    <text class="dh-item" wx:for="{{drawHist}}" wx:key="t" data-t="{{item.t}}" bindtap="openDrawCard" role="button" aria-label="打开这张卡">{{item.t}}</text>
  </view>

  <!-- 常读提示：你最常翻的一张卡 -->
  <view class="top-read" wx:if="{{topRead}}" role="note" aria-label="最常翻的卡片">
    📖 你最常翻：「{{topRead.title}}」（{{topRead.n}} 次）——它似乎对你特别有用。
  </view>

  <!-- 收藏概览：已收藏几张、点开抽屉查看/取消。长按卡片头也可直接取消 -->
  <view class="fav-summary" wx:if="{{favTitles.length}}" role="button" bindtap="openFavDrawer" aria-label="打开我的收藏">
    ⭐ 已收藏 {{favTitles.length}}/3 张 · 点开看看 →
    <text class="fav-copy" catchtap="copyFavs" role="button" aria-label="复制收藏的卡片">📋 复制给朋友</text>
  </view>

  <!-- 我的收藏抽屉 -->
  <view class="fav-mask" wx:if="{{favOpen}}" bindtap="closeFavDrawer">
    <view class="fav-sheet" catchtap="noop">
      <view class="fav-sheet-title">⭐ 我的收藏（{{favList.length}}/3）</view>
      <scroll-view scroll-y class="fav-sheet-scroll">
        <view class="fav-item" wx:for="{{favList}}" wx:key="title">
          <view class="fav-item-main" bindtap="openFavCard" data-t="{{item.title}}" role="button" aria-label="打开卡片 {{item.title}}">
            <text class="fav-item-e">🃏</text>
            <text class="fav-item-t">{{item.title}}</text>
          </view>
          <view class="fav-item-x" bindtap="unfavFromDrawer" data-t="{{item.title}}" role="button" aria-label="取消收藏 {{item.title}}">✕</view>
        </view>
      </scroll-view>
      <view class="fav-sheet-close" bindtap="closeFavDrawer" role="button" aria-label="关闭">知道了</view>
    </view>
  </view>

  <!-- 按此刻心情筛选卡片 -->
  <view class="tag-filter" role="group" aria-label="按心情筛选卡片">
    <view class="tf-chip {{showTag === item ? 'on' : ''}}" wx:for="{{cardTags}}" wx:key="*this"
          data-t="{{item}}" bindtap="setCardTag" role="button" aria-label="筛选{{item}}">{{item}}</view>
  </view>

  <!-- 一句话速读：此刻只想要一句，点卡片只看核心句不展开 -->
  <view class="quick-read-toggle {{quickRead ? 'on' : ''}}" bindtap="toggleQuickRead" role="button" aria-label="切换一句话速读">
    {{quickRead ? '🌱 一句话速读已开——点卡只看核心一句' : '🌀 此刻只想要一句？开「一句话速读」'}}
  </view>

  <!-- 关键词搜索：忘了卡叫什么，多搜几次标题/内容/标签 -->
  <view class="st-search" role="search" aria-label="搜索充电站卡片">
    <input class="st-search-input" value="{{searchWord}}" placeholder="🔍 搜卡片：如「考试」「睡」「生气」…" confirm-type="search"
           bindinput="onSearchInput" bindconfirm="onSearchConfirm" />
    <view class="st-search-clear" wx:if="{{searchWord}}" bindtap="clearSearch" role="button" aria-label="清除搜索">✕</view>
  </view>
  <view class="st-search-empty" wx:if="{{searchWord && !cards.length}}" role="note" aria-label="没有找到卡片">
    没有找到相关卡片，换个词试试，或看看上面分类。
  </view>

  <view class="st-cards">
    <!-- 今天的一句（换日轮换，纯本地） -->
  <view class="daily-line" wx:if="{{todayLine}}" role="note" aria-label="今天的一句话">{{todayLine}}
    <text class="dl-shuffle" bindtap="reshuffleLine" role="button" aria-label="换一句">换一句</text>
  </view>

  <view class="st-card" wx:for="{{cards}}" wx:key="title">
      <view class="st-head" data-index="{{index}}" bindtap="toggleCard" bindlongpress="toggleFav" data-t="{{item.title}}"
            role="button" aria-label="展开或收起{{item.title}}，长按收藏">
        <text class="st-emoji">{{item.emoji}}</text>
        <text class="st-title">{{item.title}}</text>
        <text class="st-read-n" wx:if="{{stReads[item.title] >= 2}}">{{stReads[item.title]}}次</text>
        <text class="st-fav" wx:if="{{favTitles.indexOf(item.title) > -1}}">★</text>
        <text class="st-arrow {{open === index ? 'up' : ''}}">▾</text>
      </view>
      <view class="st-body" wx:if="{{open === index}}">
        <view class="st-line" wx:for="{{item.lines}}" wx:for-item="ln" wx:key="*this">{{ln}}</view>
        <view class="st-go" wx:if="{{item.act}}" bindtap="goAct" data-act="{{item.act.k}}" role="button" aria-label="按卡片建议去做">{{item.act.label}} ›</view>
        <view class="st-copy" bindtap="copyCard" data-i="{{index}}" role="button" aria-label="复制这张卡">📄 复制这张卡</view>
        <!-- 一起充电：同主题推荐（未读优先，点开即换一张） -->
        <view class="st-like" wx:if="{{likeCards.length}}">
          <view class="st-like-t">🔋 一起充电 · 同主题还有</view>
          <view class="st-like-row" wx:for="{{likeCards}}" wx:key="title" wx:for-item="lk"
                bindtap="openLikeCard" data-index="{{lk.index}}" role="button" aria-label="展开{{lk.title}}">
            <text class="st-like-e">{{lk.emoji}}</text>
            <text class="st-like-title">{{lk.title}}</text>
            <text class="st-like-tags">{{lk.tags}}</text>
            <text class="st-like-go">›</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="st-actions">
    <view class="st-btn primary" bindtap="goBreathe" role="button" aria-label="去做 3 分钟呼吸练习">🧘 现在做一次呼吸</view>
    <view class="st-btn ghost" bindtap="goChat" role="button" aria-label="和心语聊聊此刻的感受">💬 和心语聊聊</view>
    <view class="st-btn ghost" bindtap="goMood" role="button" aria-label="记下此刻心情并看情绪曲线">🌈 记下此刻心情</view>
    <view class="st-btn ghost" bindtap="goEdu" role="button" aria-label="打开心理小课学点知识">📚 心理小课（6 节）</view>
    <view class="st-btn ghost" bindtap="randomCard" role="button" aria-label="随机抽一张充电卡">🎴 不知道做哪张？抽一张</view>
  </view>

  <view class="today-read" wx:if="{{todayReads}}" role="note" aria-label="今日充电次数">
  ⚡ 今天已经翻阅过 {{todayReads}} 张充电卡<text wx:if="{{todayReads >= 3}}">——你已经很会照顾自己了</text>
</view>
<view class="read-total" wx:if="{{readTotal >= 5}}" role="note" aria-label="阅读总数">📚 你已经在这里翻阅过 {{readTotal}} 次自救方法——这些本事都是你的了。</view>
  <view class="st-foot">* 内容为心理学科普与自助技巧，不替代专业诊断。若情况紧急，请去「求助」页拨打热线。</view>
</view>