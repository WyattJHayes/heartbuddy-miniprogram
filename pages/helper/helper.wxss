.urgent { background: linear-gradient(135deg, #fff2f0, #ffece8); border: 2rpx solid #ffb4a8; }
.heart-title { font-size: 32rpx; font-weight: 600; color: #b33a2a; margin-bottom: 12rpx; }
.urgent-text { font-size: 28rpx; line-height: 1.7; }

.urgent-num {
  margin-top: 20rpx; padding: 20rpx 24rpx; border-radius: 24rpx;
  background: #ffffff; display: flex; align-items: center; justify-content: space-between; gap: 16rpx;
}
.urgent-num-hl { font-size: 30rpx; font-weight: 700; color: #d6483a; }
.urgent-num-desc { font-size: 22rpx; color: #9ca3af; margin-top: 4rpx; }
.dial-big { background: #e05c53; color: #fff; border-radius: 40rpx; padding: 0 40rpx; font-size: 28rpx; }

.line { display: flex; align-items: center; justify-content: space-between; padding: 16rpx 0; border-bottom: 1rpx solid #f3f4f6; }
.line:last-child { border-bottom: none; }
.line-name { font-size: 28rpx; font-weight: 500; }
.line-desc { font-size: 24rpx; color: #9ca3af; margin-top: 4rpx; }
.dial { background: #5b8def; color: #fff; font-size: 26rpx; border-radius: 32rpx; padding: 0 32rpx; }

.tip-item { font-size: 28rpx; line-height: 1.8; }.breathe-link { color: #3f6fd8; background: #eef4ff; border-radius: 16rpx; padding: 18rpx 22rpx; margin-top: 10rpx; font-weight: 600; line-height: 1.6; }

/* 今日关怀 */
.care { background: linear-gradient(135deg, #eef4ff, #fdf4ec); border: none; }
.care-head { display: flex; align-items: center; gap: 20rpx; }
.care-emoji { font-size: 56rpx; }
.care-title { font-size: 30rpx; font-weight: 700; color: #2a3b55; }
.care-sub { font-size: 22rpx; color: #8a97ad; margin-top: 6rpx; }
.care-text { margin-top: 16rpx; font-size: 27rpx; color: #4a5b76; line-height: 1.7; }

/* 英语角 */
.en-item { display: flex; align-items: center; gap: 20rpx; padding: 18rpx 0; border-bottom: 1rpx solid #f1f3f8; }
.en-item:last-child { border-bottom: none; }
.en-main { flex: 1; }
.en-line { font-size: 27rpx; color: #3a4a63; }
.en-zh { font-size: 23rpx; color: #8a97ad; margin-top: 6rpx; }
.en-copy { font-size: 23rpx; color: #3f6fd8; background: #eef4ff; padding: 8rpx 22rpx; border-radius: 999rpx; font-weight: 600; }

/* 我撑过来了：5 步自助 */
.self { background: linear-gradient(160deg, #f2f7ff, #fff7ee); }
.self-sub { font-size: 21rpx; color: #8a97ad; font-weight: 400; margin-left: 8rpx; }
.self-text { margin-top: 10rpx; font-size: 25rpx; color: #5a6b85; line-height: 1.7; }
.self-start { margin-top: 20rpx; }
.self-last { margin-top: 20rpx; background: #fff; border-radius: 14rpx; padding: 18rpx 22rpx; }
.self-last-title { font-size: 22rpx; color: #8a97ad; }
.self-last-text { margin-top: 8rpx; font-size: 25rpx; color: #4a5b76; line-height: 1.6; }
.self-steps { display: flex; gap: 12rpx; margin: 4rpx 0 18rpx; }
.self-dot { width: 34rpx; height: 8rpx; border-radius: 999rpx; background: #e3e8f1; }
.self-dot.on { background: #ffb054; }
.self-q { font-size: 28rpx; font-weight: 600; color: #2a3b55; line-height: 1.6; }
.self-ta { width: 100%; box-sizing: border-box; min-height: 140rpx; margin-top: 16rpx; background: #fff; border: 1rpx solid #e3e8f1; border-radius: 14rpx; padding: 18rpx; font-size: 26rpx; color: #3a4a63; }
.self-actions { display: flex; align-items: center; justify-content: flex-end; gap: 24rpx; margin-top: 16rpx; }
.self-skip { font-size: 25rpx; color: #a3aec4; }
.self-next { margin: 0; }

/* 回访关怀卡 */
.follow-care { background: linear-gradient(135deg, #fff5f1, #fff); border: 1rpx solid #ffd9cc; }
.fc-head { display: flex; gap: 18rpx; }
.fc-emoji { font-size: 44rpx; line-height: 1.2; }
.fc-body { flex: 1; }
.fc-title { font-size: 28rpx; font-weight: 700; color: #7a4a3a; }
.fc-text { margin-top: 10rpx; font-size: 25rpx; color: #5a3a2a; line-height: 1.7; }
.fc-due { margin-top: 8rpx; font-size: 23rpx; color: #c98a6b; }
.fc-btn { margin-top: 20rpx; }

/* 快捷练习直达卡 */
.quick-tools { }
.qt-row { display: flex; gap: 20rpx; }
.qt-card { flex: 1; background: #f4f8ff; border: 1rpx solid #e0eaff; border-radius: 18rpx;
  padding: 24rpx 20rpx; display: flex; flex-direction: column; align-items: center; }
.qt-emoji { font-size: 52rpx; line-height: 1.2; }
.qt-name { margin-top: 10rpx; font-size: 28rpx; font-weight: 600; color: #2d3a55; }
.qt-sub { margin-top: 4rpx; font-size: 22rpx; color: #9aa7bf; }

/* 求助后静音关怀 */
.hush-care { background: linear-gradient(135deg, #f0f7ee, #fafdf8); border-color: #dcecd8; }
.hc-head { display: flex; align-items: center; justify-content: space-between; }
.hc-title { font-size: 28rpx; font-weight: 700; color: #3d6b3a; }
.hc-close { font-size: 30rpx; color: #9ab895; padding: 4rpx 8rpx; }
.hc-text { margin-top: 10rpx; font-size: 25rpx; color: #6a8f66; line-height: 1.7; }

/* 智能分流：此刻建议 */
.smart-tip { background: linear-gradient(135deg, #f3f8ff, #fafcff); border-color: #dbe7fb; }
.st-head { display: flex; align-items: center; gap: 12rpx; }
.st-emoji { font-size: 32rpx; }
.st-title { font-size: 27rpx; font-weight: 700; color: #3a5a8c; }
.st-text { margin-top: 8rpx; font-size: 25rpx; color: #5b6f8d; line-height: 1.7; }

.sms-btn { margin-top: 18rpx; text-align: center; font-size: 26rpx; color: #3f6fe0;
  background: #eef3ff; border-radius: 999rpx; padding: 16rpx 20rpx; }

.qt-card.comfort { background: linear-gradient(160deg,#fff6ec,#ffe9d6); }

.now-tg { background:linear-gradient(180deg,#fff,#f7f9ff); }
.now-tg .section-title { font-size:26rpx; color:#33415c; }
.tg-grid { display:flex; gap:14rpx; margin-top:14rpx; }
.tg-item { flex:1; text-align:center; font-size:24rpx; color:#33415c; background:#eef2fb; border:1rpx solid #e1e7f4; border-radius:14rpx; padding:18rpx 6rpx; }
.tgmore { text-align:center; font-size:22rpx; color:#8a95b3; margin-top:12rpx; }


.urgent-safe { margin-top:16rpx; background:rgba(255,255,255,.55); border-radius:12rpx; padding:12rpx 16rpx; display:flex; align-items:center; flex-wrap:wrap; }
.urgent-safe-t { font-size:22rpx; color:#8b9ac0; margin-right:8rpx; }
.urgent-safe-n { font-size:26rpx; font-weight:600; color:#8f6b1f; }
.urgent-edit { font-size:20rpx; color:#7a86a6; margin-left:auto; padding:2rpx 10rpx; border:1rpx solid #cfd9ee; border-radius:8rpx; }
.urgent-safe-set { margin-top:16rpx; font-size:23rpx; color:#5a6a8b; background:rgba(255,255,255,.55); border-radius:12rpx; padding:12rpx 16rpx; }


.askfor { margin-top: 20rpx; }
.af-text { font-size: 24rpx; color: #6b7690; line-height: 1.7; margin-top: 10rpx; }
.af-chips { display: flex; flex-wrap: wrap; margin-top: 16rpx; }
.af-chip { font-size: 24rpx; color: #5b6b8c; background: #eef3fc; border: 1rpx solid #dbe6f8; border-radius: 999rpx; padding: 10rpx 24rpx; margin: 0 14rpx 14rpx 0; }
.af-chip.on { background: #5b8def; color: #fff; border-color: #5b8def; }
.af-out { margin-top: 16rpx; background: #f8fafd; border: 1rpx solid #e3ecf9; border-radius: 14rpx; padding: 18rpx 20rpx; }
.af-out-text { font-size: 25rpx; color: #3a465e; line-height: 1.8; }
.af-actions { display: flex; margin-top: 16rpx; }
.af-btn { flex: 1; text-align: center; background: #5b8def; color: #fff; border-radius: 999rpx; padding: 12rpx 0; font-size: 24rpx; margin-right: 12rpx; }
.af-btn.ghost { background: #fff; color: #5b8def; border: 1rpx solid #cfe0fb; margin-right: 0; }
.af-hint { margin-top: 14rpx; font-size: 22rpx; color: #9aa3b8; line-height: 1.6; }

.card.grad { margin-top: 20rpx; background: linear-gradient(160deg, #f4faf6, #fdfff9); border: 1rpx solid #dcefdf; }
.grad-emoji { font-size: 52rpx; text-align: center; margin-top: 8rpx; }
.grad-title { text-align: center; font-size: 30rpx; font-weight: 700; color: #2f7a4d; margin-top: 10rpx; }
.grad-text { font-size: 24rpx; color: #5a6f60; line-height: 1.8; margin-top: 12rpx; }
.grad-actions { margin-top: 16rpx; }
.grad-btn { background: #4f9e6b; color: #fff; text-align: center; border-radius: 999rpx; padding: 14rpx 0; font-size: 26rpx; }
.grad-close { margin-top: 12rpx; text-align: center; font-size: 24rpx; color: #9aa3b8; }

.safe-contacts { display: flex; flex-wrap: wrap; margin: 10rpx 0 4rpx; }
.sc-chip { display: flex; align-items: center; background: #f2f7ff; border: 1rpx solid #d9e6fb; border-radius: 999rpx; padding: 8rpx 20rpx; margin: 0 12rpx 12rpx 0; }
.sc-name { font-size: 26rpx; color: #3f5c95; font-weight: 600; }
.sc-act { font-size: 22rpx; color: #5b8def; margin-left: 10rpx; }

.af-parent { margin-top: 16rpx; background: #fdf6ec; border: 1rpx dashed #e4c9a1; border-radius: 12rpx; padding: 14rpx 18rpx; font-size: 23rpx; color: #8a6a2f; line-height: 1.7; }

.friend-card { margin-top: 20rpx; background: #fbf8ff; border: 1rpx solid #e4dcf5; }
.fr-item { font-size: 24rpx; color: #5b5480; line-height: 1.8; margin-top: 8rpx; }
.fr-copy { margin-top: 16rpx; display: inline-block; background: #8a7bd0; color: #fff; border-radius: 999rpx; padding: 12rpx 30rpx; font-size: 24rpx; }

.af-hist { margin-top: 16rpx; }
.af-hist-t { font-size: 22rpx; color: #9aa3b8; }
.af-hist-item { margin-top: 10rpx; font-size: 23rpx; color: #5b6b8c; background: #f6f8fc; border-radius: 10rpx; padding: 10rpx 16rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.call-log { margin-top: 16rpx; background: #f6fbf6; border: 1rpx solid #d9ecd9; border-radius: 12rpx; padding: 14rpx 18rpx; }
.cl2-title { font-size: 23rpx; color: #3f7a52; font-weight: 600; }
.cl2-item { font-size: 22rpx; color: #5a7a62; margin-top: 8rpx; }
.cl2-note { margin-top: 10rpx; font-size: 21rpx; color: #8aa692; }

.safe-pack-ops { display: flex; margin-top: 10rpx; }
.spo-btn { font-size: 22rpx; color: #3f5c95; background: #f2f7ff; border: 1rpx solid #d9e6fb; border-radius: 999rpx; padding: 8rpx 22rpx; margin-right: 14rpx; }
.spo-btn.ghost { background: #fff; }

.urgent-breathe { margin-top: 14rpx; background: #f0f7ff; border: 1rpx dashed #b9d4f5; border-radius: 12rpx; padding: 14rpx 18rpx; font-size: 23rpx; color: #3f6498; line-height: 1.7; }

.hc-end { font-size: 20rpx; color: #7a9a82; border: 1rpx solid #cfe3d4; border-radius: 999rpx; padding: 4rpx 14rpx; margin-right: 12rpx; }
