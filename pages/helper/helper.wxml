<view class="container">
  <!-- 求助后静音关怀：安排回访 3 天内，顶部一条轻量关怀（不弹窗、可关闭、当天不再显示） -->
  <view class="card hush-care" wx:if="{{hushCare}}">
    <view class="hc-head">
      <view class="hc-title">我在，等你回来找到我 🌿</view>
      <view class="hc-close" bindtap="closeHushCare" role="button" aria-label="关闭这条关怀">✕</view>
    </view>
    <view class="hc-text">你把今天的担子交给了心语。这三天不用急，照顾好自己；想说话的时候，我一直在听。</view>
  </view>

  <!-- 智能分流：此刻建议（按时段/连续低情绪天数，轻提示条） -->
  <view class="card smart-tip" wx:if="{{smartTip}}">
    <view class="st-head">
      <view class="st-emoji">{{smartTip.emoji}}</view>
      <view class="st-title">{{smartTip.title}}</view>
    </view>
    <view class="st-text">{{smartTip.text}}</view>
  </view>

  <!-- 回访关怀卡：管理员安排的回访，用户端可见（有回访才显示） -->
  <view class="card follow-care" wx:if="{{followCare}}">
    <view class="fc-head">
      <view class="fc-emoji">💌</view>
      <view class="fc-body">
        <view class="fc-title">我在意你 · 回访关怀</view>
        <view class="fc-text">{{followCare.note}}</view>
        <view class="fc-due">⏳ 回访时限：{{followCare.dueText}}</view>
      </view>
    </view>
    <button class="btn-primary fc-btn" bindtap="goChat">去和心语聊聊</button>
  </view>

  <!-- 快捷练习：呼吸 / 身体扫描 一路直达 -->
  <view class="card quick-tools">
    <view class="section-title">立刻做点什么</view>
    <view class="qt-row">
      <view class="qt-card" role="button" bindtap="onComfort" aria-label="要一句安慰的话">
        <view class="qt-emoji">💬</view>
        <view class="qt-name">要一句安慰</view>
        <view class="qt-sub">一句话 · 先接住此刻</view>
      </view>
      <view class="qt-card" role="button" bindtap="goChat" aria-label="去找心语聊一聊">
        <view class="qt-emoji">🌱</view>
        <view class="qt-name">找心语聊聊</view>
        <view class="qt-sub">随时都在 · 不评判</view>
      </view>
    </view>
    <view class="qt-row">
      <view class="qt-card" role="button" bindtap="goBreathe" aria-label="去 3 分钟呼吸练习">
        <view class="qt-emoji">🧘</view>
        <view class="qt-name">呼吸练习</view>
        <view class="qt-sub">3 分钟 · 快速放松</view>
      </view>
      <view class="qt-card" role="button" bindtap="goScan" aria-label="去 5 分钟身体扫描">
        <view class="qt-emoji">🧭</view>
        <view class="qt-name">身体扫描</view>
        <view class="qt-sub">5 分钟 · 安静下来</view>
      </view>
    </view>
    <view class="qt-row" style="margin-top: 12rpx;">
      <view class="qt-card" role="button" bindtap="goStation" aria-label="去情绪充电站学一点舒缓方法">
        <view class="qt-emoji">🔋</view>
        <view class="qt-name">情绪充电站</view>
        <view class="qt-sub">知识 · 急救 · 舒缓技巧</view>
      </view>
      <view class="qt-card" role="button" bindtap="goChat" aria-label="去和 AI 聊天">
        <view class="qt-emoji">💬</view>
        <view class="qt-name">和心语聊聊</view>
        <view class="qt-sub">说给我听 · 我在</view>
      </view>
    </view>
  </view>

  <!-- 今日关怀：日轮换轻贴士 -->
  <view class="card care" wx:if="{{care}}">
    <view class="care-head">
      <view class="care-emoji">{{care.emoji}}</view>
      <view>
        <view class="care-title">{{care.title}}</view>
        <view class="care-sub">今日关怀 · 每天一句，照顾忙碌的你</view>
      </view>
    </view>
    <view class="care-text">{{care.text}}</view>
  </view>

  <!-- 我撑过来了：5 步自助引导（自救卡） -->
  <view class="card self">
    <block wx:if="{{selfStep === -1}}">
      <view class="section-title">🪜 我撑过来了 <text class="self-sub">5 步自助</text></view>
      <view class="self-text">情绪汹涌时，不必立刻“搞定”它。顺着这 5 个问题慢慢走一遍，写完常常会发现自己比想象中更有力量。</view>
      <button wx:if="{{selfResumeStep}}" class="btn-primary self-start" bindtap="selfResume">接着上次的第 {{selfResumeStep}} 步走</button>
      <button class="{{selfResumeStep ? 'btn-ghost' : 'btn-primary'}} self-start" bindtap="selfStart">{{selfResumeStep ? '重新开始 5 步' : '开始 5 步'}}</button>
      <view class="self-last" wx:if="{{selfLast}}">
        <view class="self-last-title">上次的收尾（{{selfLast.date}}）</view>
        <view class="self-last-text">{{selfLast.done}}</view>
      </view>
    </block>
    <block wx:else>
      <view class="self-steps">
        <view class="self-dot {{selfStep === index ? 'on' : ''}}" wx:for="{{selfCare}}" wx:key="index"></view>
      </view>
      <view class="self-q">{{self[selfStep].q}}</view>
      <textarea class="self-ta" value="{{selfInput}}" bindinput="onSelfInput" placeholder="想到多少写多少，不用写得很漂亮…" maxlength="300" auto-height />
      <view class="self-actions">
        <view class="self-skip" bindtap="selfClose">先收起</view>
        <button class="btn-primary self-next" bindtap="selfNext">{{selfStep === 4 ? '完成这一次' : '下一步'}}</button>
      </view>
    </block>
  </view>

  <view class="card urgent">
    <view class="section-title">如果你现在很不好</view>
    <view class="urgent-text">请优先联系最近的成年人、老师或直接拨打心理援助热线。你不需要独自承受。</view>
    <view class="urgent-num">
      <view class="urgent-num-main">
        <view class="urgent-num-hl">你永远可以拨打 12356</view>
        <view class="urgent-num-desc">全国统一心理援助热线 · 24 小时免费</view>
      </view>
      <button class="dial dial-big" data-number="12356" bindtap="call">拨打</button>
    </view>
    <view class="sms-btn" bindtap="copyHelpSms" role="button" aria-label="复制一段求助文字发给信任的人">📋 复制一段文字，发给信任的人（长辈/老师）</view>
  </view>

  <view class="card">
    <view class="section-title">心理援助热线</view>
    <view class="line" wx:for="{{hotlines}}" wx:key="name">
      <view class="line-main">
        <view class="line-name">{{item.name}}</view>
        <view class="line-desc">{{item.free}} · {{item.number}}</view>
      </view>
      <button class="dial" data-number="{{item.number}}" bindtap="call">拨打</button>
    </view>
    <view class="text-muted tip">热线号码请以官方最新发布为准。</view>
  </view>

  <view class="card">
    <view class="section-title">已经缓过来了？</view>
    <view class="text-muted tip">如果你此刻已经感到安全、有了依靠，可以在这里打个回执。心语会在 24 小时后轻声回访一次，不会打扰，只想知道你现在好不好。</view>
    <button class="btn-ghost full" bindtap="checkSafe" disabled="{{safety}}">{{safety ? '已安排 24 小时回访 ✓' : '我已安全，请 24 小时后来看看我'}}</button>
  </view>

  <view class="card">
    <view class="section-title">还能做什么</view>
    <view class="tip-item">· 找一位信任的家人/老师/朋友聊一聊</view>
    <view class="tip-item">· 去正规医院的临床心理科挂号咨询</view>
    <view class="tip-item">· 回到「陪伴」页，让心语陪你说说话</view>
    <view class="tip-item breathe-link" role="button" bindtap="goBreathe">🧘 如果很焦虑，先跟着 4 轮呼吸放松一下 →</view>
    <view class="tip-item breathe-link" role="button" bindtap="goScan">🧭 想安静下来，试试 5 分钟身体扫描 →</view>
  </view>

  <!-- 英语角：想用英语说时，复制粘贴到聊天即可 -->
  <view class="card">
    <view class="section-title">🇬🇧 英语角：English Corner</view>
    <view class="text-muted tip">心语支持中英文自由切换，复制下面任意一句，回到「陪伴」页粘贴发送即可，AI 会用英文回应。</view>
    <view class="en-item" wx:for="{{englishPhrases}}" wx:key="en" data-en="{{item.en}}" bindtap="copyEn" role="button" aria-label="复制英文句子 {{item.en}}">
      <view class="en-main">
        <view class="en-line">{{item.en}}</view>
        <view class="en-zh">{{item.zh}}</view>
      </view>
      <view class="en-copy">复制</view>
    </view>
  </view>

  <view class="card">
    <view class="section-title">危机应对流程</view>
    <crisis-flow></crisis-flow>
  </view>

  <view class="card">
    <view class="section-title">重要说明</view>
    <view class="text-muted">心语伴是 AI 情绪陪伴助手，不能替代专业医疗诊断与治疗。危机时刻请优先寻求专业或他人帮助。</view>
  </view>
</view>