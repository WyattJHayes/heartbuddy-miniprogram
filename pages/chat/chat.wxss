
.chat-stats { text-align: right; font-size: 22rpx; color: #b0a48d; margin: 6rpx 24rpx 2rpx; }
.chat-page { display: flex; flex-direction: column; height: 100vh; background: #f7f8fb; }
.msg-scroll { flex: 1; overflow: hidden; }
.msg-list { padding: 24rpx; }

.row { display: flex; margin-bottom: 20rpx; }
.row.left { justify-content: flex-start; align-items: flex-end; }
.row.right { justify-content: flex-end; }

.msg { max-width: 76%; padding: 20rpx 24rpx; border-radius: 20rpx; font-size: 30rpx; line-height: 1.6; }
.user-msg { background: #5b8def; color: #fff; border-bottom-right-radius: 6rpx; }
.ai-msg { background: #f2f4f8; color: #1f2937; border-bottom-left-radius: 6rpx; }
.cursor { color: #5b8def; }

/* AI 头像情绪态 */
.ai-avatar { width: 64rpx; height: 64rpx; border-radius: 50%; background: #eaf0ff; border: 1rpx solid #dbe4fa;
  display: flex; align-items: center; justify-content: center; font-size: 36rpx; margin-right: 12rpx; flex-shrink: 0; }

.quick { padding: 24rpx; }
.quick-title { color: #9ca3af; font-size: 26rpx; margin-bottom: 16rpx; }
.quick-list { display: flex; flex-wrap: wrap; gap: 16rpx; }
.quick-item {
  background: #eef3ff; color: #4a6fc4; font-size: 26rpx;
  padding: 14rpx 24rpx; border-radius: 32rpx;
}
.bilingual-hint {
  margin-top: 16rpx; font-size: 24rpx; color: #9ca3af; line-height: 1.6;
}

.input-bar {
  border-top: 1rpx solid #eee;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
}
.mood-tags { display: flex; gap: 14rpx; margin-bottom: 14rpx; }
.tag {
  font-size: 24rpx; color: #6b7280; background: #f7f8fb;
  padding: 8rpx 20rpx; border-radius: 28rpx;
}
.tag.on { background: #e8f0ff; color: #5b8def; font-weight: 600; }

.input-row { display: flex; align-items: center; gap: 16rpx; }
.quick-toggle {
  flex-shrink: 0; font-size: 24rpx; color: #4a6fc4; background: #eef3ff;
  padding: 10rpx 22rpx; border-radius: 32rpx; line-height: 1.4;
}
.quick-toggle.on { background: #5b8def; color: #fff; }

.reset-chat {
  flex-shrink: 0; font-size: 26rpx; color: #8a94a8; background: #f1f3f8;
  width: 56rpx; height: 56rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center; margin: 0 4rpx 0 12rpx;
}

.quick-panel { margin-top: 16rpx; padding: 16rpx; background: #f7f9ff; border-radius: 20rpx; }
.quick-panel-title { color: #9ca3af; font-size: 24rpx; margin-bottom: 12rpx; }
.quick-panel-list { display: flex; flex-wrap: wrap; gap: 14rpx; }
.quick-panel-item {
  background: #eef3ff; color: #4a6fc4; font-size: 25rpx;
  padding: 12rpx 22rpx; border-radius: 30rpx;
}
.input {
  flex: 1; height: 76rpx; background: #f7f8fb; border-radius: 40rpx;
  padding: 0 32rpx; font-size: 30rpx;
}
.send { background: #5b8def; color: #fff; border-radius: 40rpx; padding: 0 40rpx; font-size: 28rpx; }
/* 英语角 */
.en-list { margin-top: 12rpx; }
.quick-item.en { background: #eef7f0; color: #3c8d5c; }
.quick-panel-item.en { background: #eef7f0; color: #3c8d5c; }
.quick-panel-title.en { margin-top: 12rpx; font-size: 24rpx; color: #9ca3af; }

/* 紧急时刻英语角 */
.emg-list { margin-top: 12rpx; }
.quick-item.emg { background: #fff2f0; color: #b33a2a; border: 1rpx solid #ffb4a8; }
.quick-panel-item.emg { background: #fff2f0; color: #b33a2a; border: 1rpx solid #ffb4a8; }
.quick-panel-title.emg { margin-top: 12rpx; font-size: 24rpx; color: #b0523f; }
.emg-hint { font-size: 22rpx; color: #a0524a; margin-top: 10rpx; line-height: 1.6; }

/* 新手引导（一次性） */
.onboard { position: fixed; inset: 0; background: rgba(13,22,38,.58); z-index: 200; display: flex; align-items: center; justify-content: center; padding: 60rpx; }
.onboard-card { width: 100%; max-width: 560rpx; background: #fff; border-radius: 36rpx; padding: 56rpx 44rpx 40rpx; box-shadow: 0 20rpx 60rpx rgba(20,30,60,.25); text-align: center; }
.ob-emoji { font-size: 96rpx; }
.ob-title { font-size: 34rpx; font-weight: 700; color: #2a3b55; margin-top: 18rpx; }
.ob-desc { font-size: 27rpx; color: #5b6b85; line-height: 1.7; margin-top: 14rpx; }
.ob-dots { display: flex; justify-content: center; gap: 14rpx; margin-top: 34rpx; }
.ob-dot { width: 14rpx; height: 14rpx; border-radius: 999rpx; background: #d7deea; }
.ob-dot.on { width: 32rpx; background: #5b8def; }
.ob-actions { display: flex; gap: 20rpx; margin-top: 40rpx; }
.ob-skip { flex: 1; background: #f1f3f7; color: #6b7b95; border-radius: 999rpx; font-size: 27rpx; }
.ob-next { flex: 2; background: #5b8def; color: #fff; border-radius: 999rpx; font-size: 27rpx; font-weight: 600; }

/* 天气角 */
.weather-bar { display: flex; align-items: center; gap: 10rpx; padding: 12rpx 30rpx; font-size: 23rpx; color: #5b6b85; background: #f4f8ff; border-bottom: 1rpx solid #e6edf8; }
.w-ico { font-size: 26rpx; }
.w-text { letter-spacing: 1rpx; }

/* 今日心语 */
.quote-bar { display: flex; align-items: center; gap: 10rpx; margin: 0 24rpx 16rpx; padding: 16rpx 20rpx; background: linear-gradient(135deg, #f2f7ff, #fff6ee); border-radius: 12rpx; }
.q-ico { font-size: 28rpx; }
.q-text { flex: 1; font-size: 25rpx; color: #4a5b76; line-height: 1.6; }
.q-copy { font-size: 22rpx; color: #5d8def; flex-shrink: 0; }

/* 深夜工具箱 */
.night-bar { margin: 0 24rpx 16rpx; padding: 20rpx; background: linear-gradient(150deg, #eef3fb, #f7f2ff); border-radius: 12rpx; }
.night-title { display: block; font-size: 24rpx; color: #4a5b76; font-weight: 600; }
.night-chips { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 14rpx; }
.night-chip { font-size: 23rpx; color: #3f6fe0; background: #fff; border: 1rpx solid #dbe4f5; border-radius: 999rpx; padding: 10rpx 22rpx; }

/* 此刻强度滑条 */
.intensity-row { display: flex; align-items: center; margin: 10rpx 6rpx 14rpx; }
.intensity-label { flex-shrink: 0; font-size: 22rpx; color: #8a94a8; margin-right: 14rpx; }
.intensity-slider { flex: 1; margin: 0 10rpx; }
.intensity-num { flex-shrink: 0; width: 44rpx; height: 44rpx; border-radius: 50%; background: #eef3ff; color: #4a6fc4;
  font-size: 24rpx; font-weight: 700; display: flex; align-items: center; justify-content: center; }
.intensity-num.high { background: #ffe9e6; color: #e25c4a; }

/* 倾诉后小结算 */
.feeling-bar { margin: 0 24rpx 16rpx; background: #fff; border: 1rpx solid #e3e9f4; border-radius: 16rpx;
  padding: 18rpx 22rpx 22rpx; box-shadow: 0 4rpx 16rpx rgba(63, 111, 224, .08); }
.feeling-head { display: flex; align-items: center; justify-content: space-between; font-size: 24rpx; color: #7a8698; }
.feeling-close { color: #b3bdcf; font-size: 28rpx; padding: 0 8rpx; }
.feeling-tags { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 14rpx; }
.feeling-tag { background: #eef3ff; border-radius: 999rpx; padding: 8rpx 22rpx; font-size: 25rpx; color: #3f6fe0; }

/* 引用条：长按「引用这条」后带入输入框 */
.reply-bar { display: flex; align-items: flex-start; gap: 12rpx; padding: 12rpx 16rpx;
  background: #f2f6ff; border-left: 6rpx solid #5b8def; border-radius: 10rpx; margin-bottom: 12rpx; }
.reply-tag { flex-shrink: 0; font-size: 20rpx; color: #4a7be0; font-weight: 600; margin-top: 4rpx; }
.reply-text { flex: 1; font-size: 23rpx; color: #4a5568; line-height: 1.6;
  display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
.reply-close { flex-shrink: 0; color: #98a2b5; font-size: 28rpx; padding: 0 4rpx; }

/* 连续低落情绪关怀条 */
.low-care { display: flex; align-items: flex-start; gap: 12rpx; padding: 16rpx 18rpx;
  background: linear-gradient(135deg, #fdf5f3, #fef9f7); border: 1rpx solid #f2dcd6;
  border-radius: 14rpx; margin: 12rpx 16rpx 0; }
.lc-body { flex: 1; }
.lc-text { font-size: 26rpx; color: #a05c4e; line-height: 1.7; }
.lc-actions { margin-top: 8rpx; }
.lc-later { display: inline-block; font-size: 22rpx; color: #c0806f; padding: 4rpx 0; }
.lc-close { flex-shrink: 0; font-size: 28rpx; color: #d9a99c; padding: 4rpx 6rpx; }

/* 自我安抚短句（快捷面板） */
.quick-panel-title.sooth { color: #7a5aa0; }
.quick-panel-item.sooth { background: #f4effa; color: #6d4d97; }

.lc-say { font-size: 22rpx; color: #b36b98; text-decoration: underline; margin-right: 20rpx; }

.today-n { font-size: 22rpx; color: #9a7b54; background: #fbf6ec; border-radius: 999rpx;
  margin: 0 24rpx 12rpx; padding: 8rpx 22rpx; display: inline-block; align-self: flex-start; }
.quick-panel-title.warm { color: #b06e2f; }
.quick-panel-item.warm { background: #fff3e0; color: #8a5a1e; }

.night-chip.hot { background:#ffe9d6; color:#a3541c; }

.quick-panel-title.calm { color: #2f8f7f; }
.quick-panel-item.calm { background: #e6f6f2; color: #1f6b5f; }

.collapse-bar { text-align:center; font-size: 23rpx; color:#4a6fd8; background:#eef2fb; border-radius:999rpx; margin: 8rpx 40rpx; padding: 8rpx 0; }
.fold-bar { text-align:center; font-size: 22rpx; color:#b0a48d; padding: 6rpx 0; }

.persona-bar { display:flex; align-items:center; gap:10rpx; padding:10rpx 24rpx; }
.p-chip { font-size:22rpx; color:#6a7694; background:#f2f4fa; border:1rpx solid #e4e8f2; border-radius:999rpx; padding:6rpx 18rpx; }
.p-chip.on { color:#fff; background:#5b8def; border-color:#5b8def; }
.persona-hint { font-size:20rpx; color:#b0b8c9; margin-left:auto; }


.feel-list { margin-top:10rpx; }
.quick-item.feel { background:#fff3ec; color:#a9643f; border:1rpx solid #f6dcc8; }
.quick-item.feel:nth-child(2) { background:#f3f2ff; color:#5a5aa8; border-color:#e2e0fb; }
.quick-item.feel:nth-child(3) { background:#eefaf2; color:#3f7a58; border-color:#d5eedd; }

/* 夜间柔和模式（22:00-6:00 自动）：降低亮度与对比，保护睡前眼睛 */
.chat-page.night { background: #1e2330; }
.chat-page.night .ai-msg { background: #2a3142; color: #d7dce8; }
.chat-page.night .user-msg { background: #3d5a99; }
.chat-page.night .input-bar { background: #262c3b; }
.chat-page.night .input { background: #1a1f2b; color: #d7dce8; }
.chat-page.night .ai-avatar { background: #2a3142; border-color: #39415a; }
.chat-page.night .chat-stats { color: #7c86a0; }
