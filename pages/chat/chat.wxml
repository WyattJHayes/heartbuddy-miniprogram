<view class="chat-page">
  <!-- 天气角（定位 → open-meteo；失败自动隐藏） -->
  <view class="weather-bar" wx:if="{{weatherText}}">
    <text class="w-ico">{{weatherIco}}</text>
    <text class="w-text">{{weatherText}}</text>
  </view>
  <!-- 今日心语：日轮换，点一下复制 -->
  <view class="quote-bar" wx:if="{{dailyQuote}}" bindtap="copyQuote" role="button" aria-label="复制今日心语">
    <text class="q-ico">💫</text>
    <text class="q-text">{{dailyQuote}}</text>
    <text class="q-copy">复制</text>
  </view>
  <!-- 消息区 -->
  <scroll-view scroll-y class="msg-scroll" scroll-with-animation aria-live="polite">
    <view class="msg-list">
      <block wx:for="{{messages}}" wx:key="index">
        <view class="row {{item.role === 'user' ? 'right' : 'left'}}">
          <view class="msg {{item.role === 'user' ? 'user-msg' : 'ai-msg'}}"
                bindlongpress="onMsgLongPress" data-index="{{index}}">{{item.content}}</view>
        </view>
      </block>

      <!-- AI 正在输入 -->
      <view class="row left" wx:if="{{typing}}">
        <view class="msg ai-msg">{{typedText}}<text class="cursor">▍</text></view>
      </view>
      <view id="aiEnd"></view>
      <view id="scrollAnchor"></view>
    </view>

    <!-- 快捷问题 -->
    <view class="quick" wx:if="{{messages.length <= 1 && !typing}}">
      <view class="quick-title">试试这样说 · Try saying</view>
      <view class="quick-list">
        <view class="quick-item" wx:for="{{quickReplies}}" wx:key="*this"
              data-text="{{item}}" bindtap="onQuick">{{item}}</view>
      </view>
      <view class="quick-list en-list">
        <view class="quick-item en" wx:for="{{quickEnglish}}" wx:key="*this"
              data-text="{{item}}" bindtap="onQuickEn">{{item}}</view>
      </view>
      <view class="quick-list emg-list">
        <view class="quick-item emg" wx:for="{{quickEmergency}}" wx:key="*this"
              data-text="{{item}}" bindtap="onQuickEn">🚨 {{item}}</view>
      </view>
      <view class="emg-hint">危急时刻不要独自面对 —— 我会立刻帮你连接心理热线与身边可信任的人。</view>
      <view class="bilingual-hint">中英文都行 —— 直接说「我很焦虑」，或 "I've been so anxious lately"，我都能接住 🌱</view>
    </view>
  </scroll-view>

  <!-- 输入栏 -->
  <view class="input-bar">
    <view class="mood-tags">
      <view class="tag {{moodTag==='开心'?'on':''}}" data-m="开心" bindtap="onMood">😊 开心</view>
      <view class="tag {{moodTag==='平静'?'on':''}}" data-m="平静" bindtap="onMood">😌 平静</view>
      <view class="tag {{moodTag==='焦虑'?'on':''}}" data-m="焦虑" bindtap="onMood">😰 焦虑</view>
      <view class="tag {{moodTag==='难过'?'on':''}}" data-m="难过" bindtap="onMood">😢 难过</view>
      <view class="tag {{moodTag==='孤独'?'on':''}}" data-m="孤独" bindtap="onMood">🌫 孤独</view>
      <view class="tag {{moodTag==='生气'?'on':''}}" data-m="生气" bindtap="onMood">😡 生气</view>
    </view>
    <view class="input-row">
      <view class="quick-toggle {{showQuick ? 'on' : ''}}" bindtap="toggleQuick">⚡快捷</view>
      <input
        class="input"
        placeholder="说点什么…"
        value="{{input}}"
        confirm-type="send"
        bindinput="onInput"
        bindconfirm="onSend"
      />
      <button class="send" bindtap="onSend" loading="{{loading}}">发送</button>
    </view>

    <!-- 快捷面板（随时可展开） -->
    <view class="quick-panel" wx:if="{{showQuick}}">
      <view class="quick-panel-title">试试这样说 · Try: "I've been feeling down…"</view>
      <view class="quick-panel-list">
        <view class="quick-panel-item" wx:for="{{quickReplies}}" wx:key="*this"
              data-text="{{item}}" bindtap="onQuick">{{item}}</view>
      </view>
      <view class="quick-panel-title en">EN 英语角 · one tap to send</view>
      <view class="quick-panel-list">
        <view class="quick-panel-item en" wx:for="{{quickEnglish}}" wx:key="*this"
              data-text="{{item}}" bindtap="onQuickEn">{{item}}</view>
      </view>
      <view class="quick-panel-title emg">🚨 紧急时刻 · English urgent needs</view>
      <view class="quick-panel-list">
        <view class="quick-panel-item emg" wx:for="{{quickEmergency}}" wx:key="*this"
              data-text="{{item}}" bindtap="onQuickEn">{{item}}</view>
      </view>
    </view>
  </view>
</view>
<!-- 新手引导（仅第一次，hb_onboard_v1） -->
<view class="onboard" wx:if="{{onboarding}}">
  <view class="onboard-card" role="dialog" aria-label="新手引导">
    <block wx:if="{{onboardingStep === 0}}">
      <view class="ob-emoji">💬</view>
      <view class="ob-title">在这里，随时聊聊</view>
      <view class="ob-desc">底部输入框直接打字：说「我很焦虑」「今天有点难过」，我都会认真听。</view>
    </block>
    <block wx:elif="{{onboardingStep === 1}}">
      <view class="ob-emoji">📊</view>
      <view class="ob-title">你的心情会被好好保存</view>
      <view class="ob-desc">每次记录都会变成情绪曲线、每周小结，还可以生成分享卡片，见证你的变化。</view>
    </block>
    <block wx:else>
      <view class="ob-emoji">🛟</view>
      <view class="ob-title">永远有退路</view>
      <view class="ob-desc">特别难过时，点「紧急求助」—— 有心理热线和身边可信任的人等着你。</view>
    </block>
    <view class="ob-dots">
      <view class="ob-dot {{onboardingStep === index ? 'on' : ''}}" wx:for="{{3}}" wx:key="index"></view>
    </view>
    <view class="ob-actions">
      <button class="ob-skip" bindtap="onBoardSkip">跳过</button>
      <button class="ob-next" bindtap="onBoardNext">{{onboardingStep >= 2 ? '开始使用' : '下一步'}}</button>
    </view>
  </view>
</view>
