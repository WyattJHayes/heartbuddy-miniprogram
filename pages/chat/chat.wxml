<view class="chat-page">
  <!-- 连续低落情绪关怀条：最近 2 天连续偏低时出现，非打扰、当天一次 -->
  <view class="low-care" wx:if="{{lowCare}}" role="note" aria-label="连续低落情绪关怀">
    <view class="lc-body">
      <view class="lc-text">{{lowCareText}}</view>
      <view class="lc-actions">
        <view class="lc-say" bindtap="writeToSelf" role="button" aria-label="写一句给此刻的自己">写一句给此刻的自己 ✍️</view>
        <view class="lc-later" bindtap="closeLowCare" role="button" aria-label="今天先不提醒">今天先不提醒</view>
      </view>
    </view>
    <view class="lc-close" bindtap="closeLowCare" role="button" aria-label="关闭关怀提醒">✕</view>
  </view>
  <!-- 天气角（定位 → open-meteo；失败自动隐藏） -->
  <view class="weather-bar" wx:if="{{weatherText}}">
    <text class="w-ico">{{weatherIco}}</text>
    <text class="w-text">{{weatherText}}</text>
  </view>
  <!-- 今日心语：日轮换，点一下复制 -->
  <view class="quote-bar" wx:if="{{dailyQuote}}" bindtap="copyQuote" role="button" aria-label="复制今日心语">
    <text class="q-ico">💫</text>
    <text class="q-text">{{dailyQuote}}</text>
    <text class="q-copy">复制</text>
  </view>
  <!-- 今日陪伴徽章：今天第几次来找我 -->
  <view class="today-n" wx:if="{{todayN > 0}}" role="note" aria-label="今天已倾诉次数">
    ☁️ 今天第 {{todayN}} 次来找我，谢谢你愿意和我说话
  </view>
  <!-- 深夜工具箱（22:00–5:00）：失眠/烦躁时的三个小出口 -->
  <view class="night-bar" wx:if="{{nightShow}}">
    <text class="night-title">🌙 这么晚还醒着？给你几个出口</text>
    <view class="night-chips">
      <view class="night-chip" bindtap="nightBreathe" role="button" aria-label="试试深呼吸">3 分钟呼吸</view>
      <view class="night-chip hot" bindtap="nightFirstAid" role="button" aria-label="情绪很急时做5分钟急救">🔥 5 分钟急救</view>
      <view class="night-chip" bindtap="nightToSelf" role="button" aria-label="写给自己一句话">写给自己一句</view>
      <view class="night-chip" bindtap="nightWrite" role="button" aria-label="写下烦心事">写下烦心事</view>
      <view class="night-chip" bindtap="nightLater" role="button" aria-label="把烦恼留给明天">把烦恼留给明天</view>
    </view>
  </view>
  <!-- 消息区 -->
  <scroll-view scroll-y class="msg-scroll" scroll-with-animation aria-live="polite">
    <view class="msg-list">
      <block wx:for="{{messages}}" wx:key="index">
        <view class="row {{item.role === 'user' ? 'right' : 'left'}}">
          <view class="ai-avatar" wx:if="{{item.role === 'ai'}}" aria-hidden="true">{{aiFace || '🌱'}}</view>
          <view class="msg {{item.role === 'user' ? 'user-msg' : 'ai-msg'}}"
                bindlongpress="onMsgLongPress" data-index="{{index}}">{{item.content}}</view>
        </view>
      </block>

      <!-- AI 正在输入 -->
      <view class="row left" wx:if="{{typing}}">
        <view class="ai-avatar" aria-hidden="true">{{aiFace || '🌱'}}</view>
        <view class="msg ai-msg">{{typedText}}<text class="cursor">▍</text></view>
      </view>
      <view id="aiEnd"></view>
      <view id="scrollAnchor"></view>
    </view>

    <!-- 快捷问题 -->
    <view class="quick" wx:if="{{messages.length <= 1 && !typing}}">
      <view class="quick-title">试试这样说 · Try saying</view>
      <view class="quick-list">
        <view class="quick-item" wx:for="{{quickReplies}}" wx:key="*this"
              data-text="{{item}}" bindtap="onQuick">{{item}}</view>
      </view>
      <view class="quick-list en-list">
        <view class="quick-item en" wx:for="{{quickEnglish}}" wx:key="*this"
              data-text="{{item}}" bindtap="onQuickEn">{{item}}</view>
      </view>
      <view class="quick-list emg-list">
        <view class="quick-item emg" wx:for="{{quickEmergency}}" wx:key="*this"
              data-text="{{item}}" bindtap="onQuickEn">🚨 {{item}}</view>
      </view>
      <view class="emg-hint">危急时刻不要独自面对 —— 我会立刻帮你连接心理热线与身边可信任的人。</view>
      <view class="bilingual-hint">中英文都行 —— 直接说「我很焦虑」，或 "I've been so anxious lately"，我都能接住 🌱</view>
    </view>
  </scroll-view>

  <!-- 倾诉后小结算：AI 回复打完后的一次性感受标签条 -->
  <view class="feeling-bar" wx:if="{{showFeeling}}" aria-label="倾诉后此刻感受">
    <view class="feeling-head">这轮说完，现在感觉更像…？<view class="feeling-close" bindtap="closeFeeling" role="button" aria-label="关闭">✕</view></view>
    <view class="feeling-tags">
      <view class="tag feeling-tag" wx:for="{{feelingTags}}" wx:key="*this" data-m="{{item}}" bindtap="onFeelingTap">{{item}}</view>
    </view>
  </view>

  <!-- 输入栏 -->
  <view class="input-bar">
    <view class="mood-tags">
      <view class="tag {{moodTag==='开心'?'on':''}}" data-m="开心" bindtap="onMood">😊 开心</view>
      <view class="tag {{moodTag==='平静'?'on':''}}" data-m="平静" bindtap="onMood">😌 平静</view>
      <view class="tag {{moodTag==='焦虑'?'on':''}}" data-m="焦虑" bindtap="onMood">😰 焦虑</view>
      <view class="tag {{moodTag==='难过'?'on':''}}" data-m="难过" bindtap="onMood">😢 难过</view>
      <view class="tag {{moodTag==='孤独'?'on':''}}" data-m="孤独" bindtap="onMood">🌫 孤独</view>
      <view class="tag {{moodTag==='生气'?'on':''}}" data-m="生气" bindtap="onMood">😡 生气</view>
    </view>
    <!-- 此刻强度滑条：1–5，随情绪标签落库，月度小结会算平均值 -->
    <view class="intensity-row">
      <text class="intensity-label">此刻强度</text>
      <slider class="intensity-slider" min="1" max="5" step="1" value="{{intensity}}"
              activeColor="#5b8def" backgroundColor="#e3e9f4" block-size="20" block-color="#5b8def"
              bindchanging="onIntensity" bindchange="onIntensity"
              aria-label="此刻情绪强度，1 到 5" />
      <text class="intensity-num {{intensity >= 4 ? 'high' : ''}}">{{intensity}}</text>
    </view>
    <!-- 引用条：长按「引用这条」后，把原句带进输入框（可修改后发送） -->
    <view class="reply-bar" wx:if="{{replyToMsg}}" role="note" aria-label="正在引用消息">
      <view class="reply-tag">{{replyToMsg.role === 'user' ? '引用 · 我说' : '引用 · 心语说'}}</view>
      <view class="reply-text">{{replyToMsg.text}}</view>
      <view class="reply-close" bindtap="clearReply" role="button" aria-label="取消引用">✕</view>
    </view>
    <view class="chat-stats" wx:if="{{chatStat}}" role="note" aria-label="本轮聊天计数">{{chatStat}} · 谢谢你信任我</view>
    <view class="input-row">
      <view class="quick-toggle {{showQuick ? 'on' : ''}}" bindtap="toggleQuick">⚡快捷</view>
      <view class="reset-chat" bindtap="summarize" role="button" aria-label="总结这轮对话">✨</view>
      <view class="reset-chat" bindtap="resetChat" role="button" aria-label="重新开始这轮对话">↻</view>
      <input
        class="input"
        placeholder="{{inputPh || '说点什么…'}}"
        value="{{input}}"
        confirm-type="send"
        bindinput="onInput"
        bindconfirm="onSend"
      />
      <button class="send" bindtap="onSend" loading="{{loading}}">发送</button>
    </view>

    <!-- 快捷面板（随时可展开） -->
    <view class="quick-panel" wx:if="{{showQuick}}">
      <view class="quick-panel-title">试试这样说 · Try: "I've been feeling down…"</view>
      <view class="quick-panel-list">
        <view class="quick-panel-item" wx:for="{{quickReplies}}" wx:key="*this"
              data-text="{{item}}" bindtap="onQuick">{{item}}</view>
      </view>
      <view class="quick-panel-title sooth">💙 自我安抚 · 情绪上来先说一句</view>
      <view class="quick-panel-list">
        <view class="quick-panel-item sooth" wx:for="{{quickSoothe}}" wx:key="*this"
              data-text="{{item}}" bindtap="onQuick">{{item}}</view>
      </view>
      <view class="quick-panel-title calm">🌬 先落地 · 跟我做 3 次深呼吸</view>
      <view class="quick-panel-list">
        <view class="quick-panel-item calm" bindtap="breatheNow">吸气 4 秒 → 呼气 6 秒，我们做 3 轮</view>
      </view>
      <view class="quick-panel-title warm">🌼 夸夸我 · 给自己一句温柔</view>
      <view class="quick-panel-list">
        <view class="quick-panel-item warm" bindtap="onPraise">今天辛苦了，夸夸我</view>
      </view>
      <view class="quick-panel-title en">EN 英语角 · one tap to send</view>
      <view class="quick-panel-list">
        <view class="quick-panel-item en" wx:for="{{quickEnglish}}" wx:key="*this"
              data-text="{{item}}" bindtap="onQuickEn">{{item}}</view>
      </view>
      <view class="quick-panel-title emg">🚨 紧急时刻 · English urgent needs</view>
      <view class="quick-panel-list">
        <view class="quick-panel-item emg" wx:for="{{quickEmergency}}" wx:key="*this"
              data-text="{{item}}" bindtap="onQuickEn">{{item}}</view>
      </view>
    </view>
  </view>
</view>
<!-- 新手引导（仅第一次，hb_onboard_v1） -->
<view class="onboard" wx:if="{{onboarding}}">
  <view class="onboard-card" role="dialog" aria-label="新手引导">
    <block wx:if="{{onboardingStep === 0}}">
      <view class="ob-emoji">💬</view>
      <view class="ob-title">在这里，随时聊聊</view>
      <view class="ob-desc">底部输入框直接打字：说「我很焦虑」「今天有点难过」，我都会认真听。</view>
    </block>
    <block wx:elif="{{onboardingStep === 1}}">
      <view class="ob-emoji">📊</view>
      <view class="ob-title">你的心情会被好好保存</view>
      <view class="ob-desc">每次记录都会变成情绪曲线、每周小结，还可以生成分享卡片，见证你的变化。</view>
    </block>
    <block wx:else>
      <view class="ob-emoji">🛟</view>
      <view class="ob-title">永远有退路</view>
      <view class="ob-desc">特别难过时，点「紧急求助」—— 有心理热线和身边可信任的人等着你。</view>
    </block>
    <view class="ob-dots">
      <view class="ob-dot {{onboardingStep === index ? 'on' : ''}}" wx:for="{{3}}" wx:key="index"></view>
    </view>
    <view class="ob-actions">
      <button class="ob-skip" bindtap="onBoardSkip">跳过</button>
      <button class="ob-next" bindtap="onBoardNext">{{onboardingStep >= 2 ? '开始使用' : '下一步'}}</button>
    </view>
  </view>
</view>
