<view class="container">
  <view class="edu-head" role="note" aria-label="心理小课说明">
    <text class="eh-title">📚 心理小课</text>
    <text class="eh-sub">几分钟就能读完，随手学一点照顾自己的办法</text>
  </view>

  <!-- 今日轻学目标：没学给 5 分钟小目标，学过给温柔回执（当天有效） -->
  <view class="today-goal" wx:if="{{todayGoal}}" role="note" aria-label="今日轻学目标">
    <text class="tg-emoji">{{todayDone ? '🌿' : '🌱'}}</text>
    <text class="tg-text">{{todayGoal}}</text>
  </view>

  <!-- 考前 N 天：联动「我的」考试日，考前给心稳稳的提示 -->
  <view class="exam-tick" wx:if="{{examTick}}" role="note" aria-label="考前倒数提示">
    <text class="et-emoji">📅</text>
    <text class="et-text">{{examTick.text}}</text>
  </view>

  <!-- 完成度进度条 -->
  <view class="edu-progress" role="progressbar" aria-label="课程完成度 {{doneCount}}/{{total}}">
    <view class="ep-num">已学完 {{doneCount}} / {{total}} 节<text wx:if="{{streak >= 2}}" class="ep-streak">🔥 连续学习 {{streak}} 天</text></view>
    <view class="study-cal" wx:if="{{studyCal.length}}" role="img" aria-label="近14天学习日历">
      <view class="sc-cell {{item.on ? 'on' : ''}} {{item.today ? 'today' : ''}}" wx:for="{{studyCal}}" wx:key="index"></view>
    </view>
    <view class="sc-sub">近 14 天学习日历 · 点亮的是学过的天</view>
    <view class="ep-bar"><view class="ep-fill" style="width: {{doneCount / total * 100}}%"></view></view>
  </view>

  <!-- 搜索：想找的内容一句话就能定位 -->
  <view class="edu-search">
    <input class="es-input" value="{{kw}}" bindinput="onSearch" placeholder="🔍 搜课程内容，如：睡不着、朋友、求助"
           confirm-type="search" aria-label="搜索课程内容" />
    <text class="es-clear" wx:if="{{kw}}" bindtap="clearSearch" role="button" aria-label="清空搜索">✕</text>
  </view>
  <view class="es-count" wx:if="{{kw}}">找到 {{lessons.length}} 节相关课程</view>
  <view class="es-none" wx:if="{{kw && !lessons.length}}" role="note" aria-label="没有找到相关课程">
    没有找到「{{kw}}」相关的课 —— 试试换个词，比如：睡不着、朋友、考试、求助。
  </view>

  <!-- 课程列表 -->
  <view class="lesson" wx:for="{{lessons}}" wx:key="key" role="button" aria-label="展开{{item.title}}">
    <view class="ls-head" bindtap="toggle" data-i="{{index}}">
      <text class="ls-icon">{{item.icon}}</text>
      <view class="ls-main">
        <view class="ls-title"><text class="ls-idx">第 {{index + 1}} 节</text>{{item.title}}<text class="ls-cnt" wx:if="{{lessonCounts[item.key] > 1}}">·学 {{lessonCounts[item.key]}} 遍</text></view>
        <view class="ls-meta">{{item.mins}} · {{item.intro}}</view>
      </view>
      <text class="ls-flag {{doneMap[item.key] ? 'on' : ''}}">{{doneMap[item.key] ? '已学完' : '▸'}}</text>
    </view>
    <view class="ls-body" wx:if="{{openIdx === index}}">
      <view class="ls-point" wx:for="{{item.points}}" wx:for-item="pt" wx:key="*this">
        <text class="lp-dot">·</text><text class="lp-text">{{pt}}</text>
      </view>
      <view class="ls-do">💚 今天可以这样做：{{item.do}}</view>
      <!-- 随堂小测：答对才能点亮「学完」 -->
      <view class="ls-quiz" wx:if="{{item.quiz}}">
        <view class="lq-q">📌 随堂一问：{{item.quiz.q}}</view>
        <view class="lq-opt {{answered[item.key] === oidx ? (oidx === item.quiz.ans ? 'right' : 'wrong') : ''}}"
              wx:for="{{item.quiz.opts}}" wx:for-item="opt" wx:for-index="oidx" wx:key="*this"
              bindtap="answerQuiz" data-i="{{index}}" data-o="{{oidx}}" role="button" aria-label="{{opt}}">{{opt}}</view>
        <view class="lq-why" wx:if="{{quizOk[item.key]}}">💡 {{item.quiz.why}}</view>
      </view>
      <view class="ls-btn-row">
        <view class="ls-copy" bindtap="copyLesson" data-i="{{index}}" role="button" aria-label="复制这一课分享给朋友">📄 复制分享</view>
      </view>
      <view class="ls-done-btn" bindtap="markDone" data-i="{{index}}" role="button" aria-label="标记学完这一节">
        {{doneMap[item.key] ? '✓ 已学完（再点保留）' : '我学完啦 ✓'}}
      </view>
    </view>
  </view>

  <!-- 温故一题：全部学完后每天一道复习题 -->
  <view class="review-card" wx:if="{{review}}" role="group" aria-label="温故一题">
    <view class="rv-title">{{review.icon}} 温故一问 · 来自「{{review.title}}」</view>
    <view class="rv-q">{{review.quiz.q}}</view>
    <view class="rv-opt {{review.picked === ri ? (ri === review.quiz.ans ? 'right' : 'wrong') : ''}}"
          wx:for="{{review.quiz.opts}}" wx:for-item="opt" wx:for-index="ri" wx:key="*this"
          bindtap="answerReview" data-o="{{ri}}" role="button" aria-label="{{opt}}">{{opt}}</view>
    <view class="rv-why" wx:if="{{review.picked >= 0}}">{{review.ok ? '✅ ' : '💡 '}}{{review.quiz.why}}</view>
    <view class="rv-again" bindtap="rollReview" role="button" aria-label="再来一道">再来一道</view>
  </view>

  <!-- 学习心得：一句话写给自己（本地保存） -->
  <view class="note-card" wx:if="{{doneCount >= 1}}">
    <view class="nt-title">✏️ 学到这里，写一句给自己的话</view>
    <textarea class="nt-input" value="{{myNote}}" bindinput="onNoteInput" maxlength="60"
              placeholder="例如：原来我不是矫情，只是太累了……" auto-height />
    <view class="nt-ops">
      <view class="nt-save" bindtap="saveNote" role="button" aria-label="保存学习心得">保存</view>
      <view class="nt-copy" bindtap="copyMyNote" role="button" aria-label="复制学习心得">复制</view>
    </view>
  </view>

  <!-- 结业卡：全部学完显示（本地留念） -->
  <view class="grad-card" wx:if="{{doneCount >= total}}" role="note" aria-label="心理小课结业卡">
    <view class="gc-emoji">🎓</view>
    <view class="gc-title">全部学完，结业啦！</view>
    <view class="gc-text">这 7 节课不会让情绪永远不来，但会让它来的时候，你知道该怎么办。</view>
    <view class="gc-review" wx:if="{{reviewOk}}">🔁 课后温故累计答对 {{reviewOk}}/{{reviewAll}} 题（{{reviewAll ? Math.round(reviewOk / reviewAll * 100) : 0}}%）<text wx:if="{{reviewStreak >= 2}}"> · 连续 {{reviewStreak}} 天 🔥</text></view>
    <view class="gc-date" wx:if="{{gradDate}}">结业于 {{gradDate}}<text wx:if="{{gradSpan}}"> · 一共学了 {{gradSpan}} 天</text></view>
    <view class="gc-days" wx:if="{{studyDays}}">👣 学习足迹：{{studyDays}} 个学习日</view>
    <view class="gc-btn" bindtap="copyGradText" role="button" aria-label="复制结业词留念">复制我的结业词</view>
  </view>

  <view class="edu-foot" role="note" aria-label="免责说明">
    课程来自公开的心理健康科普，不替代专业诊断。如果情绪长时间很重，
    <text class="ef-link" role="button" aria-label="拨打心理援助热线" bindtap="callHotline">可拨打 12356 心理援助热线</text>
    或告诉信任的成年人。
  </view>

  <view class="edu-reset" bindtap="resetAll" role="button" aria-label="清空课程进度重学">
    重新学一遍（清空进度）
  </view>
</view>