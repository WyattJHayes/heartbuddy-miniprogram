.container { padding: 32rpx; }
.scan-card { background: #fff; border-radius: 20rpx; padding: 40rpx 32rpx; margin-top: 40rpx; }
.scan-hero { font-size: 110rpx; text-align: center; margin-bottom: 20rpx; }
.scan-title { font-size: 40rpx; font-weight: 800; text-align: center; color: #2a3b55; }
.scan-sub { font-size: 26rpx; color: #5a6b85; text-align: center; margin-top: 12rpx; line-height: 1.7; }
.scan-card .scan-tips { margin: 28rpx 0; font-size: 25rpx; color: #7a8698; line-height: 1.9; }
.scan-last { text-align: center; font-size: 23rpx; color: #9aa5b8; margin-top: 20rpx; }
.scan-progress { height: 12rpx; background: #edf1f7; border-radius: 999rpx; overflow: hidden; }
.scan-progress-fill { height: 100%; background: linear-gradient(90deg, #a3c0f7, #5b8def); border-radius: 999rpx; transition: width .9s linear; }
.scan-step { text-align: center; font-size: 24rpx; color: #9aa5b8; margin-top: 30rpx; }
.scan-part { text-align: center; font-size: 46rpx; font-weight: 800; color: #2a3b55; margin-top: 14rpx; }
.scan-desc { text-align: center; font-size: 28rpx; color: #4a5b76; line-height: 1.8; margin: 26rpx 40rpx; }
.scan-countdown { text-align: center; font-size: 90rpx; font-weight: 300; color: #5b8def; margin: 10rpx 0 30rpx; line-height: 1; }
.mood-tips { margin: 24rpx 0; }.scan-tips { margin: 24rpx 0; font-size: 25rpx; color: #7a8698; line-height: 1.9; }
.scan-tip { margin-top: 6rpx; }

.scan-stats { display: inline-flex; align-items: center; gap: 10rpx; padding: 10rpx 20rpx;
  background: #f0f1fa; border-radius: 999rpx; margin-bottom: 14rpx; }
.ss-dot { font-size: 26rpx; }
.ss-text { font-size: 24rpx; color: #4a5a8a; }

.calm-pick { margin-top: 10rpx; }
.cp-label { font-size: 22rpx; color: #8a8f9a; margin-bottom: 8rpx; line-height: 1.5; }
.cp-row { display: flex; gap: 12rpx; }
.cp-chip { flex: 1; text-align: center; padding: 10rpx 0; border-radius: 999rpx;
  background: #eef1f6; color: #6b7280; font-size: 24rpx; }
.cp-chip.on { background: #4c7a52; color: #fff; }

.scan-open { margin-top: 14rpx; font-size: 26rpx; color:#7a8fa0; font-style: italic; }

.feel-pick { margin: 20rpx 0 6rpx; background: #f6f9fd; border-radius: 14rpx; padding: 16rpx 18rpx; }
.fp-label { font-size: 24rpx; color: #5b6b8c; }
.fp-row { display: flex; flex-wrap: wrap; margin-top: 14rpx; }
.fp-chip { font-size: 24rpx; color: #4a6ab0; background: #fff; border: 1rpx solid #d8e4f8; border-radius: 999rpx; padding: 10rpx 24rpx; margin: 0 12rpx 12rpx 0; }
.fp-chip.on { background: #5b8def; color: #fff; border-color: #5b8def; }
.fp-log { margin-top: 6rpx; font-size: 22rpx; color: #9aa3b8; }
.fp-log-t { margin-right: 8rpx; }
.fp-log-i { margin-right: 14rpx; }

.scan-time-tip { margin: 14rpx auto 0; max-width: 600rpx; font-size: 23rpx; color: #6b7690; background: #f3f6fd; border-radius: 12rpx; padding: 12rpx 18rpx; }

.scan-next { margin: 16rpx auto 0; max-width: 600rpx; font-size: 23rpx; color: #4e7a58; background: #f6fbf6; border: 1rpx solid #d9ecd9; border-radius: 12rpx; padding: 12rpx 18rpx; text-align: center; }

.fp-top { margin-top: 10rpx; font-size: 22rpx; color: #3f7a52; background: #f2f9f4; border-radius: 8rpx; padding: 8rpx 14rpx; }

.fp-slot { margin-top: 8rpx; font-size: 22rpx; color: #5b6b8c; }

/* 双模式选择：5 分钟全身 / 3 分钟快扫 */
.scan-mode-pick { display: flex; gap: 14rpx; margin-top: 18rpx; }
.sm-item { flex: 1; border: 2rpx solid #dfe6f2; border-radius: 14rpx; padding: 14rpx 12rpx;
  background: #fff; text-align: center; }
.sm-item.on { border-color: #5b8def; background: #f0f5ff; }
.sm-t { display: block; font-size: 25rpx; color: #33415c; font-weight: 600; }
.sm-d { display: block; margin-top: 4rpx; font-size: 21rpx; color: #9aa3b8; }

/* 完成回响 */
.scan-echo { margin-top: 18rpx; background: #f7fbff; border: 1rpx solid #dbe9fb; border-radius: 16rpx; padding: 18rpx 20rpx 14rpx; }
.scan-echo-body { display: flex; gap: 12rpx; align-items: flex-start; }
.scan-echo-e { font-size: 34rpx; }
.scan-echo-t { flex: 1; font-size: 25rpx; color: #3f6498; line-height: 1.7; }
.scan-echo-copy { margin-top: 10rpx; text-align: right; font-size: 22rpx; color: #5b8def; }

/* 先选部位 */
.scan-spot { margin-top: 16rpx; }
.ss-label { font-size: 24rpx; color: #8a93a8; margin-bottom: 10rpx; }
.ss-row { display: flex; flex-wrap: wrap; gap: 12rpx; }
.ss-chip { padding: 10rpx 22rpx; border-radius: 28rpx; background: #eef3f8; color: #6b7a8e; font-size: 24rpx; }
.ss-chip:active { transform: scale(0.96); }
.ss-note { margin-top: 8rpx; font-size: 22rpx; color: #b0b8c8; }

.scan-bm { margin-top: 14rpx; text-align: center; }
.bm-tip { display: block; font-size: 22rpx; color: #8a93a8; margin-bottom: 10rpx; }
.bm-actions { display: flex; gap: 12rpx; justify-content: center; }
.bm-chip { padding: 10rpx 24rpx; border-radius: 26rpx; background: #eef3f8; color: #6b7a8e; font-size: 24rpx; }
.bm-chip.primary { background: #e3eeff; color: #3f6aa8; }
.btn-ghost.sm { width: auto; padding: 8rpx 20rpx; font-size: 24rpx; margin: 14rpx auto 6rpx; }

/* 今天身体最需要什么 */
.need-pick { margin-top: 16rpx; }
.np-label { font-size: 24rpx; color: #8a93a8; margin-bottom: 10rpx; }
.np-row { display: flex; flex-wrap: wrap; gap: 12rpx; }
.np-chip { padding: 10rpx 22rpx; border-radius: 28rpx; background: #eef3f8; color: #6b7a8e; font-size: 24rpx; }
.np-chip.on { background: #e3f6e3; color: #3f7a4f; }
.np-picked { margin-top: 10rpx; font-size: 23rpx; color: #5f8a6a; }

.week7 { display: flex; align-items: center; gap: 10rpx; margin-top: 14rpx; justify-content: center; }
.w7-label { font-size: 22rpx; color: #9aa8bd; }
.w7-cell { display: flex; flex-direction: column; align-items: center; gap: 2rpx; padding: 6rpx 8rpx; border-radius: 10rpx; background: #f4f7fb; }
.w7-cell.on { background: #e3f6e3; }
.w7-cell.today { outline: 1rpx solid #b7cfb7; }
.w7-w { font-size: 19rpx; color: #9aa8bd; }
.w7-dot { font-size: 20rpx; color: #b8c4d6; }
.w7-cell.on .w7-dot { color: #4f9a5f; }
