<view class="scan-page">
  <!-- 累计完成次数（本地计数，与呼吸页一致） -->
  <view class="scan-stats" wx:if="{{scanCount > 0}}" role="note" aria-label="身体扫描累计统计">
    <text class="ss-dot">🌌</text>
    <text class="ss-text">已累计完成 {{scanCount}} 次身体扫描</text>
  </view>
  <!-- 准备态 -->
  <view class="scan-card" wx:if="{{phase === 'ready'}}">
    <view class="scan-hero">🧘</view>
    <view class="scan-title">{{mode === 'quick' ? '3 分钟午间快扫' : '5 分钟身体扫描'}}</view>
    <view class="scan-sub">{{mode === 'quick' ? '只有 3 分钟，也能把注意力从「最忙的脑子」挪回身体。课间、午休、排队的时候都来得及。' : '跟着引导，把注意力从「最忙的脑子」慢慢挪回身体。不需要技巧，只需要你陪着身体待一会儿。'}}</view>
  <view class="scan-time-tip" wx:if="{{timeTip}}" role="note" aria-label="此刻扫描建议">{{timeTip}}</view>
    <view class="scan-open" wx:if="{{opening}}">{{opening}}</view>
    <view class="scan-mode-pick" role="group" aria-label="选择扫描时长">
      <view class="sm-item {{mode === 'full' ? 'on' : ''}}" data-m="full" bindtap="pickMode" role="button" aria-label="5 分钟全身扫描">
        <text class="sm-t">5 分钟全身扫描</text>
        <text class="sm-d">睡前/完整放松适用</text>
      </view>
      <view class="sm-item {{mode === 'quick' ? 'on' : ''}}" data-m="quick" bindtap="pickMode" role="button" aria-label="3 分钟午间快扫">
        <text class="sm-t">3 分钟午间快扫</text>
        <text class="sm-d">课间/午休随时来一组</text>
      </view>
    </view>
    <view class="scan-tips">
      <view class="scan-tip">· 跟着节奏往下走，走神了也没关系</view>
      <view class="scan-tip">· 全程约 {{mode === 'quick' ? '3' : '5'}} 分钟，随时可以结束</view>
      <view class="scan-tip">· 完成后会自动记一条「平静」心情</view>
    </view>
    <button class="btn-primary full" bindtap="begin">开始{{mode === 'quick' ? '快扫' : '扫描'}}</button>
    <view class="scan-last" wx:if="{{lastDone}}">{{lastDone}}</view>
    <view class="scan-next" role="button" bindtap="goBreathe" aria-label="再去呼吸页做一轮">🌿 还想再放松？接着做一轮呼吸 →</view>
    <button class="btn-ghost full mt" bindtap="exit">返回</button>
  </view>

  <!-- 进行态 -->
  <view class="scan-card run" wx:elif="{{phase === 'run'}}">
    <view class="scan-prog">
      <view class="scan-prog-fill" style="width:{{pct}}%"></view>
    </view>
    <view class="scan-step">{{idx + 1}} / {{modeTotal}}</view>
    <view class="scan-part">{{stages[idx].t}}</view>
    <view class="scan-desc">{{stages[idx].d}}</view>
    <view class="scan-countdown">{{left}}</view>
    <button class="btn-ghost full" bindtap="exit">提前结束</button>
  </view>

  <!-- 完成态 -->
  <view class="scan-card" wx:else>
    <view class="scan-hero">🌿</view>
    <view class="scan-title">这次{{mode === 'quick' ? '快扫' : '扫描'}}，你做到了<text wx:if="{{doneN}}"> · 累计第 {{doneN}} 次</text></view>
    <view class="scan-sub">{{mode === 'quick' ? '3 分钟也够身体缓一缓——课间里给自己留的这口气，很值得。' : '给自己一点安静，本身就是一种照顾。'}}</view>
    <view class="scan-last" wx:if="{{lastDone}}">{{lastDone}}</view>
    <!-- 完成时告知：已自动记一笔「平静」，可选此刻程度（1-5） -->
    <view class="calm-pick" role="note" aria-label="此刻的平静程度">
      <view class="cp-label">刚才的扫描已自动记成「平静」，此刻有多平静？</view>
      <view class="cp-row">
        <view class="cp-chip {{calmInt === item ? 'on' : ''}}" wx:for="{{[1,2,3,4,5]}}" wx:key="*this"
              data-v="{{item}}" bindtap="setCalmInt" role="button" aria-label="程度 {{item}}">{{item}}</view>
      </view>
    </view>
    <!-- 身体感受一词：扫完给身体一个描述（本地留档，可回看） -->
    <view class="feel-pick" role="group" aria-label="选择身体感受">
      <view class="fp-label">现在身体是什么感觉？挑一个词</view>
      <view class="fp-row">
        <view class="fp-chip {{feelPicked === item ? 'on' : ''}}" wx:for="{{['松了','暖了','还有点紧','没什么感觉','困了','轻了','稳了','累了']}}" wx:key="*this"
              data-w="{{item}}" bindtap="pickFeel" role="button" aria-label="{{item}}">{{item}}</view>
      </view>
      <view class="fp-top" wx:if="{{feelTop}}" role="note" aria-label="身体感受最常反馈">🫧 {{feelTop}}</view>
      <view class="fp-slot" wx:if="{{avgSlot}}" role="note" aria-label="最常完成时段">🕰 {{avgSlot}}</view>
      <view class="fp-log" wx:if="{{feelLog.length}}" role="note" aria-label="最近几次身体感受">
        <text class="fp-log-t">最近几次：</text>
        <text class="fp-log-i" wx:for="{{feelLog}}" wx:key="t">{{item.w}}</text>
      </view>
    </view>
    <button class="btn-primary full" bindtap="again">再来一次</button>
    <view class="scan-next" role="button" bindtap="goBreathe" aria-label="再去呼吸页做一轮">🌿 还想再放松？接着做一轮呼吸 →</view>
    <button class="btn-ghost full mt" bindtap="exit">返回</button>
  </view>
</view>