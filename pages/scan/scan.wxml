<view class="scan-page">
  <!-- 累计完成次数（本地计数，与呼吸页一致） -->
  <view class="scan-stats" wx:if="{{scanCount > 0}}" role="note" aria-label="身体扫描累计统计">
    <text class="ss-dot">🌌</text>
    <text class="ss-text">已累计完成 {{scanCount}} 次身体扫描<text wx:if="{{scanToday}}"> · 今天 {{scanToday}} 次</text><text wx:if="{{scanWeek}}"> · 本周 {{scanWeek}} 次</text><text wx:if="{{scanStreak >= 2}}"> · 连续 {{scanStreak}} 天 🔄</text></text>
  </view>
  <!-- 准备态 -->
  <view class="scan-card" wx:if="{{phase === 'ready'}}">
    <view class="scan-hero">🧘</view>
    <view class="scan-title">{{mode === 'micro' ? '1 分钟微扫' : (mode === 'quick' ? '3 分钟午间快扫' : '5 分钟身体扫描')}}</view>
    <view class="scan-sub">{{mode === 'micro' ? '只要 60 秒：等车、排队、课间，让身体先回个神，不占时间。' : (mode === 'quick' ? '只有 3 分钟，也能把注意力从「最忙的脑子」挪回身体。课间、午休、排队的时候都来得及。' : '跟着引导，把注意力从「最忙的脑子」慢慢挪回身体。不需要技巧，只需要你陪着身体待一会儿。')}}</view>
  <view class="scan-time-tip" wx:if="{{timeTip}}" role="note" aria-label="此刻扫描建议">{{timeTip}}</view>
    <view class="scan-open" wx:if="{{opening}}">{{opening}}</view>
    <view class="scan-mode-pick" role="group" aria-label="选择扫描时长">
      <view class="sm-item {{mode === 'full' ? 'on' : ''}}" data-m="full" bindtap="pickMode" role="button" aria-label="5 分钟全身扫描">
        <text class="sm-t">5 分钟全身扫描</text>
        <text class="sm-d">睡前/完整放松适用</text>
      </view>
      <view class="sm-item {{mode === 'quick' ? 'on' : ''}}" data-m="quick" bindtap="pickMode" role="button" aria-label="3 分钟午间快扫">
        <text class="sm-t">3 分钟午间快扫</text>
        <text class="sm-d">课间/午休随时来一组</text>
      </view>
      <view class="sm-item {{mode === 'micro' ? 'on' : ''}}" data-m="micro" bindtap="pickMode" role="button" aria-label="1 分钟微扫">
        <text class="sm-t">1 分钟微扫</text>
        <text class="sm-d">等车/排队也能扫</text>
      </view>
    </view>
    <view class="scan-tips">
      <view class="scan-tip">· 跟着节奏往下走，走神了也没关系</view>
      <view class="scan-tip">· 全程约 {{mode === 'micro' ? '1' : (mode === 'quick' ? '3' : '5')}} 分钟，随时可以结束</view>
      <view class="scan-tip">· 完成后会自动记一条「平静」心情</view>
    </view>
    <view class="scan-spot" wx:if="{{mode === 'full'}}" role="group" aria-label="从想先照顾的部位开始">
      <view class="ss-label">想先从哪个部位开始？</view>
      <view class="ss-row">
        <view class="ss-chip" data-i="3" bindtap="pickSpot">🦶 脚</view>
        <view class="ss-chip" data-i="6" bindtap="pickSpot">🫁 胸口和肩</view>
        <view class="ss-chip" data-i="8" bindtap="pickSpot">😌 头</view>
        <view class="ss-chip" data-i="0" bindtap="pickSpot">🧘 从头开始</view>
      </view>
      <view class="ss-note">点哪个，就从那个部位开始这一轮</view>
    </view>
    <button class="btn-primary full" bindtap="begin">开始{{mode === 'micro' ? '微扫' : (mode === 'quick' ? '快扫' : '扫描')}}</button>
    <view class="scan-bm" wx:if="{{bookmark >= 0 && mode === 'full'}}" role="group" aria-label="有扫描书签">
      <text class="bm-tip">上次停在第 {{bookmark + 1}} 段「{{stages[bookmark].t}}」</text>
      <view class="bm-actions">
        <view class="bm-chip primary" bindtap="continueBookmark">🔖 从这里继续</view>
        <view class="bm-chip" bindtap="clearBookmark">清掉书签</view>
      </view>
    </view>
    <view class="scan-last" wx:if="{{lastDone}}">{{lastDone}}</view>
    <view class="scan-next" role="button" bindtap="goBreathe" aria-label="再去呼吸页做一轮">🌿 还想再放松？接着做一轮呼吸 →</view>
    <button class="btn-ghost full mt" bindtap="exit">返回</button>
  </view>

  <!-- 进行态 -->
  <view class="scan-card run" wx:elif="{{phase === 'run'}}">
    <view class="scan-prog">
      <view class="scan-prog-fill" style="width:{{pct}}%"></view>
    </view>
    <view class="scan-step">{{idx + 1}} / {{modeTotal}}</view>
    <view class="scan-part">{{stages[idx].t}}</view>
    <view class="scan-desc">{{stages[idx].d}}</view>
    <view class="scan-countdown">{{left}}</view>
    <button class="btn-ghost sm" bindtap="saveBookmark">🔖 存个书签（下次从这里继续）</button>
    <button class="btn-ghost full" bindtap="exit">提前结束</button>
  </view>

  <!-- 完成态 -->
  <view class="scan-card" wx:else>
    <view class="scan-hero">🌿</view>
    <view class="scan-title">这次{{mode === 'micro' ? '微扫' : (mode === 'quick' ? '快扫' : '扫描')}}，你做到了<text wx:if="{{doneN}}"> · 累计第 {{doneN}} 次</text></view>
    <view class="scan-sub">{{mode === 'micro' ? '60 秒也够身体回个神——零碎时间里的自我照顾，同样算数。' : (mode === 'quick' ? '3 分钟也够身体缓一缓：课间里留的这口气，很值得。' : '给自己一点安静，本身就是一种照顾。')}}</view>
    <view class="scan-last" wx:if="{{lastDone}}">{{lastDone}}</view>
    <!-- 完成时告知：已自动记一笔「平静」，可选此刻程度（1-5） -->
    <view class="calm-pick" role="note" aria-label="此刻的平静程度">
      <view class="cp-label">刚才的扫描已自动记成「平静」，此刻有多平静？</view>
      <view class="cp-row">
        <view class="cp-chip {{calmInt === item ? 'on' : ''}}" wx:for="{{[1,2,3,4,5]}}" wx:key="*this"
              data-v="{{item}}" bindtap="setCalmInt" role="button" aria-label="程度 {{item}}">{{item}}</view>
      </view>
    </view>
    <!-- 身体感受一词：扫完给身体一个描述（本地留档，可回看） -->
    <view class="feel-pick" role="group" aria-label="选择身体感受">
      <view class="fp-label">现在身体是什么感觉？挑一个词</view>
      <view class="stretch-tip" wx:if="{{stretchTip}}" role="note" aria-label="伸展小建议">🤸 顺手来一下：{{stretchTip}}</view>
      <view class="fp-row">
        <view class="fp-chip {{feelPicked === item ? 'on' : ''}}" wx:for="{{['松了','暖了','还有点紧','没什么感觉','困了','轻了','稳了','累了']}}" wx:key="*this"
              data-w="{{item}}" bindtap="pickFeel" role="button" aria-label="{{item}}">{{item}}</view>
      </view>
      <view class="fp-top" wx:if="{{feelTop}}" role="note" aria-label="身体感受最常反馈">🫧 {{feelTop}}</view>
      <view class="fp-slot" wx:if="{{avgSlot}}" role="note" aria-label="最常完成时段">🕰 {{avgSlot}}</view>
      <view class="fp-log" wx:if="{{feelLog.length}}" role="note" aria-label="最近几次身体感受">
        <text class="fp-log-t">最近几次：</text>
        <text class="fp-log-i" wx:for="{{feelLog}}" wx:key="t">{{item.w}}</text>
      </view>
    </view>
    <!-- 今日身体最需要什么：扫完给身体一个「下一步回应」（存 log 每日回看） -->
    <view class="need-pick" role="group" aria-label="今天身体最需要什么">
      <view class="np-label">今天身体最需要：</view>
      <view class="np-row">
        <view class="np-chip {{needPicked === item ? 'on' : ''}}" wx:for="{{['多喝水','早睡一点','动一动','晒太阳','吃顿好的','抱抱自己']}}" wx:key="*this"
              data-w="{{item}}" bindtap="pickNeed" role="button" aria-label="{{item}}">{{item}}</view>
      </view>
      <view class="np-picked" wx:if="{{needPicked}}">已记下：「{{needPicked}}」——今晚就给自己这一件就好 ☀️</view>
    </view>
    <!-- 完成回响：给身体的留言（可一键复制带走） -->
    <view class="scan-echo" wx:if="{{scanEcho}}" role="note" aria-label="完成回响">
      <view class="scan-echo-body">
        <text class="scan-echo-e">🫧</text>
        <text class="scan-echo-t">{{scanEcho}}</text>
      </view>
      <view class="scan-echo-copy" bindtap="copyScanEcho" role="button" aria-label="复制这段身体留言">📋 复制这份身体留言</view>
    </view>
    <!-- 近7天身体小日历：哪天扫过一眼看清，今天也会点亮 -->
    <view class="week7" wx:if="{{week7.length}}" role="note" aria-label="近7天扫描日历">
      <text class="w7-label">近 7 天：</text>
      <view class="w7-cell {{item.dot ? 'on' : ''}} {{item.today ? 'today' : ''}}" wx:for="{{week7}}" wx:key="key">
        <text class="w7-w">{{item.w}}</text>
        <text class="w7-dot">{{item.dot ? '●' : '○'}}</text>
      </view>
    </view>
    <button class="btn-primary full" bindtap="again">再来一次</button>
    <view class="scan-next" role="button" bindtap="goBreathe" aria-label="再去呼吸页做一轮">🌿 还想再放松？接着做一轮呼吸 →</view>
    <button class="btn-ghost full mt" bindtap="exit">返回</button>
  </view>
</view>