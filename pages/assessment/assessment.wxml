<view class="container">
  <!-- 答题态 -->
  <block wx:if="{{!done}}">
    <view class="progress">
      <text class="p-num">{{cur + 1}}/{{questions.length}}</text>
      <view class="p-bar"><view class="p-fill" style="width:{{(cur / questions.length) * 100}}%"></view></view>
    </view>

    <view class="card q-card">
      <view class="q-text">{{questions[cur]}}</view>
      <view class="opt" data-score="0" bindtap="pick">
        <text>完全不然</text><text class="mark">0</text>
      </view>
      <view class="opt" data-score="1" bindtap="pick">
        <text>有几天</text><text class="mark">1</text>
      </view>
      <view class="opt" data-score="2" bindtap="pick">
        <text>一半以上的时间</text><text class="mark">2</text>
      </view>
      <view class="opt" data-score="3" bindtap="pick">
        <text>几乎每天</text><text class="mark">3</text>
      </view>
      <view class="text-muted tip">请根据「过去两周」的感受选择。</view>
    </view>

    <button class="btn-ghost prev" wx:if="{{cur > 0}}" bindtap="prev">上一题</button>
  </block>

  <!-- 结果态 -->
  <block wx:else>
    <view class="card result">
      <view class="r-emoji">{{total <= 4 ? '🌤' : total <= 11 ? '🌥' : '⛈'}}</view>
      <view class="r-label">焦虑水平：{{label}}</view>
      <view class="r-score">得分 {{total}} / 21</view>
      <view class="r-advice">{{advice}}</view>
      <view class="text-muted r-note">自评仅作参考，不能代替专业诊断。</view>
    </view>

    <!-- 自评历史回顾：最近几次变化 -->
    <view class="card mt" wx:if="{{hist.length}}">
      <view class="section-title">📈 自评历史变化</view>
      <view class="hrow" wx:for="{{hist}}" wx:key="index">
        <text class="hdate">{{item.date}}</text>
        <view class="hdrop"><view class="hbar" style="width: {{item.total / 21 * 100}}%"></view></view>
        <text class="hval">{{item.total}} 分 · {{item.level}}</text>
      </view>
      <view wx:if="{{histDelta}}" class="text-muted hdelta">{{histDelta}}</view>
      <view wx:if="{{topWeakText}}" class="hinsight">🧭 最常困扰你：<text class="hinsight-b">{{topWeakText}}</text></view>
      <view wx:if="{{improveText}}" class="hinsight">💚 {{improveText}}</view>
    </view>

    <!-- 3 天陪伴计划 -->
    <view class="card mt" wx:if="{{plan}}">
      <view class="section-title">3 天陪伴计划 · {{plan.label}}</view>
      <view class="plan-row" wx:for="{{plan.days}}" wx:key="n">
        <text class="pd-num">{{item.n}}</text>
        <view class="pd-main">
          <view class="pd-title">{{item.title}}</view>
          <view class="pd-desc">{{item.desc}}</view>
        </view>
        <text class="pd-check {{plan.done[index] ? (index < planIdx ? 'done' : 'on') : ''}}" wx:if="{{index < planIdx || plan.done[index]}}" aria-label="第{{item.n}}天已完成">✓</text>
        <text class="pd-check do" wx:if="{{index === planIdx && !plan.done[index]}}" data-i="{{index}}" bindtap="toggleDay" role="button" aria-label="打卡第{{item.n}}天">☐</text>
      </view>
      <view class="text-muted plan-note">
        <block wx:if="{{planIdx < 0}}">计划未到开始日，先照顾好自己。</block>
        <block wx:elif="{{planAllDone}}">✨ 3 天任务全部完成，为你骄傲。</block>
        <block wx:else>今天 · 第 {{planIdx + 1}} 天可打卡（每日一章）</block>
      </view>
    </view>
    <button class="btn-ghost full mt" wx:else bindtap="startPlan">生成 3 天陪伴计划</button>

    <button class="btn-primary full" bindtap="goChat">和心语聊聊</button>
    <button class="btn-ghost full mt" bindtap="openCard">生成焦虑应对卡（可保存图片）</button>
    <button class="btn-ghost full mt" bindtap="goHelper">去看求助热线</button>
    <button class="btn-ghost full mt" bindtap="restart">重新测评</button>
  </block>

  <!-- 应对卡浮层 -->
  <view class="mask" wx:if="{{showCard}}" bindtap="closeCard" catchtouchmove="noop">
    <view class="sheet" catchtap="noop">
      <canvas type="2d" id="cardCanvas" class="card-canvas"></canvas>
      <view class="card-actions">
        <button class="btn-primary full" bindtap="saveCardImg" loading="{{drawing}}">保存到相册</button>
        <button class="btn-ghost full mt" bindtap="closeCard">关闭</button>
      </view>
    </view>
  </view>
</view>