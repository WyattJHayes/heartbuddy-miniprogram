<view class="container">
  <!-- 距上次测评 ≥3 天 → 轻提示条（可一键开始新测） -->
  <view class="retest-card" wx:if="{{lastDays}}" role="note" aria-label="距离上次自评较久">
    <view class="rt-main">
      <view class="rt-text">距离上次自评已过 {{lastDays}} 天，状态也许有变化，花 3 分钟再看看自己？</view>
      <view class="rt-btn" bindtap="restartTest" role="button" aria-label="一键开始新自评">再测一次</view>
    </view>
  </view>

  <!-- 答题态 -->
  <block wx:if="{{!done}}">
    <view class="quick-row" wx:if="{{cur === 0}}">
      <view class="quick-chip" bindtap="startQuickTest" role="button" aria-label="只做3题快评" wx:if="{{!quickMode}}">⚡ 现在只做 3 题快评（30 秒）</view>
      <view class="quick-chip" bindtap="exitQuickTest" role="button" aria-label="放回到完整7题" wx:if="{{quickMode}}">↩ 放回到完整 7 题</view>
    </view>
    <view class="progress">
      <text class="p-num">{{cur + 1}}/{{questions.length}}</text>
      <view class="p-bar"><view class="p-fill" style="width:{{(cur / questions.length) * 100}}%"></view></view>
    </view>

    <view class="card q-card">
      <view class="q-text">{{questions[cur]}}</view>
      <view class="opt" data-score="0" bindtap="pick">
        <text>完全不然</text><text class="mark">0</text>
      </view>
      <view class="opt" data-score="1" bindtap="pick">
        <text>有几天</text><text class="mark">1</text>
      </view>
      <view class="opt" data-score="2" bindtap="pick">
        <text>一半以上的时间</text><text class="mark">2</text>
      </view>
      <view class="opt" data-score="3" bindtap="pick">
        <text>几乎每天</text><text class="mark">3</text>
      </view>
      <view class="text-muted tip">请根据「过去两周」的感受选择。</view>
      <view class="light-tip" wx:if="{{lightTip && lightKey === cur - 1}}" role="note" aria-label="刚才那句轻反馈">{{lightTip}}</view>
    </view>

    <button class="btn-ghost prev" wx:if="{{cur > 0}}" bindtap="prev">上一题</button>
  </block>

  <!-- 结果态 -->
  <block wx:else>
    <view class="card result">
      <view class="r-emoji">{{total <= 4 ? '🌤' : total <= 11 ? '🌥' : '⛈'}}</view>
      <view class="r-label">焦虑水平：{{label}}</view>
      <view class="r-score">得分 {{total}} / 21</view>
      <view class="r-advice">{{advice}}</view>
      <view class="text-muted r-note">自评仅作参考，不能代替专业诊断。</view>
      <view class="r-copy" bindtap="copySelfTest" role="button" aria-label="复制本次自评小结">📋 复制一份「我这次的自评」（给老师/家长都方便）</view>
      <!-- 安全责任：明确就医指引（得分高时显式提醒，低分也给出求助入口） -->
      <view class="care-note" wx:if="{{total >= 8}}" role="note" aria-label="更专业的帮助在等你">
        如果这份感受已经持续一段时间，或影响到了吃饭睡觉，欢迎你向校心理中心、医院心理科或咨询师求助，你不必一个人扛。
      </view>
      <view class="r-link" role="button" aria-label="去情绪充电站看舒缓方法" bindtap="goStation">🔋 想先缓一缓？去情绪充电站看看舒缓方法 →</view>
      <view class="r-link" role="button" aria-label="先去做一轮呼吸平复一下" bindtap="goBreatheFirst">🌬 先去做一轮呼吸，平复一下 →</view>
      <view class="r-link" wx:if="{{!retestRemind}}" bindtap="setRetestRemind" role="button" aria-label="设置3天后复查提醒">
        ⏰ 给自己设个复查提醒：3 天后回来看看有没有变化 →
      </view>
      <view class="retest-due" wx:if="{{retestRemind && retestDue}}" role="note" aria-label="复查时间到了，去立即重测吧">
        复查时间到啦 ⏰ 花 3 分钟看看现在的自己
        <view class="rd-btn" bindtap="restartTest" role="button" aria-label="立即开始复查测评">立即重测 ›</view>
      </view>
      <view class="retest-done" wx:elif="{{retestRemind}}" role="note" aria-label="复查提醒已设置">已预约 3 天后复查，到时记得回来看看自己 🌱</view>
      <!-- 历史波动提醒：≥2 次测评后，对比最近两次总分给温和趋势 -->
      <view class="trend-pill" wx:if="{{trendText}}" role="note" aria-label="历史测评趋势提醒">{{trendText}}</view>
    </view>

    <!-- 自评历史回顾：最近几次变化 -->
    <view class="card mt long-trend" wx:if="{{longTrend}}" role="note" aria-label="首次至今总变化">
      <view class="lt-text">📈 {{longTrend}}</view>
    </view>

    <!-- 近 3 次得分对比：一眼看到自己在往哪走 -->
    <view class="card mt" wx:if="{{last3Bars.length >= 2}}">
      <view class="section-title">近 3 次得分对比</view>
      <view class="l3-row" role="img" aria-label="近3次得分对比">
        <view class="l3-col" wx:for="{{last3Bars}}" wx:key="date">
          <view class="l3-num {{item.latest ? 'hot' : ''}}">{{item.total}}</view>
          <view class="l3-bar {{item.latest ? 'hot' : ''}}" style="height: {{item.h}}rpx;"></view>
          <view class="l3-date">{{item.date}}</view>
        </view>
      </view>
      <view class="text-muted l3-tip">分数越低越轻松 · 高亮的是这次</view>
    </view>

    <view class="card mt" wx:if="{{hist.length}}">
      <view class="section-title">📈 自评历史变化</view>
      <view class="hrow" wx:for="{{hist}}" wx:key="index" bindtap="openHistDetail" data-i="{{index}}" role="button" aria-label="点开查看当时逐题回答">
        <text class="hdate">{{item.date}}</text>
        <view class="hdrop"><view class="hbar" style="width: {{item.total / 21 * 100}}%"></view></view>
        <text class="hval">{{item.total}} 分 · {{item.level}}</text>
      </view>
      <view wx:if="{{histDelta}}" class="text-muted hdelta">{{histDelta}}</view>
      <view wx:if="{{topWeakText}}" class="hinsight">🧭 最常困扰你：<text class="hinsight-b">{{topWeakText}}</text></view>
      <view wx:if="{{improveText}}" class="hinsight">💚 {{improveText}}</view>
      <view class="hrow-tip">点某次自评，可回看当时每一题的答案</view>
    </view>

    <!-- 历史逐题回看浮层 -->
    <view class="hd-mask" wx:if="{{histDetail}}" bindtap="closeHistDetail">
      <view class="hd-sheet" catchtap="noop">
        <view class="hd-title">🗓 {{histDetail.date}} 的自评 · {{histDetail.total}} 分（{{histDetail.level}}）</view>
        <scroll-view scroll-y class="hd-scroll">
          <view class="hd-item" wx:for="{{histDetail.items}}" wx:key="index">
            <view class="hd-q">{{index + 1}}. {{quesList[index]}}</view>
            <view class="hd-a">我选了：{{histDetail.items[index]}} 分</view>
          </view>
        </scroll-view>
        <!-- 给那次的自己写一句（本地留存，下次回看可见） -->
        <view class="hd-note">
          <view class="hd-note-t">💌 对那次的自己说一句</view>
          <textarea class="hd-note-ta" value="{{histDetail.note}}" bindinput="histNoteInput" placeholder="例如：那次辛苦了，现在的你已经好多了…" maxlength="120" auto-height />
          <view class="hd-note-save" bindtap="saveHistNote" role="button" aria-label="保存留言">{{histDetail.note ? '保存留言' : '写上这句'}}</view>
        </view>
        <view class="hd-close" bindtap="closeHistDetail" role="button" aria-label="关闭">知道了</view>
      </view>
    </view>

    <!-- 7 维感受雷达：每题得分可视化，看一眼“自己现在的形状” -->
    <view class="card mt" wx:if="{{showRadar && done}}">
      <view class="section-title">🧭 现在的你像什么样</view>
      <canvas type="2d" id="radarCanvas" class="radar-canvas" aria-label="7道题焦虑程度雷达图"></canvas>
      <view class="text-muted radar-note">越靠近边缘的维度越接近满分（3 分）。</view>
    </view>

    <!-- 3 天陪伴计划 -->
    <view class="card mt" wx:if="{{plan}}">
      <view class="section-title">3 天陪伴计划 · {{plan.label}}</view>
      <view class="plan-row" wx:for="{{plan.days}}" wx:key="n">
        <text class="pd-num">{{item.n}}</text>
        <view class="pd-main">
          <view class="pd-title">{{item.title}}</view>
          <view class="pd-desc">{{item.desc}}</view>
        </view>
        <text class="pd-check {{plan.done[index] ? (index < planIdx ? 'done' : 'on') : ''}}" wx:if="{{index < planIdx || plan.done[index]}}" aria-label="第{{item.n}}天已完成">✓</text>
        <text class="pd-check do" wx:if="{{index === planIdx && !plan.done[index]}}" data-i="{{index}}" bindtap="toggleDay" role="button" aria-label="打卡第{{item.n}}天">☐</text>
      </view>
      <view class="text-muted plan-note">
        <block wx:if="{{planIdx < 0}}">计划未到开始日，先照顾好自己。</block>
        <block wx:elif="{{planAllDone}}">✨ 3 天任务全部完成，为你骄傲。</block>
        <block wx:else>今天 · 第 {{planIdx + 1}} 天可打卡（每日一章）</block>
      </view>
    </view>
    <button class="btn-ghost full mt" wx:else bindtap="startPlan">生成 3 天陪伴计划</button>

    <button class="btn-primary full" bindtap="goChat">和心语聊聊</button>
    <button class="btn-ghost full mt" bindtap="openCard">生成焦虑应对卡（可保存图片）</button>
    <button class="btn-ghost full mt" bindtap="shareTrusted">把这段话发给信任的人（复制文字）</button>
    <button class="btn-ghost full mt" bindtap="goHelper">去看求助热线</button>
    <button class="btn-ghost full mt" bindtap="restart">重新测评</button>
  </block>

  <!-- 应对卡浮层 -->
  <view class="mask" wx:if="{{showCard}}" bindtap="closeCard" catchtouchmove="noop">
    <view class="sheet" catchtap="noop">
      <canvas type="2d" id="cardCanvas" class="card-canvas"></canvas>
      <view class="card-actions">
        <button class="btn-primary full" bindtap="saveCardImg" loading="{{drawing}}">保存到相册</button>
        <button class="btn-ghost full mt" bindtap="closeCard">关闭</button>
      </view>
    </view>
  </view>
</view>