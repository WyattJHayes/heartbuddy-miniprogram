.progress { display: flex; align-items: center; gap: 16rpx; margin-bottom: 20rpx; }
.p-num { font-size: 26rpx; color: #5b8def; }
.p-bar { flex: 1; height: 12rpx; background: #e5e9f2; border-radius: 12rpx; overflow: hidden; }
.p-fill { height: 100%; background: #5b8def; border-radius: 12rpx; transition: width 0.3s; }

.q-card { }
.q-text { font-size: 34rpx; font-weight: 600; line-height: 1.6; margin-bottom: 28rpx; }
.opt {
  display: flex; justify-content: space-between; align-items: center;
  padding: 24rpx 28rpx; background: #f7f8fb; border-radius: 16rpx;
  margin-bottom: 16rpx; font-size: 28rpx;
}
.mark { color: #5b8def; font-weight: 600; }
.prev { width: 100%; }

.result { text-align: center; }
.r-emoji { font-size: 110rpx; margin: 16rpx 0; }
.r-label { font-size: 36rpx; font-weight: 700; }
.r-score { font-size: 28rpx; color: #5b8def; margin: 12rpx 0; font-weight: 600; }
.r-advice { font-size: 29rpx; line-height: 1.8; text-align: left; background: #f2f6ff; padding: 28rpx; border-radius: 16rpx; margin-top: 20rpx; }
.r-note { font-size: 22rpx; color: #9ca3af; margin-top: 16rpx; }

.full { width: 100%; }
.mt { margin-top: 20rpx; }
/* 应对卡浮层 */
.mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(20, 26, 40, 0.55); display: flex; align-items: center; justify-content: center; z-index: 999; }
.sheet { width: 660rpx; max-height: 92vh; background: #fff; border-radius: 32rpx; padding: 32rpx; display: flex; flex-direction: column; align-items: center; overflow-y: auto; }
.card-canvas { width: 620rpx; height: 1060rpx; border-radius: 16rpx; background: #fff; }
.card-actions { width: 100%; margin-top: 24rpx; }
.card-actions .mt { margin-top: 16rpx; }

/* 3 天陪伴计划（与心情页风格一致） */
.plan-row { display: flex; align-items: flex-start; gap: 16rpx; padding: 16rpx 0; border-bottom: 1rpx solid #f3f4f6; }
.plan-row:last-child { border-bottom: none; }
.pd-num { width: 44rpx; height: 44rpx; border-radius: 12rpx; background: #eef4ff; color: #3e5ba3; font-size: 24rpx; font-weight: 600; text-align: center; line-height: 44rpx; flex-shrink: 0; }
.pd-main { flex: 1; }
.pd-title { font-size: 27rpx; font-weight: 600; }
.pd-desc { font-size: 23rpx; color: #8a95a7; line-height: 1.6; margin-top: 4rpx; }
.pd-check { width: 44rpx; height: 44rpx; border-radius: 50%; border: 2rpx solid #c9ccd5; color: transparent; font-size: 30rpx; line-height: 44rpx; text-align: center; flex-shrink: 0; margin-top: 2rpx; }
.pd-check.done { border-color: #2f8f72; background: #e2f6ee; color: #2f8f72; }
.pd-check.on { border-color: #5b8def; background: #eef4ff; color: #5b8def; }
.pd-check.do { color: #b7c1d0; }
.plan-note { margin-top: 8rpx; font-size: 23rpx; }

/* 自评历史 */
.hrow { display: flex; align-items: center; gap: 16rpx; margin: 12rpx 0; }
.hdate { width: 170rpx; font-size: 23rpx; color: #5b6b85; }
.hdrop { flex: 1; height: 18rpx; background: #eef1f6; border-radius: 999rpx; overflow: hidden; }
.hbar { display: block; height: 100%; background: linear-gradient(90deg, #9dc2ff, #5b8def); border-radius: 999rpx; }
.hval { width: 200rpx; text-align: right; font-size: 23rpx; color: #3a4a63; }
.hdelta { margin-top: 12rpx; font-size: 23rpx; }

/* 自评历史：逐题洞察 */
.hinsight { margin-top: 12rpx; font-size: 25rpx; color: #4a5b76; line-height: 1.6; }
.hinsight + .hinsight { margin-top: 6rpx; }
.hinsight-b { font-weight: 600; color: #3f6fe0; }

/* 历史波动提醒 */
.trend-pill { margin-top: 18rpx; padding: 16rpx 20rpx; border-radius: 14rpx; background: #eef6ff;
  border: 1rpx solid #d5e6ff; font-size: 26rpx; color: #3d6bb3; line-height: 1.7; }

/* 距上次自评提示条 */
.retest-card { padding: 14rpx 18rpx; margin-bottom: 16rpx; background: #eff6ff;
  border: 1rpx solid #d5e6fa; border-radius: 12rpx; }
.rt-main { display: flex; align-items: center; gap: 14rpx; }
.rt-text { flex: 1; font-size: 25rpx; color: #41679a; line-height: 1.6; }
.rt-btn { flex-shrink: 0; font-size: 24rpx; color: #fff; background: #4a7be0; border-radius: 999rpx; padding: 10rpx 22rpx; }

/* 结果页轻引导：去充电站 */
.r-link { margin-top: 16rpx; font-size: 24rpx; color: #6d8fd4; }

.care-note { margin-top: 14rpx; font-size: 24rpx; line-height: 1.7; color: #8a6d3b;
  background: #fbf3e0; border-radius: 10rpx; padding: 12rpx 14rpx; }

.retest-done { margin-top: 16rpx; font-size: 24rpx; color: #4f7b45; background:#eef7ea; border-radius: 10rpx; padding: 12rpx 16rpx; }

.retest-due { margin-top: 16rpx; font-size: 24rpx; color: #b3392c; background: #fdeaea; border: 1rpx solid #f6c6c0; border-radius: 10rpx; padding: 14rpx 16rpx; }
.rd-btn { margin-top: 10rpx; display: inline-block; background: #d8482a; color: #fff; border-radius: 999rpx; padding: 6rpx 22rpx; font-size: 24rpx; }


.radar-canvas { width:320rpx; height:320rpx; margin:14rpx auto 0; display:block; }
.radar-note { font-size:22rpx; color:#a3adc4; margin-top:6rpx; }
