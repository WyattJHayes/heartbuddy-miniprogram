<view class="wrap">
  <view class="title">🧘 呼吸放松练习</view>
  <view class="sub">跟着圆圈一起呼吸，共 {{total}} 轮。全程在本机进行，不联网。</view>

  <!-- 累计练习次数（本地计数） -->
  <view class="breathe-stats" wx:if="{{breatheCount > 0}}" role="note" aria-label="累计练习统计">
    <text class="bs-dot">🌿</text>
    <text class="bs-text">{{lastDone}}</text>
  </view>

  <!-- 呼吸节奏切换 -->
  <view class="presets">
    <view class="preset-chip {{presetKey === item.key ? 'on' : ''}}" wx:for="{{presets}}"
          wx:key="key" data-key="{{item.key}}" bindtap="setPreset" role="button"
          aria-label="切换到{{item.label}}节奏">{{item.label}}</view>
  </view>

  <view class="ball-wrap">
    <view class="halo"></view>
    <view class="ball" style="width: {{ball}}rpx; height: {{ball}}rpx; transition: all {{trans}}s ease-in-out;"></view>
  </view>

  <view class="phase-text" aria-live="polite">{{text}}</view>
  <view class="rounds" wx:if="{{phase !== 'ready' && phase !== 'done'}}">第 {{round}} / {{total}} 轮</view>

  <view class="actions">
    <button class="primary" wx:if="{{phase === 'ready' || phase === 'done'}}" bindtap="start">
      {{phase === 'done' ? '再练一次' : '开始呼吸'}}
    </button>
    <button wx:elif="{{phase !== 'done'}}" bindtap="reset">结束</button>
  </view>

  <button wx:if="{{phase === 'done'}}" class="ghost" bindtap="recordCalm" loading="{{calm && false}}">
    {{calm ? '已记下此刻' : '记下此刻的平静心情'}}
  </button>
  <view wx:if="{{phase === 'done'}}" class="tip">点上面的按钮会把这一刻记成「平静」，同步到心情曲线。</view>
  <view wx:if="{{phase === 'done'}}" class="tip scan-link" role="button" bindtap="goScan">还想更放松？试试 5 分钟身体扫描 →</view>
</view>