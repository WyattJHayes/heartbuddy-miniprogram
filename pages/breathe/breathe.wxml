<view class="wrap">
  <view class="title">🧘 呼吸放松练习</view>
  <view class="sub">跟着圆圈一起呼吸，共 {{total}} 轮。全程在本机进行，不联网。</view>

  <!-- 累计练习次数（本地计数） -->
  <view class="breathe-stats" wx:if="{{breatheCount > 0}}" role="note" aria-label="累计练习统计">
    <text class="bs-dot">🌿</text>
    <text class="bs-text">{{lastDone}}</text>
    <text class="bs-week" wx:if="{{breatheWeek > 0}}">本周 {{breatheWeek}} 次</text>
    <text class="bs-week" wx:if="{{breatheToday > 0}}">今天 {{breatheToday}} 次 · 再来一次也没关系</text>
  </view>

  <!-- 今日放松目标：进度条 + 达标彩蛋（纯本地） -->
  <view class="daygoal">
    <view class="dg-top">
      <text class="dg-label">🌤 今日放松目标</text>
      <text class="dg-num" wx:if="{{dayDone}}">✅ 达成 {{dayMins}}/{{dayGoal}} 分钟</text>
      <text class="dg-num" wx:else>{{dayMins}}/10 分钟</text>
    </view>
    <view class="dg-bar"><view class="dg-fill" style="width: {{dayPct}}%"></view></view>
    <text class="dg-sub" wx:if="{{dayDone}}">连续 {{dayStreak}} 天达标，你越来越会照顾自己</text>
    <!-- 近 4 周放松热力图：颜色越深练得越多 -->
    <view class="heat-wrap" wx:if="{{heat.length}}" role="img" aria-label="近 4 周放松热力图">
      <view class="heat-row">
        <view class="heat-cell lv{{item.lv}} {{item.future ? 'future' : ''}}" wx:for="{{heat}}" wx:key="d"
              aria-label="{{item.d}} 练习 {{item.n}} 次"></view>
      </view>
      <view class="heat-sub">近 4 周放松热力 · 一共 {{breatheWeek}} 次本周 / 颜色越深越勤 🌊</view>
      <view class="week-vs" wx:if="{{weekVs}}" role="note" aria-label="本周与上周对比">📊 {{weekVs}}</view>
      <view class="best-run" wx:if="{{bestRun >= 3}}" role="note" aria-label="最长连练纪录">🏅 最长连练纪录 {{bestRun}} 天——那份坚持是你自己的。</view>
      <view class="dp-row" wx:if="{{dayPart.m + dayPart.n + dayPart.e + dayPart.late >= 3}}" role="note" aria-label="放松时段分布">
        <text class="dp-chip">🌅 早晨 {{dayPart.m}}</text>
        <text class="dp-chip">🌤 白天 {{dayPart.n}}</text>
        <text class="dp-chip">🌙 晚上 {{dayPart.e}}</text>
        <text class="dp-chip" wx:if="{{dayPart.late}}">🌃 深夜 {{dayPart.late}}</text>
      </view>
    </view>
    <text class="dg-sub" wx:else>一天两次呼吸，就是给自己护好 10 分钟</text>
    <view class="dg-log" wx:if="{{recentLog.length}}">
      <text class="dg-log-title">最近 {{recentLog.length}} 次放松</text>
      <view class="dg-log-chip" wx:for="{{recentLog}}" wx:key="index">{{item.day}} {{item.time}}</view>
    </view>
  </view>

  <!-- 呼吸节奏切换 -->
  <!-- 上次中断的温柔提示（24h 内有效） -->
  <view class="resume-tip" wx:if="{{resumeTip && phase === 'ready'}}" role="note" aria-label="上次练习中断提示">{{resumeTip}}</view>

  <!-- 按时段推荐：一句话告诉你此刻更适合哪种节奏 -->
  <view class="time-hint" wx:if="{{timeHint}}" role="note" aria-label="此刻推荐节奏">{{timeHint}}</view>
  <view class="presets">
    <view class="preset-chip {{presetKey === item.key ? 'on' : ''}}" wx:for="{{presets}}"
          wx:key="key" data-key="{{item.key}}" bindtap="setPreset" role="button"
          aria-label="切换到{{item.label}}节奏">{{item.label}}</view>
    <text class="stare-n" wx:if="{{presetKey === 'stare' && stareCount}}">已陪你发呆 {{stareCount}} 次 🌑</text>
  </view>

  <!-- 自定义节奏调节：选中「自定义」后出现 -->
  <view class="custom-box" wx:if="{{presetKey === 'custom' && phase !== 'done'}}" role="group" aria-label="自定义呼吸节奏">
    <view class="cb-row">
      <text class="cb-name">吸 {{customCfg.in}} 秒</text>
      <view class="cb-ops">
        <view class="cb-op" bindtap="adjCustom" data-f="in" data-d="-1" role="button" aria-label="吸气减少 1 秒">−</view>
        <view class="cb-op" bindtap="adjCustom" data-f="in" data-d="1" role="button" aria-label="吸气增加 1 秒">＋</view>
      </view>
    </view>
    <view class="cb-row">
      <text class="cb-name">屏 {{customCfg.hold}} 秒</text>
      <view class="cb-ops">
        <view class="cb-op" bindtap="adjCustom" data-f="hold" data-d="-1" role="button" aria-label="屏气减少 1 秒">−</view>
        <view class="cb-op" bindtap="adjCustom" data-f="hold" data-d="1" role="button" aria-label="屏气增加 1 秒">＋</view>
      </view>
    </view>
    <view class="cb-row">
      <text class="cb-name">呼 {{customCfg.out}} 秒</text>
      <view class="cb-ops">
        <view class="cb-op" bindtap="adjCustom" data-f="out" data-d="-1" role="button" aria-label="呼气减少 1 秒">−</view>
        <view class="cb-op" bindtap="adjCustom" data-f="out" data-d="1" role="button" aria-label="呼气增加 1 秒">＋</view>
      </view>
    </view>
    <view class="cb-presets">
      <text class="cb-quick" bindtap="fillCustom" data-k="relax" role="button" aria-label="填入4-4-6放松节奏">放松 4-4-6</text>
      <text class="cb-quick" bindtap="fillCustom" data-k="sleep" role="button" aria-label="填入4-7-8助眠节奏">助眠 4-7-8</text>
      <text class="cb-quick" bindtap="fillCustom" data-k="long" role="button" aria-label="填入6-2-6长呼节奏">长呼 6-2-6</text>
    </view>
    <view class="cb-tip">呼气比吸气长一点，会更放松（经典 4-7-8 助眠）。</view>
  </view>

  <view class="ball-wrap">
    <view class="halo"></view>
    <view class="ball" style="width: {{ball}}rpx; height: {{ball}}rpx; transition: all {{trans}}s ease-in-out;"></view>
  </view>

  <view class="phase-text" aria-live="polite">{{text}}</view>
  <view class="rounds" wx:if="{{phase !== 'ready' && phase !== 'done'}}">第 {{round}} / {{total}} 轮</view>

  <view class="actions">
    <button class="primary" wx:if="{{phase === 'ready' || phase === 'done'}}" bindtap="start">
      {{phase === 'done' ? '再练一次' : (presetKey === 'stare' ? '开始发呆' : '开始呼吸')}}
    </button>
    <button wx:elif="{{phase !== 'done'}}" bindtap="reset">结束</button>
  </view>

  <button wx:if="{{phase === 'done'}}" class="ghost" bindtap="recordCalm" loading="{{calm && false}}">
    {{calm ? '已记下此刻' : (presetKey === 'stare' ? '把这段安静记下来' : '记下此刻的平静心情')}}
  </button>
  <!-- 记录前可选平静强度（1-5） -->
  <view class="calm-pick" wx:if="{{phase === 'done' && !calm && presetKey !== 'stare'}}">
    <view class="cp-label">此刻的平静程度？</view>
    <view class="cp-row">
      <view class="cp-chip {{calmInt === item ? 'on' : ''}}" wx:for="{{[1,2,3,4,5]}}" wx:key="*this"
            data-v="{{item}}" bindtap="setCalmInt" role="button" aria-label="强度 {{item}} 分">{{item}}</view>
    </view>
  </view>
  <view wx:if="{{phase === 'done'}}" class="tip">点上面的按钮会把这一刻记成「平静」，同步到心情曲线。</view>
  <!-- 呼吸回响：完成练习后定格一句温柔的话 -->
  <view class="echo-card" wx:if="{{phase === 'done' && echoText}}" role="note" aria-label="放松回响">
    <text class="echo-emoji">🫧</text>
    <view class="echo-main">
      <text class="echo-text">{{echoText}}</text>
      <view class="echo-link" bindtap="goEdu" role="button" aria-label="去心理小课了解呼吸为什么有用">为什么呼吸有用？→ 心理小课</view>
    </view>
  </view>
  <view wx:if="{{phase === 'done'}}" class="tip scan-link" role="button" bindtap="goScan">还想更放松？试试 5 分钟身体扫描 →</view>
</view>