/* pages/breathe/breathe.wxss */
.wrap { padding: 48rpx 40rpx; display: flex; flex-direction: column; align-items: center; }
.title { font-size: 40rpx; font-weight: 700; color: #2d3a52; }
.sub { font-size: 24rpx; color: #8a94a8; margin-top: 12rpx; text-align: center; line-height: 1.7; }

.ball-wrap { position: relative; width: 520rpx; height: 520rpx; margin: 56rpx 0 24rpx; display: flex; align-items: center; justify-content: center; }
.halo { position: absolute; width: 520rpx; height: 520rpx; border-radius: 50%; background: rgba(91, 141, 239, 0.10); }
.ball { background: radial-gradient(circle at 32% 28%, #9dc2ff, #5b8def 62%, #3f6fd8); border-radius: 50%; box-shadow: 0 12rpx 40rpx rgba(91, 141, 239, 0.35); }

.phase-text { font-size: 30rpx; color: #3a4a63; font-weight: 600; min-height: 44rpx; text-align: center; }
.rounds { font-size: 24rpx; color: #98a2b5; margin-top: 12rpx; }

.actions { margin-top: 40rpx; display: flex; justify-content: center; gap: 24rpx; width: 100%; }
.primary { background: #5b8def; color: #fff; border-radius: 44rpx; font-weight: 600; width: 60%; }
button.ghost { margin-top: 28rpx; background: #eef4ff; color: #3f6fd8; border-radius: 44rpx; width: 70%; font-weight: 600; }
.tip { margin-top: 18rpx; font-size: 23rpx; color: #98a2b5; text-align: center; line-height: 1.7; }.scan-link { color: #5b8def; }

/* 呼吸节奏切换 */
.presets { display: flex; justify-content: center; gap: 16rpx; margin-top: 28rpx; }
.preset-chip { font-size: 23rpx; color: #7a8698; background: #f2f5fb; border: 1rpx solid #e3e9f4;
  border-radius: 999rpx; padding: 10rpx 22rpx; }
.preset-chip.on { color: #fff; background: #5b8def; border-color: #5b8def; font-weight: 600; }

/* 累计练习次数 */
.breathe-stats { display: inline-flex; align-items: center; gap: 10rpx; margin-top: 16rpx;
  padding: 10rpx 20rpx; background: #eef5ec; border-radius: 999rpx; }
.bs-dot { font-size: 26rpx; }
.bs-text { font-size: 24rpx; color: #4c7a52; }

.calm-pick { margin-top: 12rpx; }
.cp-label { font-size: 22rpx; color: #8a8f9a; margin-bottom: 8rpx; }
.cp-row { display: flex; gap: 12rpx; }
.cp-chip { flex: 1; text-align: center; padding: 10rpx 0; border-radius: 999rpx;
  background: #f2f4f8; color: #6b7280; font-size: 24rpx; }
.cp-chip.on { background: #4c7a52; color: #fff; }

.bs-week { margin-left: 16rpx; font-size: 22rpx; color: #4c7a52; font-weight: 600; }

.daygoal { margin:16rpx 24rpx 0; background:linear-gradient(90deg,#eef6ff,#f7f9ff); border:1rpx solid #dfe9f8; border-radius:16rpx; padding:18rpx 20rpx; }
.dg-top { display:flex; justify-content:space-between; align-items:center; }
.dg-t { font-size:26rpx; color:#33415c; font-weight:600; }
.dg-num { font-size:24rpx; color:#4a73d8; }
.dg-bar { height:14rpx; background:#e3eaf8; border-radius:999rpx; margin:12rpx 0 8rpx; overflow:hidden; }
.dg-fill { height:100%; width:0; background:linear-gradient(90deg,#7fb0ff,#4f8ef7); border-radius:999rpx; transition:width .4s; }
.dg-sub { font-size:22rpx; color:#8a95b3; }


.dg-log { margin-top:14rpx; }
.dg-log-title { font-size:21rpx; color:#9aa7c3; }
.dg-log-chip { display:inline-block; background:#eef2fb; color:#5a6a8b; font-size:20rpx; border-radius:8rpx; padding:4rpx 12rpx; margin:6rpx 8rpx 0 0; }


.echo-card { display:flex; align-items:center; margin:20rpx 24rpx; background:#eef8f0; border:1rpx solid #d4ecd9; border-radius:16rpx; padding:22rpx 24rpx; }
.echo-emoji { font-size:34rpx; margin-right:14rpx; }
.echo-text { flex:1; font-size:26rpx; color:#3f7a58; line-height:1.6; }

.custom-box { margin: 16rpx 24rpx 0; background: #fff; border: 1rpx solid #e8eef9; border-radius: 14rpx; padding: 16rpx 20rpx; }
.cb-row { display: flex; align-items: center; justify-content: space-between; padding: 8rpx 0; }
.cb-name { font-size: 26rpx; color: #3f4d68; width: 200rpx; }
.cb-ops { display: flex; }
.cb-op { width: 64rpx; height: 64rpx; line-height: 60rpx; text-align: center; border-radius: 50%; background: #eef3fc; color: #4a6ab0; font-size: 34rpx; margin-left: 14rpx; border: 1rpx solid #dbe6f8; }
.cb-tip { margin-top: 10rpx; font-size: 22rpx; color: #9aa3b8; line-height: 1.6; }

.echo-main { flex: 1; }
.echo-actions { display: flex; gap: 26rpx; margin-top: 10rpx; }
.echo-link { font-size: 22rpx; color: #4a8a63; text-decoration: underline; }

.heat-wrap { margin-top: 16rpx; }
.heat-row { display: flex; flex-wrap: wrap; gap: 6rpx; }
.heat-cell { width: calc((100% - 36rpx) / 7); height: 30rpx; border-radius: 6rpx; background: #edf0f5; }
.heat-cell.lv1 { background: #cfe6d8; }
.heat-cell.lv2 { background: #8fc9a6; }
.heat-cell.lv3 { background: #4f9e6b; }
.heat-cell.future { opacity: .25; }
.heat-sub { margin-top: 10rpx; font-size: 20rpx; color: #9aa3b8; }

.time-hint { margin: 14rpx 24rpx 0; background: #f3f6fd; border-radius: 12rpx; padding: 12rpx 18rpx; font-size: 23rpx; color: #5b6b8c; }

.dp-row { display: flex; flex-wrap: wrap; margin-top: 12rpx; }
.dp-chip { font-size: 21rpx; color: #5b6b8c; background: #f1f4fa; border-radius: 999rpx; padding: 6rpx 18rpx; margin: 0 10rpx 8rpx 0; }

.cb-presets { display: flex; margin-top: 12rpx; }
.cb-quick { font-size: 22rpx; color: #4a6ab0; background: #eef3fc; border: 1rpx solid #d8e4f8; border-radius: 999rpx; padding: 8rpx 20rpx; margin-right: 12rpx; }

.resume-tip { margin: 14rpx 24rpx 0; background: #fdf6ea; border: 1rpx solid #f0dcbc; border-radius: 12rpx; padding: 12rpx 18rpx; font-size: 23rpx; color: #8a6a2f; line-height: 1.7; }

.week-vs { margin-top: 10rpx; font-size: 22rpx; color: #4e7a58; background: #f6fbf6; border-radius: 10rpx; padding: 10rpx 16rpx; line-height: 1.6; }

.stare-n { display: block; width: 100%; text-align: center; font-size: 21rpx; color: #7a82a0; margin-top: 10rpx; }

.best-run { margin-top: 8rpx; font-size: 22rpx; color: #8a6a2f; background: #fdf6ea; border-radius: 10rpx; padding: 10rpx 16rpx; }

/* 再来一轮 */
.again-row { display: flex; align-items: center; justify-content: center; gap: 10rpx; margin: 18rpx 24rpx 0; padding: 16rpx 0; background: #eef7ff; border: 1rpx solid #d3e8fb; border-radius: 999rpx; color: #3f6498; font-size: 25rpx; font-weight: 600; }
.again-emoji { font-size: 28rpx; }
.again-t { color: #3f6498; }

/* 此刻心意 */
.intent-row { margin-top: 22rpx; text-align: center; }
.intent-label { font-size: 24rpx; color: #7a8aa8; }
.intent-chips { display: flex; justify-content: center; gap: 14rpx; margin-top: 12rpx; }
.intent-chip { padding: 10rpx 26rpx; border-radius: 30rpx; border: 2rpx solid #dde4f0; background: #fff; color: #55627e; font-size: 26rpx; }
.intent-chip.on { border-color: #7fb0e6; background: #eaf4ff; color: #3f6aa8; font-weight: 600; }
.done-intent { margin-top: 18rpx; text-align: center; font-size: 24rpx; color: #7a8aa8; }

/* 节律震动开关 */
.vibe-toggle { margin: 20rpx auto 0; width: 70%; text-align: center; padding: 12rpx 0; border-radius: 30rpx; background: #f3f6fb; color: #7a8aa8; font-size: 23rpx; }
.vibe-toggle.on { background: #eaf4ff; color: #3f6aa8; }

/* 这一轮留给谁 */
.for-pick { margin-top: 14rpx; text-align: center; }
.for-n { font-size: 23rpx; color: #8a93a8; margin-bottom: 10rpx; }
.fp-row { display: flex; gap: 14rpx; justify-content: center; }
.fp-chip { padding: 10rpx 26rpx; border-radius: 30rpx; background: #eef3f8; color: #6b7a8e; font-size: 24rpx; }
.fp-chip:active { transform: scale(0.96); }
.done-for { margin-top: 14rpx; text-align: center; font-size: 24rpx; color: #5f8a6a; }

.share-br { margin-top: 6rpx; }

.face-pick { margin-top: 10rpx; text-align: center; }
.fp-label2 { font-size: 23rpx; color: #8a93a8; margin-bottom: 8rpx; }
.fp-row2 { display: flex; gap: 12rpx; justify-content: center; }
.fp-chip2 { padding: 8rpx 22rpx; border-radius: 26rpx; background: #eef3f8; color: #6b7a8e; font-size: 24rpx; }
.fp-chip2.on { background: #e3f6e3; color: #3f7a4f; }
.fp-chip2.on2 { background: #fdecec; color: #a45c5c; }
.face-tip { margin-top: 8rpx; font-size: 22rpx; color: #7a8ba0; }

/* 呼吸球随阶段变色：吸=清澈蓝，屏=淡蓝静置，呼=暖橙回稳 */
.ball.in { background: radial-gradient(circle at 32% 28%, #bcd8ff, #73a5f5 62%, #4f86e8); box-shadow: 0 12rpx 40rpx rgba(91, 141, 239, 0.35); }
.ball.hold { background: radial-gradient(circle at 32% 28%, #eaf3ff, #b9d6fb 62%, #8fb4f0); box-shadow: 0 12rpx 40rpx rgba(143, 180, 240, 0.28); }
.ball.out { background: radial-gradient(circle at 32% 28%, #ffe3c0, #ffc48f 62%, #f5a45f); box-shadow: 0 12rpx 40rpx rgba(245, 164, 95, 0.30); }

.nap-card { margin-top: 12rpx; text-align: center; }
.nap-cta { color: #5a7fb8; font-size: 25rpx; }
.nap-left { font-size: 30rpx; font-weight: 700; color: #3a4a63; letter-spacing: 2rpx; margin-right: 16rpx; }
