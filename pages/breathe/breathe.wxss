/* pages/breathe/breathe.wxss */
.wrap { padding: 48rpx 40rpx; display: flex; flex-direction: column; align-items: center; }
.title { font-size: 40rpx; font-weight: 700; color: #2d3a52; }
.sub { font-size: 24rpx; color: #8a94a8; margin-top: 12rpx; text-align: center; line-height: 1.7; }

.ball-wrap { position: relative; width: 520rpx; height: 520rpx; margin: 56rpx 0 24rpx; display: flex; align-items: center; justify-content: center; }
.halo { position: absolute; width: 520rpx; height: 520rpx; border-radius: 50%; background: rgba(91, 141, 239, 0.10); }
.ball { background: radial-gradient(circle at 32% 28%, #9dc2ff, #5b8def 62%, #3f6fd8); border-radius: 50%; box-shadow: 0 12rpx 40rpx rgba(91, 141, 239, 0.35); }

.phase-text { font-size: 30rpx; color: #3a4a63; font-weight: 600; min-height: 44rpx; text-align: center; }
.rounds { font-size: 24rpx; color: #98a2b5; margin-top: 12rpx; }

.actions { margin-top: 40rpx; display: flex; justify-content: center; gap: 24rpx; width: 100%; }
.primary { background: #5b8def; color: #fff; border-radius: 44rpx; font-weight: 600; width: 60%; }
button.ghost { margin-top: 28rpx; background: #eef4ff; color: #3f6fd8; border-radius: 44rpx; width: 70%; font-weight: 600; }
.tip { margin-top: 18rpx; font-size: 23rpx; color: #98a2b5; text-align: center; line-height: 1.7; }.scan-link { color: #5b8def; }

/* 呼吸节奏切换 */
.presets { display: flex; justify-content: center; gap: 16rpx; margin-top: 28rpx; }
.preset-chip { font-size: 23rpx; color: #7a8698; background: #f2f5fb; border: 1rpx solid #e3e9f4;
  border-radius: 999rpx; padding: 10rpx 22rpx; }
.preset-chip.on { color: #fff; background: #5b8def; border-color: #5b8def; font-weight: 600; }

/* 累计练习次数 */
.breathe-stats { display: inline-flex; align-items: center; gap: 10rpx; margin-top: 16rpx;
  padding: 10rpx 20rpx; background: #eef5ec; border-radius: 999rpx; }
.bs-dot { font-size: 26rpx; }
.bs-text { font-size: 24rpx; color: #4c7a52; }

.calm-pick { margin-top: 12rpx; }
.cp-label { font-size: 22rpx; color: #8a8f9a; margin-bottom: 8rpx; }
.cp-row { display: flex; gap: 12rpx; }
.cp-chip { flex: 1; text-align: center; padding: 10rpx 0; border-radius: 999rpx;
  background: #f2f4f8; color: #6b7280; font-size: 24rpx; }
.cp-chip.on { background: #4c7a52; color: #fff; }

.bs-week { margin-left: 16rpx; font-size: 22rpx; color: #4c7a52; font-weight: 600; }

.daygoal { margin:16rpx 24rpx 0; background:linear-gradient(90deg,#eef6ff,#f7f9ff); border:1rpx solid #dfe9f8; border-radius:16rpx; padding:18rpx 20rpx; }
.dg-top { display:flex; justify-content:space-between; align-items:center; }
.dg-t { font-size:26rpx; color:#33415c; font-weight:600; }
.dg-num { font-size:24rpx; color:#4a73d8; }
.dg-bar { height:14rpx; background:#e3eaf8; border-radius:999rpx; margin:12rpx 0 8rpx; overflow:hidden; }
.dg-fill { height:100%; width:0; background:linear-gradient(90deg,#7fb0ff,#4f8ef7); border-radius:999rpx; transition:width .4s; }
.dg-sub { font-size:22rpx; color:#8a95b3; }
