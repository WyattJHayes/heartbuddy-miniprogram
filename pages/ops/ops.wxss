.center { text-align: center; }
.big { font-size: 90rpx; margin: 24rpx 0; }

.kpis { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; margin-bottom: 20rpx; }
.kpi { background: #fff; border-radius: 20rpx; padding: 24rpx; display: flex; flex-direction: column; align-items: center; box-shadow: 0 4rpx 16rpx rgba(31,41,55,0.06); }
.v { font-size: 48rpx; font-weight: 700; color: #5b8def; }
.v.warn { color: #e05c53; }
.t { font-size: 24rpx; color: #9ca3af; margin-top: 6rpx; }

.level { display: flex; justify-content: space-around; }
.lv { display: flex; flex-direction: column; align-items: center; }
.lv-num { font-size: 56rpx; font-weight: 700; }
.lv-high .lv-num { color: #e05a4e; }
.lv-mid .lv-num { color: #e8a13c; }
.lv-low .lv-num { color: #7fc08a; }
.lv-label { font-size: 24rpx; color: #9ca3af; }

.crow { display: flex; align-items: flex-start; padding: 16rpx 0; border-bottom: 1rpx solid #f3f4f6; }
.crow:last-child { border-bottom: none; }
.badge { font-size: 22rpx; color: #fff; border-radius: 8rpx; padding: 4rpx 14rpx; margin-right: 16rpx; }
.badge.high { background: #e05c4e; }
.badge.mid { background: #e8a13c; }
.badge.low { background: #3aa08a; }
.cmain { flex: 1; }
.ckeys { font-size: 27rpx; }
.ctime { font-size: 22rpx; color: #9ca3af; margin-top: 4rpx; }
.cstatus { font-weight: 600; }
.s-wait { color: #e8a13c; }
.s-ok { color: #3aa08a; }
.handle-btn { margin: 4rpx 0 0 16rpx; flex-shrink: 0; background: #e05c4e; color: #fff; font-size: 22rpx; line-height: 2.2; border-radius: 999rpx; padding: 0 28rpx; }
.handle-btn::after { border: none; }
.handle-btn[loading] { background: #c94a3e; opacity: 0.7; }
.ctag { flex-shrink: 0; color: #3aa08a; font-size: 36rpx; line-height: 1; margin: 6rpx 12rpx 0 16rpx; }

.full { width: 100%; }
.trend-copy { margin-top: 20rpx; font-size: 24rpx; }

/* 危机预警待处理高亮卡 */
.alert-card { border: 2rpx solid #ffb4a8; background: #fff7f6; }
.alert-main { display: flex; align-items: center; gap: 28rpx; }
.alert-l { display: flex; flex-direction: column; align-items: center; min-width: 150rpx; }
.alert-num { font-size: 88rpx; font-weight: 800; color: #e05c4e; line-height: 1; }
.alert-caption { font-size: 22rpx; color: #c94a3e; margin-top: 8rpx; }
.alert-r { flex: 1; }
.alert-title { font-size: 30rpx; font-weight: 700; color: #b33a2a; margin-bottom: 8rpx; }
.alert-desc { font-size: 24rpx; color: #a35c52; line-height: 1.6; }
/* 本周处理率 */
.rate-line { display: flex; flex-direction: column; gap: 6rpx; margin-top: 20rpx; padding-top: 20rpx; border-top: 1rpx solid #f0f2f7; }
.rate-v { font-size: 28rpx; font-weight: 700; color: #3aa08a; }
.rate-d { font-size: 22rpx; line-height: 1.6; }

/* 7 日均值 + 来源分布 */
.tm-item { display: flex; align-items: center; gap: 16rpx; margin: 10rpx 0; }
.tm-day { width: 96rpx; font-size: 23rpx; color: #5b6b85; }
.tm-bar { flex: 1; height: 22rpx; background: #eef1f6; border-radius: 999rpx; overflow: hidden; }
.tm-fill { height: 100%; background: linear-gradient(90deg, #9dc2ff, #5b8def); border-radius: 999rpx; }
.tm-val { width: 64rpx; text-align: right; font-size: 24rpx; font-weight: 600; color: #3a4a63; }
.src-row { display: flex; align-items: center; gap: 16rpx; margin: 10rpx 0; }
.src-name { width: 160rpx; font-size: 25rpx; color: #3a4a63; }
.src-bar { flex: 1; height: 20rpx; background: #eef1f6; border-radius: 999rpx; overflow: hidden; }
.src-fill { height: 100%; background: #f2a35c; border-radius: 999rpx; }
.src-num { width: 96rpx; text-align: right; font-size: 23rpx; color: #5b6b85; }

/* 高危趋势 + 高危用户 */
.hday { display: flex; align-items: center; gap: 14rpx; margin: 10rpx 0; }
.hday-label { width: 88rpx; font-size: 23rpx; color: #5b6b85; }
.hday-bar { flex: 1; height: 20rpx; background: #fdeaea; border-radius: 999rpx; overflow: hidden; }
.hday-fill { height: 100%; background: linear-gradient(90deg, #ffb3a0, #f26c4f); border-radius: 999rpx; }
.hday-num { width: 44rpx; text-align: right; font-size: 24rpx; font-weight: 700; color: #d8482a; }
.huser { display: flex; align-items: center; gap: 16rpx; margin: 14rpx 0; }
.huser-id { font-family: monospace; flex: 1; font-size: 25rpx; color: #3a4a63; }
.huser-cnt { font-size: 23rpx; color: #d8482a; }
.huser-btn { margin: 0; padding: 6rpx 20rpx; background: #fff3ee; color: #d8482a; font-size: 23rpx; border-radius: 999rpx; line-height: 1.9; }

/* 月度对比行 */
.month-comp { margin-top: 18rpx; border-top: 1rpx dashed #e7ebf3; padding-top: 16rpx; }
.mc-row { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; font-size: 25rpx; color: #4a5b76; }
.mc-row.alt { color: #8a94a8; margin-top: 8rpx; }
.mc-age { font-size: 23rpx; color: #98a2b5; width: 64rpx; flex-shrink: 0; }
.mc-num { flex: 1; }
.mc-rate { font-weight: 700; color: #3aa08a; }
.mc-row.alt .mc-rate { color: #7a8698; font-weight: 400; }
.mc-tip { margin-top: 10rpx; font-size: 23rpx; }
.mc-tip .up { color: #e25c4a; font-weight: 700; }
.mc-tip .down { color: #3aa08a; font-weight: 700; }

/* 危机快报：今日新增 + 最新一条 */
.crisis-flash { display: flex; align-items: center; gap: 20rpx; margin-top: 16rpx; padding: 16rpx 0;
  border-top: 1rpx dashed #e6ebf5; }
.cf-left { display: flex; align-items: baseline; gap: 8rpx; flex-shrink: 0; }
.cf-num { font-size: 44rpx; font-weight: 700; color: #e74c3c; line-height: 1; }
.cf-label { font-size: 22rpx; color: #98a2b5; }
.cf-line { flex: 1; display: flex; align-items: center; gap: 12rpx; min-width: 0; }
.cf-text { flex: 1; font-size: 24rpx; color: #5b6b85; line-height: 1.6; overflow: hidden;
  text-overflow: ellipsis; white-space: nowrap; }
.cf-tag { flex-shrink: 0; font-size: 20rpx; padding: 4rpx 12rpx; border-radius: 8rpx; color: #fff; }
.cf-tag.high { background: #e74c3c; }
.cf-tag.mid { background: #f39c12; }
.cf-tag.low { background: #95a5a6; }

/* 用户反馈流 */
.feed-row { padding: 12rpx 0; border-bottom: 1rpx dashed #eef1f6; }
.feed-row:last-child { border-bottom: none; }
.feed-comment { font-size: 25rpx; color: #33425b; line-height: 1.6; }
.feed-time { font-size: 21rpx; color: #a2abbe; margin-top: 4rpx; }

.hday-bar.rate { background: #e9f0ff; }
.hday-fill.rate { background: linear-gradient(90deg, #9db9f0, #4a7be0); }

.feed-tag { display: inline-block; font-size: 20rpx; color: #4c8a5c; background: #e8f4ec;
  border-radius: 6rpx; padding: 2rpx 8rpx; margin-right: 8rpx; }

.huser-last { color: #b08b4d; font-size: 20rpx; margin-left: 6rpx; }

.copy-hl { font-size: 22rpx; color: #6d8fd4; margin-left: 12rpx; }

.h-bar-row { display: flex; align-items: flex-end; height: 220rpx; gap: 6rpx; margin-top: 8rpx; overflow: hidden; }
.h-hour { flex: 1; display: flex; flex-direction: column; align-items: center; height: 100%; }
.h-hour-bar { flex: 1; width: 100%; display: flex; align-items: flex-end; }
.h-hour-fill { width: 60%; background: #c05b4d; border-radius: 4rpx 4rpx 0 0; min-height: 4rpx; }
.h-hour-n { font-size: 18rpx; color: #9aa2ad; margin-top: 6rpx; }
