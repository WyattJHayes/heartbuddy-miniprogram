<view class="container">
  <block wx:if="{{loading}}"><view class="text-muted center">加载中…</view></block>

  <block wx:elif="{{noRight}}">
    <view class="card center">
      <view class="big">🔒</view>
      <view class="sub">暂无访问权限</view>
      <view class="text-muted">请在云函数 opsSummary 的 ADMIN_OPENIDS 里填入你的 openid。</view>
    </view>
  </block>

  <block wx:elif="{{admin}}">
    <!-- 顶部指标 -->
    <view class="kpis">
      <view class="kpi"><text class="v">{{d.totalUsers}}</text><text class="t">累计用户</text></view>
      <view class="kpi"><text class="v">{{d.totalChats}}</text><text class="t">倾诉次数</text></view>
      <view class="kpi"><text class="v">{{d.activeUsers7d}}</text><text class="t">7日活跃</text></view>
      <view class="kpi"><text class="v warn">{{d.totalCrisis}}</text><text class="t">危机总数</text></view>
    </view>

    <!-- 危机预警待处理（高亮） -->
    <view class="card alert-card">
      <view class="alert-main">
        <view class="alert-l">
          <view class="alert-num">{{d.openHigh}}</view>
          <view class="alert-caption">未处理高危</view>
        </view>
        <view class="alert-r">
          <view class="alert-title">⚠️ 危机预警待跟进</view>
          <view class="alert-desc">
            {{d.openCrisis}} 条未处理危机记录（含中低危）。请在控制台查询 crisisAlerts 并尽快人工跟进高危项。
          </view>
        </view>
      </view>
    </view>

    <!-- 本周危机分级 -->
    <view class="card">
      <view class="section-title">最近 7 天危机分级（共 {{d.weekCrisis}} 条）</view>
      <view class="level">
        <view class="lv lv-high"><text class="lv-num">{{d.byLevel.high}}</text><text class="lv-label">高危</text></view>
        <view class="lv lv-mid"><text class="lv-num">{{d.byLevel.mid}}</text><text class="lv-label">中危</text></view>
        <view class="lv lv-low"><text class="lv-num">{{d.byLevel.low}}</text><text class="lv-label">低危</text></view>
      </view>
      <view class="rate-line">
        <text class="rate-v">本周处理率 {{weekRate}}%</text>
        <text class="text-muted rate-d">处理 {{d.weekHandled}} / 出现 {{d.weekCrisis}} · 累计已处理 {{d.handledCrisis}} · 未处理 {{d.openCrisis}}（高 {{d.openHigh}}）</text>
      </view>
      <!-- 危机快报：今日新增 + 最新一条摘要（进入看板即可见） -->
      <view class="crisis-flash" wx:if="{{d.todayCrisis !== undefined}}">
        <view class="cf-left">
          <view class="cf-num">{{d.todayCrisis}}</view>
          <view class="cf-label">今日新增危机</view>
        </view>
        <view class="cf-line" wx:if="{{d.latestCrisis}}">
          <view class="cf-text">🕘 {{d.latestCrisis.time}} · {{d.latestCrisis.keywords}}</view>
          <view class="cf-tag {{d.latestCrisis.level}}">{{d.latestCrisis.level === 'high' ? '高危' : (d.latestCrisis.level === 'mid' ? '中危' : '低危')}}</view>
        </view>
        <view class="cf-line" wx:else>
          <view class="cf-text">今日暂无新的危机记录 🌿</view>
        </view>
      </view>
      <!-- 月对比：本月 vs 上月（预警数 + 处理率） -->
      <view class="month-comp" wx:if="{{monthStat && lastStat}}">
        <view class="mc-row">
          <text class="mc-age">本月</text>
          <text class="mc-num">预警 {{monthStat.crisis}} · 已处理 {{monthStat.handled}}</text>
          <text class="mc-rate">处理率 {{monthStat.rate}}%</text>
        </view>
        <view class="mc-row alt">
          <text class="mc-age">上月</text>
          <text class="mc-num">预警 {{lastStat.crisis}} · 已处理 {{lastStat.handled}}</text>
          <text class="mc-rate">处理率 {{lastStat.rate}}%</text>
        </view>
        <view class="text-muted mc-tip">月度对比：<text class="{{monthStat.crisis > lastStat.crisis ? 'up' : (monthStat.crisis < lastStat.crisis ? 'down' : '')}}">{{monthStat.crisis > lastStat.crisis ? '预警数较上月上升' : (monthStat.crisis < lastStat.crisis ? '预警数较上月下降' : '预警数与上月持平')}}</text></view>
      </view>
      <button class="btn-ghost trend-copy" bindtap="copyCrisisCsv">复制危机统计 CSV</button>
    </view>

    <!-- 近 14 日情绪均值趋势 -->
    <view class="card">
      <view class="section-title">近 14 日情绪均值趋势</view>
      <emotion-chart points="{{trendPoints}}" maxY="{{5}}" minY="{{1}}" color="#5b8def" unit="均值"></emotion-chart>
      <view class="text-muted trend-note">近 14 日全部倾诉记录的情绪分值取平均（无记录日为断开）。</view>
      <button class="btn-ghost trend-copy" bindtap="copyTrend">复制 14 日均值 JSON</button>
    </view>

    <block wx:if="{{d.moodTrend7 && d.moodTrend7.length}}">
      <view class="card">
        <view class="section-title">7 日情绪均值快照<text class="plan-sub">云端聚合</text></view>
        <view class="tm-item" wx:for="{{d.moodTrend7}}" wx:key="day">
          <text class="tm-day">{{item.day}}</text>
          <view class="tm-bar"><view class="tm-fill" style="width: {{item.avg / 5 * 100}}%"></view></view>
          <text class="tm-val">{{item.avg}}</text>
        </view>
        <view class="text-muted trend-note">数据取自云函数 opsSummary 的 moodTrend7（近 7 天，非空日均值）。</view>
      </view>
    </block>

    <block wx:if="{{d.crisisBySource && d.crisisBySource.length}}">
      <view class="card">
        <view class="section-title">危机来源分布<text class="plan-sub">近 7 天</text></view>
        <view class="src-row" wx:for="{{d.crisisBySource}}" wx:key="source">
          <text class="src-name">{{item.source === 'chat' ? '对话诊断' : item.source}}</text>
          <view class="src-bar"><view class="src-fill" style="width: {{item.count / d.weekCrisis * 100}}%"></view></view>
          <text class="src-num">{{item.count}} 条</text>
        </view>
      </view>
    </block>

    <!-- 高危预警大屏：分日趋势 + 高危用户回访 -->
    <block wx:if="{{d.highTrend7 && d.highTrend7.length}}">
      <view class="card">
        <view class="section-title">🚨 高危危机·近 7 天趋势</view>
        <view class="hday" wx:for="{{d.highTrend7}}" wx:key="index">
          <text class="hday-label">{{item.day}}</text>
          <view class="hday-bar"><view class="hday-fill" style="width: {{item.count / 5 * 100}}%"></view></view>
          <text class="hday-num">{{item.count}}</text>
        </view>
        <view class="text-muted trend-note">近 7 天高危级危机记录分日计数（柱宽按 /5 缩放）。</view>
      </view>

      <!-- 近 7 日高危处理率：当日已处理占比（无预警=空） -->
      <view class="card" wx:if="{{d.highRate7 && d.highRate7.length}}">
        <view class="section-title">🛡️ 高危危机·近 7 日处理率</view>
        <view class="hday" wx:for="{{d.highRate7}}" wx:key="index">
          <text class="hday-label">{{item.day}}</text>
          <view class="hday-bar rate">
            <view class="hday-fill rate" style="width: {{item.rate !== null ? item.rate : 0}}%"></view>
          </view>
          <text class="hday-num">{{item.rate !== null ? item.rate + '%' : '—'}}</text>
        </view>
        <view class="text-muted trend-note">处理率 = 当日已处理高危预警数 ÷ 当日预警数；无预警的日子显示 —。</view>
      </view>
    </block>

    <block wx:if="{{d.highUserList && d.highUserList.length}}">
      <view class="card">
        <view class="section-title">高危用户（近 7 天）<text class="plan-sub">top {{d.highUserList.length}}</text>
          <text class="copy-hl" bindtap="copyHighList" role="button" aria-label="复制高危脱敏清单">📋 复制清单</text></view>
        <view class="huser" wx:for="{{d.highUserList}}" wx:key="openid">
          <text class="huser-id">{{item.short}}</text>
          <text class="huser-cnt">{{item.count}} 次高危<text wx:if="{{item.lastAt}}" class="huser-last">{{item.lastAt}}</text></text>
          <button class="huser-btn" data-full="{{item.openid}}" bindtap="scheduleFollow">安排 24h 回访</button>
        </view>
        <view class="text-muted trend-note">回访到期后，用户下次开口时 AI 会自然地关心一次（旁白内部机制不明说）。</view>
      </view>
    </block>

    <!-- 用户反馈流：最近 5 条（数据 → 运营闭环） -->
    <view class="card" wx:if="{{d.recentFeeds && d.recentFeeds.length}}">
      <view class="section-title">用户反馈 <text class="plan-sub">最近 {{d.recentFeeds.length}} 条</text>
        <text class="copy-hl" bindtap="handleAllFeed" role="button" aria-label="全部标记为已回应">全部标为已回应</text></view>
      <view class="feed-row" wx:for="{{d.recentFeeds}}" wx:key="id" data-full="{{item.full}}" data-time="{{item.time}}" bindtap="openFeed" role="button" aria-label="查看该条反馈完整内容">
        <view class="feed-comment">
          <text wx:if="{{item.status === 'replied'}}" class="feed-tag">已回应</text>{{item.comment}}
        </view>
        <view class="feed-time">{{item.time}} · 点开看全文</view>
        <button wx:if="{{item.status !== 'replied'}}" class="handle-btn" data-id="{{item.id}}" catchtap="handleFeed" loading="{{handlingFeed === item.id}}">标记已回应</button>
        <text wx:else class="ctag">✓</text>
      </view>
      <view class="text-muted trend-note">用户从「我的」页提交的反馈；回应后该条会带「已回应」标记。</view>
    </view>

    <!-- 最近危机记录 -->
    <view class="card">
      <view class="section-title">最近危机记录</view>
      <view wx:if="{{!d.recentCrisis.length}}" class="text-muted">暂无记录</view>
      <view class="crow" wx:for="{{d.recentCrisis}}" wx:key="index">
        <text class="badge b-{{item.level}}">{{item.level}}</text>
        <view class="cmain">
          <view class="ckeys">{{item.keywords || '—'}}</view>
          <view class="ctime">{{item.time}} · <text class="cstatus {{item.status === 'handled' ? 's-ok' : 's-wait'}}">{{item.status === 'handled' ? '已处理' : '待处理'}}</text></view>
        </view>
        <button wx:if="{{item.status !== 'handled'}}" class="handle-btn" data-id="{{item.id}}" bindtap="handleCrisis" loading="{{handling === item.id}}">一键处理</button>
        <text wx:else class="ctag">✓</text>
      </view>
    </view>

    <view class="card">
      <view class="section-title">测评</view>
      <view class="text-muted">累计完成 {{d.totalAssessment}} 人次考前焦虑自评。</view>
    </view>

    <button class="btn-ghost full" bindtap="refresh">刷新</button>
  </block>
</view>