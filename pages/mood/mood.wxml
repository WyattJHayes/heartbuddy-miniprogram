<view class="container">
  <!-- 今日还未记录：轻提醒一行，可关，记录后自动消失 -->
  <view class="today-tip" wx:if="{{todayTip}}" role="note" aria-label="今日还未记录心情">
    <text class="tt-text">今天还没记下此刻的心情 🌤 点上面的心情格子，10 秒就好。</text>
    <text class="tt-close" role="button" aria-label="今天先不提醒" bindtap="dismissTodayTip">✕</text>
  </view>

  <!-- 连续空白提醒（≥3 天未记录，温柔语气） -->
  <view class="empty-tip" wx:if="{{emptyTip}}" role="note" aria-label="一段时间没记录的提醒">{{emptyTip}}</view>

  <!-- 晚间温柔提醒（21 点后一次性） -->
  <view class="night-greet" wx:if="{{nightGreet}}" role="note" aria-label="晚间提醒">{{nightGreet}}</view>

  <!-- 本月情绪转换：最常出现的 A→B 变化 -->
  <view class="night-greet" wx:if="{{weekFull}}" role="note" aria-label="本周全勤庆祝">{{weekFull}}</view>
  <view class="shift-card" wx:if="{{intDist}}" role="note" aria-label="近30天强度分布">🌡 {{intDist}}</view>
  <view class="shift-card" wx:if="{{moodShift}}" role="note" aria-label="本月情绪转换洞察">{{moodShift}}</view>

  <!-- 小结日记本：所有写过的小结，随时翻回去看 -->
  <view class="notebook" wx:if="{{noteList.length}}">
    <view class="nb-head" bindtap="toggleNoteBook" role="button" aria-label="展开或收起小结日记本">
      <text class="nb-title">📖 小结日记本 · {{noteList.length}} 篇{{noteFilter === 'week' ? '（近 7 天）' : noteFilter === 'month' ? '（本月）' : ''}}</text>
      <text class="nb-arrow {{noteBookOpen ? 'up' : ''}}">▾</text>
    </view>
    <view class="nb-filters" wx:if="{{noteBookOpen}}">
      <text class="nb-f {{noteFilter === 'week' ? 'on' : ''}}" data-f="week" bindtap="setNoteFilter" role="button" aria-label="只看近7天小结">近 7 天</text>
      <text class="nb-f {{noteFilter === 'month' ? 'on' : ''}}" data-f="month" bindtap="setNoteFilter" role="button" aria-label="只看本月小结">本月</text>
      <text class="nb-f {{noteFilter === 'all' ? 'on' : ''}}" data-f="all" bindtap="setNoteFilter" role="button" aria-label="看全部小结">全部</text>
    </view>
    <view class="nb-list" wx:if="{{noteBookOpen}}">
      <view class="nb-item" wx:for="{{noteList}}" wx:key="date">
        <view class="nb-date">{{item.date}}
          <text class="nb-copy" bindtap="copyNoteItem" data-t="{{item.text}}" role="button" aria-label="复制这篇小结">复制</text>
        </view>
        <view class="nb-text">{{item.text}}</view>
      </view>
      <view class="nb-empty-note" wx:if="{{!noteList.length}}">还没有写过小结</view>
    </view>
  </view>

  <!-- 21 点后的收尾提示 + 昨天的小结回看 -->
  <view class="daynote-banner" wx:if="{{dayNoteBanner}}" role="note" aria-label="给今天收个尾" bindtap="openDayNote">
    <text class="dn-t">🌙 快 21 点了 —— 今天辛苦了。要不要给今天收个尾？</text>
    <text class="dn-go">写小结 ›</text>
  </view>
  <view class="daynote-card" wx:if="{{todayNote}}">
    <view class="dn-title">📝 今日小结<text class="dn-sub">写于 21 点后</text></view>
    <view class="dn-text">{{todayNote}}</view>
  </view>
  <view class="daynote-card yest" wx:if="{{yesterdayNote && !todayNote}}">
    <view class="dn-title">🌅 昨天的你<text class="dn-copy" bindtap="copyYesterdayNote" role="button" aria-label="复制昨天写的小结">复制</text></view>
    <view class="dn-text">{{yesterdayNote}}</view>
  </view>

  <!-- 自评入口 -->
  <view class="card assess-entry" role="button" aria-label="进入考前焦虑自评" bindtap="goAssessment">
    <view class="ae-emoji">📋</view>
    <view class="ae-main">
      <view class="ae-title">考前焦虑自评</view>
      <view class="ae-desc">7 个问题 · 约 2 分钟 · 结果仅供参考</view>
    </view>
    <view class="ae-arrow">›</view>
  </view>

  <!-- 一键快速记录 -->
  <view class="card quick-card">
    <view class="section-title">此刻心情？<text class="quick-sub">一键记下，曲线实时更新</text></view>
    <!-- 快速记录强度：1-5，默认 3（让曲线与周报平均强度更真实） -->
    <view class="qint-row" role="radiogroup" aria-label="此刻情绪强度">
      <text class="qint-label">强度</text>
      <view class="qint-chip {{quickInt === n ? 'on' : ''}}" wx:for="{{[1,2,3,4,5]}}" wx:for-item="n" wx:key="*this"
            data-v="{{n}}" bindtap="setQuickInt" role="radio" aria-checked="{{quickInt === n}}" aria-label="强度 {{n}}">{{n}}</view>
    </view>
    <view class="quick-row">
      <button
        class="quick-btn {{quicking === item.key ? 'on' : ''}}"
        wx:for="{{quickList}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="tapQuick"
        loading="{{quicking === item.key}}"
        disabled="{{quicking !== ''}}"
        aria-label="{{item.label}}心情记录按钮"
      >
        <text class="quick-emoji">{{item.emoji}}</text>
        <text class="quick-label">{{item.label}}</text>
      </button>
    </view>
    <!-- 触发来源快选：记录心情时顺便点一下「因为什么」（多选，入库） -->
    <view class="trig-row" wx:if="{{trigChips.length}}">
      <text class="trig-cap">因为什么？</text>
      <view
        class="trig-chip {{trig.indexOf(item) >= 0 ? 'on' : ''}}"
        wx:for="{{trigChips}}" wx:key="*this"
        data-t="{{item}}" bindtap="toggleTrig"
        role="button" aria-label="选择触发来源{{item}}">{{item}}</view>
    </view>
    <view class="quick-word" wx:if="{{quickWord}}" role="note" aria-label="记录后的暖心回应">✨ {{quickWord}}</view>
  <!-- 情绪急救包：记录负性情绪后，马上能做的 3 件小事 -->
  <view class="aid-pack" wx:if="{{aidPack}}" role="note" aria-label="情绪急救包">
    <view class="ap-head">
      <text class="ap-title">{{aidPack.icon}} 情绪急救包 · 现在就能做</text>
      <text class="ap-close" bindtap="closeAidPack" role="button" aria-label="收起急救包">✕</text>
    </view>
    <view class="ap-item" wx:for="{{aidPack.list}}" wx:key="*this">· {{item}}</view>
    <view class="ap-actions">
      <view class="ap-btn" bindtap="goBreatheNow" role="button" aria-label="去做呼吸练习">🧘 做 60 秒呼吸</view>
      <view class="ap-btn ghost" bindtap="goStationNow" role="button" aria-label="去情绪充电站">🔋 去充电站</view>
    </view>
  </view>
  </view>

  <!-- 每日心情提醒 -->
  <view class="card remind-card">
    <view class="remind-row">
      <view class="remind-info">
        <view class="section-title">每日心情提醒</view>
        <view class="text-muted remind-sub">到点打开小程序时，轻轻提醒一句「今天心情如何」。</view>
      </view>
      <switch checked="{{remindOn}}" bindchange="toggleRemind" color="#5b8def" aria-label="开关每日心情提醒" />
    </view>
    <view class="remind-time" wx:if="{{remindOn}}">
      <text class="remind-label">提醒时间</text>
      <picker mode="time" value="{{remindTime}}" bindchange="onRemindTime" aria-label="选择每日提醒时间">
        <view class="remind-pick">{{remindTime}}</view>
      </picker>
    </view>
  </view>

  <!-- 今日三件小事：为自己做的小事，当天内勾 3 件 -->
  <view class="card small-card">
    <view class="section-title">今日为我自己做 3 件小事<text class="section-sub">写下来，再勾掉它</text></view>
    <view class="sm-row" wx:for="{{smalls}}" wx:key="i">
      <view class="sm-check {{item.done ? 'on' : ''}}" data-i="{{index}}" bindtap="onSmallDone" role="checkbox" aria-checked="{{item.done}}" aria-label="今天第{{index + 1}}件小事已完成">{{item.done ? '✓' : ''}}</view>
      <input class="sm-input {{item.done ? 'done' : ''}}" value="{{item.text}}" data-i="{{index}}" bindinput="onSmallInput" placeholder="例：晚饭后散步 10 分钟" maxlength="40" />
      <text class="sm-at" wx:if="{{item.done && item.at}}">{{item.at}}</text>
    </view>
    <view class="sm-scenes">
      <view class="sm-scene {{smallScene === 'study' ? 'on' : ''}}" data-s="study" bindtap="setSmallScene" role="button" aria-label="学习恢复灵感">📚 学习恢复</view>
      <view class="sm-scene {{smallScene === 'body' ? 'on' : ''}}" data-s="body" bindtap="setSmallScene" role="button" aria-label="身体照顾灵感">🫁 身体照顾</view>
      <view class="sm-scene {{smallScene === 'social' ? 'on' : ''}}" data-s="social" bindtap="setSmallScene" role="button" aria-label="与人连接灵感">🤝 与人连接</view>
      <view class="sm-scene {{smallScene === 'me' ? 'on' : ''}}" data-s="me" bindtap="setSmallScene" role="button" aria-label="独处时光灵感">🛁 独处时光</view>
    </view>
    <view class="sm-idea" bindtap="fillSmallIdea" role="button" aria-label="随机填入一件小事灵感">💡 没想法？给我一件{{smallScene === 'study' ? '学习恢复' : smallScene === 'social' ? '与人连接' : smallScene === 'me' ? '独处' : '身体照顾'}}灵感</view>
    <view class="text-muted sm-hint">每天一换，做满 3 件会有小惊喜 ✨</view>
    <view class="small-yay" wx:if="{{smallCelebrate}}" role="note" aria-label="三件小事都完成">🌟 今天你照顾了自己 3 次，做得好，记得谢谢自己。<text wx:if="{{smallStreak >= 2}}">已连续 {{smallStreak}} 天全完成 🔥</text></view>
  </view>

  <!-- 情绪健康指数：近 7 天均值 → 0-100，规则解读 -->
  <view class="card health-card" wx:if="{{healthIdx}}">
    <view class="section-title">情绪健康指数<text class="section-sub">近 7 天</text>
      <text class="health-help" bindtap="showHealthHelp" role="button" aria-label="查看健康指数含义">❓</text></view>
    <view class="health-row">
      <view class="health-num">{{healthIdx.score}}</view>
      <view class="health-meta">
        <view class="health-tag">
          <text class="health-emoji">{{healthIdx.emoji}}</text>
          <text class="health-label">{{healthIdx.label}}</text>
          <text class="health-delta" wx:if="{{healthIdx.deltaText}}">{{healthIdx.deltaText}}</text>
          <text class="health-week" wx:if="{{healthIdx.weekDelta}}">{{healthIdx.weekDelta}}</text>
        </view>
        <view class="health-note">{{healthIdx.note}}</view>
      </view>
    </view>
    <view class="health-bar" aria-hidden="true">
      <view class="health-bar-fill" style="width:{{healthIdx.score}}%"></view>
    </view>
    <view class="health-foot">
      <text class="hf-chip" wx:if="{{monthDays}}">📅 本月已记录 {{monthDays}} 天</text>
      <text class="hf-chip" wx:if="{{streak.n >= 3}}">🔥 已连续打卡 {{streak.n}} 天</text>
    </view>
    <view class="cliff-tip" wx:if="{{cliffTip}}" role="note" aria-label="情绪比昨天明显下滑的提醒">⚠️ {{cliffTip}}
      <text class="cliff-btn" bindtap="goChatFromCliff" role="button" aria-label="去找人聊一聊">去聊聊 ›</text>
    </view>
    <!-- 近 14 天情绪色带：一眼看清这段时间的起起伏伏，点某天看小结 -->
    <view class="band-wrap" wx:if="{{band.length}}">
      <view class="band-title">近 {{bandDays}} 天情绪色带<text class="band-best" wx:if="{{bestStreak >= 3}}">🏆 最长连记 {{bestStreak}} 天</text><text class="band-switch" bindtap="toggleBandDays" role="button" aria-label="切换色带显示天数">⇄ {{bandDays === 14 ? '30' : '14'}} 天</text><text class="band-tip">点某天看小结 / 写一句</text>
        <text class="band-write-btn" bindtap="writeNoteToday" role="button" aria-label="给今天补写一句心情日记">✍️ 写一句</text>
      </view>
      <view class="band-legend" role="note" aria-label="色带图例">
        <text class="bl-item" wx:for="{{bandLegend}}" wx:key="k">{{item.e}} {{item.l}}</text>
      </view>
      <view class="band-row">
        <view class="band-cell {{item.has ? '' : 'empty'}} {{item.d === today ? 'today' : ''}}" wx:for="{{band}}" wx:key="d"
              data-k="{{item.k}}" data-d="{{item.d}}" bindtap="tapBand" bindlongpress="longpressBand"
              role="button" aria-label="{{item.d}}{{item.has ? '，当日情绪 ' + item.e + '，点看小结' : '，无记录'}}">
          <text class="band-e">{{item.e}}</text>
          <text class="band-d">{{item.d}}</text>
        </view>
      </view>
    </view>

    <!-- 最像此刻的一天：近 30 天里与今天心情最像的那天回看 -->
    <view class="card like-card" wx:if="{{likeToday}}" role="note" aria-label="最像此刻的一天">
      <view class="section-title">🪞 最像此刻的一天</view>
      <view class="like-line">
        <text class="like-emoji">{{likeToday.emoji}}</text>
        <text class="like-main">{{likeToday.label}} · {{likeToday.date}}</text>
      </view>
      <view class="like-desc" wx:if="{{likeToday.note}}">那天你写下：{{likeToday.note}}</view>
      <view class="like-desc">如果那天能走过来，今天也可以慢慢来。</view>
    </view>
  </view>

  <!-- 时光信：写给 7 天后的自己 -->
  <view class="card letter-card">
    <view class="section-title">✉️ 写给 7 天后的自己</view>
    <block wx:if="{{!letter}}">
      <textarea class="letter-area" placeholder="对未来的自己说点什么？…" value="{{letterText}}" bindinput="onLetterInput" maxlength="240" />
      <button class="btn-primary letter-send" bindtap="sendLetter">寄出这封信</button>
    </block>
    <block wx:elif="{{!letterReady}}">
      <view class="letter-due">这封信已在路上，还有 <text class="letter-num">{{7 - letterDue}}</text> 天可以打开。</view>
      <button class="btn-ghost letter-ghost" bindtap="openLetter" disabled>还不能拆开哦</button>
    </block>
    <block wx:else>
      <view class="letter-due">✨ 7 天到了，来自 7 天前的你有一封信。</view>
      <button class="letter-primary" bindtap="openLetter">拆开看看</button>
    </block>
    <view class="box-chip" wx:if="{{boxCount > 0}}" bindtap="openBox" role="button" aria-label="查看已拆开的时光信">
      💌 我的信匣 · 已拆开 {{boxCount}} 封（可回看旧信）
    </view>
  </view>

  <!-- 想法小剧场：把最响的念头存 7 天，回看时看它远没（认知解离练习） -->
  <view class="card thought-card">
    <view class="section-title">✍️ 想法小剧场<text class="plan-sub">把心里最响的念头先「放一放」</text></view>
    <block wx:if="{{!thought}}">
      <textarea class="thought-area" placeholder="此刻心里最响的念头是？比如：我肯定又搞砸了…" value="{{thoughtText}}" bindinput="onThoughtInput" maxlength="80" />
      <button class="btn-primary thought-save" bindtap="saveThought">存下它 · 7 天后回来看看</button>
    </block>
    <block wx:elif="{{!thoughtReady}}">
      <view class="thought-due">已存下。还有 <text class="thought-num">{{7 - thoughtDue}}</text> 天就能回看 —— 到时看看它还是不是那么大。</view>
      <view class="thought-soon" wx:if="{{thoughtDue === 6}}" role="note" aria-label="明天即可回看提醒">🌤 明天就能打开看了——今晚好好睡，念头交给时间。</view>
    </block>
    <block wx:else>
      <view class="thought-due">⏰ 7 天到了 —— 那个念头还在吗？</view>
      <button class="letter-primary" bindtap="thoughtRecall">回看它</button>
    </block>
  </view>

  <!-- 今日陪伴计划（评测页生成的 3 天计划在此打卡） -->
  <view wx:if="{{plan}}" class="card plan-card">
    <view class="section-title">今日陪伴任务<text class="plan-sub">{{plan.label}}</text></view>
    <block wx:if="{{planIdx >= 0 && planIdx < plan.days.length}}">
      <view class="plan-t-day">DAY {{planIdx + 1}} · {{plan.days[planIdx].title}}</view>
      <view class="plan-t-desc">{{plan.days[planIdx].desc}}</view>
      <button class="plan-check {{plan.done[planIdx] ? 'ok' : ''}}" bindtap="togglePlanDay">{{plan.done[planIdx] ? '已完成 ✓' : '标记，今日完成'}}</button>
    </block>
    <view wx:elif="{{planAllDone}}" class="plan-t-desc">✨ 3 天任务全部完成，为你骄傲。可回测评页重新定制。</view>
    <view wx:else class="plan-t-desc">陪伴计划尚未到开始日，先照顾好自己。</view>
  </view>

  <block wx:if="{{!loaded}}">
    <view class="text-muted center">加载中…</view>
  </block>

  <block wx:elif="{{empty}}">
    <view class="card center">
      <view class="big">🌱</view>
      <view class="sub">还没有情绪记录</view>
      <view class="text-muted">去「陪伴」页和心语说说话，这里就会长出你的情绪地图。</view>
    </view>
  </block>

  <block wx:else>
    <!-- 打卡激励 -->
    <view wx:if="{{streak.n}}" class="card streak-card">
      <text class="streak-emoji">🔥</text>
      <view class="streak-main">
        <view class="streak-title">已连续记录 {{streak.n}} 天</view>
        <view class="streak-desc">{{streak.today ? '坚持此刻的觉察，就是对自己的照顾' : '今天还没记录，来一条就能续上'}}</view>
      </view>
      <text class="streak-tag">{{streak.today ? '今日已打卡' : '今日待打卡'}}</text>
      <view wx:if="{{!streak.today}}" class="streak-go" bindtap="goRecordToday" role="button" aria-label="去记录今天的心情">去记一条 →</view>
    </view>

    <!-- 情绪占比 -->
    <view class="card">
      <view class="section-title">最近的心情分布</view>
      <view class="stat" wx:for="{{statList}}" wx:key="label">
        <text class="stat-emoji">{{item.emoji}}</text>
        <text class="stat-label">{{item.label}}</text>
        <view class="bar-bg">
          <view class="bar" style="width:{{item.ratio}}%"></view>
        </view>
        <text class="stat-num">{{item.count}} 次</text>
      </view>
      <view class="stat-tip" wx:if="{{stateTip}}" role="note" aria-label="心情分布解读">{{stateTip}}</view>
      <button class="btn-ghost report" bindtap="goReport">查看本周情绪周报</button>
    </view>

    <!-- 7 日心情曲线 -->
    <view class="card">
      <view class="section-title">最近 7 天心情曲线</view>
      <view wx:if="{{insight}}" class="insight">💡 {{insight}}</view>
      <view wx:if="{{weekSum}}" class="week-sum">📅 {{weekSum}}
        <text class="ws-copy" bindtap="copyWeekSum" role="button" aria-label="复制本周小结">复制</text>
      </view>
      <emotion-chart id="moodChart" points="{{moodLine}}" maxY="{{5}}" minY="{{1}}" color="#5b8def" unit="分值" footer="{{chartFooter}}" today></emotion-chart>
      <view class="chart-actions">
        <button class="btn-ghost" bindtap="saveMoodSummary">保存小结图片</button>
        <view class="chart-legend">纵轴情绪分值 1–5（低→高愉悦），每天取该日最后一次倾诉记录</view>
      </view>
    </view>

    <!-- 心情日历：月视图签到 -->
  <view class="card">
    <view class="section-title cal-head">
      <view class="cal-nav" bindtap="calNav" data-d="-1">‹</view>
      <text>{{calTitle}}</text>
      <view class="cal-nav" bindtap="calNav" data-d="1">›</view>
      <view class="cal-go" wx:if="{{calNotMonth}}" bindtap="calNow">回本月</view>
    </view>
    <view class="cal-week">
      <view class="cal-wd" wx:for="{{calWeekday}}" wx:key="*this">{{item}}</view>
    </view>
    <view class="cal-grid">
      <view
        class="cal-cell {{item.inMonth ? '' : 'dim'}} {{item.isToday ? 'today' : ''}} {{item.count ? 'has' : ''}} {{item.weekend ? 'wknd' : ''}}"
        wx:for="{{calCells}}"
        wx:key="key"
        bindtap="onCalDay"
        bindlongpress="onCalLongPress"
        data-k="{{item.key}}"
        aria-label="{{item.inMonth ? item.num + '日' + (item.emoji || '无记录') + '，长按可管理' : ''}}"
      >
        <text class="cc-num">{{item.num}}</text>
        <text class="cc-emoji">{{item.count ? item.emoji : ''}}</text>
      </view>
    </view>
    <view class="cal-tip" wx:if="{{!calDay}}">点亮小表情的日期是记录过心情的日子，点一下看当日小结</view>
    <view class="cal-peak" wx:if="{{monthRun && !calDay}}" role="note" aria-label="当月最长连续记录">🏅 {{monthRun}}</view>
    <view class="cal-peak" wx:if="{{peakDay && !calDay}}" role="note" aria-label="当月记录最多的一天">📌 {{peakDay}}</view>
    <view class="cal-month-copy" bindtap="copyCalMonth" wx:if="{{!calDay && monthDays}}" role="button" aria-label="复制本月月报">📋 复制本月月报（{{monthDays}} 天有记录）</view>
    <view class="cal-day-info" wx:if="{{calDay}}">
      <view class="cal-day-title">📅 {{calDay.date}} · 共 {{calDay.total}} 条记录</view>
      <view class="cal-day-row" wx:for="{{calDay.list}}" wx:key="label">{{item.label}} × {{item.count}}</view>
      <view class="cal-close" bindtap="closeCalDay">收起</view>
    </view>
  </view>

  <!-- 本月情绪由来：触发来源排行 -->
  <view class="card" wx:if="{{trigMonth.length}}">
    <view class="section-title">本月情绪从哪里来<text class="plan-sub">触发来源 Top{{trigMonth.length}}</text></view>
    <view class="trig-row">
      <view class="trig-chip" wx:for="{{trigMonth}}" wx:key="k">{{item.k}} × {{item.c}}</view>
    </view>
    <view class="trig-tip">同一类场面反复出现？可能是个值得留意的小信号 🌱</view>
    <view class="trig-shift" wx:if="{{trigShift}}" role="note" aria-label="触发来源环比洞察">📉 {{trigShift}}</view>
    <view class="trig-shift" wx:if="{{dayPref}}" role="note" aria-label="记录时段偏好">🕰 {{dayPref}}</view>
  </view>

  <!-- 最近记录 -->
    <view class="card">
      <view class="section-title">最近记录</view>
      <view class="row" wx:for="{{recentList}}" wx:key="index" data-item="{{item}}" bindtap="openDetail" bindlongpress="openDetail" role="button" aria-label="查看 {{item.label}} 记录详情">
        <text class="row-emoji">{{item.emoji}}</text>
        <view class="row-main">
          <view class="row-label">{{item.label}}</view>
          <view class="row-time">{{item.time}}</view>
        </view>
      </view>
    </view>

    <!-- 演示模式（现场演示用，可一键清除） -->
    <view class="card demo-card">
      <view class="text-muted demo-note">现场演示用：一键写入 12 天示例心情，快速展示曲线/周报/周小结。</view>
      <view class="demo-row">
        <button class="demo-btn" bindtap="genDemo" loading="{{demoBusy}}">填充示例</button>
        <button class="demo-btn ghost" bindtap="clearDemo" loading="{{demoBusy}}">清除示例</button>
      </view>
    </view>
  </block>
</view>

<!-- 情绪日记详情弹层 -->
<view class="mask" wx:if="{{showDetail}}" bindtap="closeDetail">
  <view class="sheet" catchtap="noop">
    <view class="sheet-title">📖 情绪日记</view>
    <view class="di-emoji">{{detail.emoji}}</view>
    <view class="di-line"><text class="lbl">情绪</text><text class="val">{{detail.label}}</text></view>
    <view class="di-line"><text class="lbl">时间</text><text class="val">{{detail.fullTime}}</text></view>
    <view class="di-line"><text class="lbl">强度</text><text class="val">{{detail.intensity}} / 10</text></view>
    <view class="di-line"><text class="lbl">来源</text><text class="val">{{detail.trigger || '手动记录'}}</text></view>
    <button class="di-del" bindtap="deleteDetail" loading="{{deleting}}">删除这条记录</button>
    <button class="di-close" bindtap="closeDetail">关闭</button>
  </view>
</view>