.center { text-align: center; }
.big { font-size: 90rpx; margin: 24rpx 0; }

.assess-entry { display: flex; align-items: center; background: linear-gradient(135deg, #eaf1ff, #f7f9ff); }

.streak-card { display: flex; align-items: center; background: linear-gradient(135deg, #fff7ec, #fffdf7); border: 1rpx solid #ffe3b3; }
.streak-emoji { font-size: 64rpx; margin-right: 20rpx; }
.streak-main { flex: 1; }
.streak-title { font-size: 30rpx; font-weight: 700; color: #9a6a1f; }
.streak-desc { font-size: 24rpx; color: #b5882f; margin-top: 4rpx; }
.streak-tag { font-size: 22rpx; color: #fff; background: #ffb03a; border-radius: 999rpx; padding: 6rpx 18rpx; }
.ae-emoji { font-size: 56rpx; margin-right: 20rpx; }
.ae-main { flex: 1; }
.ae-title { font-size: 30rpx; font-weight: 600; }
.ae-desc { font-size: 24rpx; color: #9ca3af; margin-top: 4rpx; }
.ae-arrow { color: #c4c9d4; font-size: 40rpx; }

.stats-row { display: flex; }
.quick-card { margin-top: 0; }
.quick-sub { font-size: 22rpx; color: #9ca3af; font-weight: 400; margin-left: 10rpx; }
.quick-row { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 8rpx; }
.quick-btn { flex: 1 1 28%; min-width: 140rpx; display: flex; align-items: center; justify-content: center; flex-direction: row; background: #fff; border: 1rpx solid #e5e9f2; border-radius: 999rpx; font-size: 24rpx; color: #3e5ba3; padding: 12rpx 8rpx; margin: 0; }
.quick-btn::after { border: none; }
.quick-btn.on { background: #eef4ff; border-color: #5b8def; }
.quick-emoji { font-size: 34rpx; line-height: 1; }
.quick-label { font-size: 22rpx; color: #7a8698; margin-top: 4rpx; }
.quick-btn.on .quick-label { color: #4568c8; }
.stat-emoji { width: 56rpx; }
.stat { display: flex; align-items: center; margin-bottom: 20rpx; }
.stat-label { width: 100rpx; font-size: 26rpx; }
.bar-bg { flex: 1; height: 22rpx; background: #f0f2f7; border-radius: 20rpx; margin: 0 16rpx; overflow: hidden; }
.bar { height: 100%; background: linear-gradient(90deg, #8fb4ff, #5b8def); border-radius: 20rpx; }
.stat-num { width: 90rpx; text-align: right; font-size: 24rpx; color: #9ca3af; }

.report { width: 100%; margin-top: 8rpx; }

.chart-legend { font-size: 22rpx; color: #9ca3af; margin-top: 8rpx; line-height: 1.6; }
.chart-actions { display: flex; align-items: center; justify-content: space-between; margin-top: 14rpx; }
.chart-actions .btn-ghost { margin: 0; }
.insight { font-size: 26rpx; color: #4568c8; background: #eef4ff; border-radius: 999rpx; padding: 14rpx 24rpx; margin: 8rpx 0 16rpx; line-height: 1.6; }

.row { display: flex; align-items: center; padding: 16rpx 0; border-bottom: 1rpx solid #f3f4f6; }
.row:last-child { border-bottom: none; }
.row-emoji { font-size: 44rpx; margin-right: 20rpx; }
.row-main { flex: 1; }
.row-label { font-size: 28rpx; }
.row-trigger { color: #5b8def; }
.row-time { font-size: 22rpx; color: #9ca3af; margin-top: 4rpx; }