.center { text-align: center; }
.big { font-size: 90rpx; margin: 24rpx 0; }

.assess-entry { display: flex; align-items: center; background: linear-gradient(135deg, #eaf1ff, #f7f9ff); }

.streak-card { display: flex; align-items: center; background: linear-gradient(135deg, #fff7ec, #fffdf7); border: 1rpx solid #ffe3b3; }
.streak-emoji { font-size: 64rpx; margin-right: 20rpx; }
.streak-main { flex: 1; }
.streak-title { font-size: 30rpx; font-weight: 700; color: #9a6a1f; }
.streak-desc { font-size: 24rpx; color: #b5882f; margin-top: 4rpx; }
.streak-tag { font-size: 22rpx; color: #fff; background: #ffb03a; border-radius: 999rpx; padding: 6rpx 18rpx; }
.ae-emoji { font-size: 56rpx; margin-right: 20rpx; }
.ae-main { flex: 1; }
.ae-title { font-size: 30rpx; font-weight: 600; }
.ae-desc { font-size: 24rpx; color: #9ca3af; margin-top: 4rpx; }
.ae-arrow { color: #c4c9d4; font-size: 40rpx; }

.stats-row { display: flex; }
.quick-card { margin-top: 0; }
.quick-sub { font-size: 22rpx; color: #9ca3af; font-weight: 400; margin-left: 10rpx; }
.quick-row { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 8rpx; }
.quick-btn { flex: 1 1 28%; min-width: 140rpx; display: flex; align-items: center; justify-content: center; flex-direction: row; background: #fff; border: 1rpx solid #e5e9f2; border-radius: 999rpx; font-size: 24rpx; color: #3e5ba3; padding: 12rpx 8rpx; margin: 0; }
.quick-btn::after { border: none; }
.quick-btn.on { background: #eef4ff; border-color: #5b8def; }
.quick-emoji { font-size: 34rpx; line-height: 1; }
.quick-label { font-size: 22rpx; color: #7a8698; margin-top: 4rpx; }
.quick-btn.on .quick-label { color: #4568c8; }
.stat-emoji { width: 56rpx; }
.stat { display: flex; align-items: center; margin-bottom: 20rpx; }
.stat-label { width: 100rpx; font-size: 26rpx; }
.bar-bg { flex: 1; height: 22rpx; background: #f0f2f7; border-radius: 20rpx; margin: 0 16rpx; overflow: hidden; }
.bar { height: 100%; background: linear-gradient(90deg, #8fb4ff, #5b8def); border-radius: 20rpx; }
.stat-num { width: 90rpx; text-align: right; font-size: 24rpx; color: #9ca3af; }

.report { width: 100%; margin-top: 8rpx; }

.chart-legend { font-size: 22rpx; color: #9ca3af; margin-top: 8rpx; line-height: 1.6; }
.chart-actions { display: flex; align-items: center; justify-content: space-between; margin-top: 14rpx; }
.chart-actions .btn-ghost { margin: 0; }
.insight { font-size: 26rpx; color: #4568c8; background: #eef4ff; border-radius: 999rpx; padding: 14rpx 24rpx; margin: 8rpx 0 16rpx; line-height: 1.6; }

.row { display: flex; align-items: center; padding: 16rpx 0; border-bottom: 1rpx solid #f3f4f6; }
.row:last-child { border-bottom: none; }
.row-emoji { font-size: 44rpx; margin-right: 20rpx; }
.row-main { flex: 1; }
.row-label { font-size: 28rpx; }
.row-trigger { color: #5b8def; }
.row-time { font-size: 22rpx; color: #9ca3af; margin-top: 4rpx; }
/* 3 天陪伴计划 */
.plan-sub { font-size: 22rpx; color: #9ca3af; font-weight: 400; margin-left: 10rpx; }
.plan-t-day { font-size: 30rpx; font-weight: 600; color: #3e5ba3; margin: 8rpx 0 6rpx; }
.plan-t-desc { font-size: 25rpx; color: #7a8698; line-height: 1.7; margin-bottom: 12rpx; }
.plan-check { background: #eef4ff; color: #3e5ba3; font-size: 26rpx; border-radius: 999rpx; padding: 12rpx 32rpx; margin: 0; line-height: 1.6; }
.plan-check.ok { background: #e2f6ee; color: #2f8f72; }
.plan-check::after { border: none; }
.plan-row { display: flex; align-items: flex-start; gap: 16rpx; padding: 16rpx 0; border-bottom: 1rpx solid #f3f4f6; }
.plan-row:last-child { border-bottom: none; }
.pd-num { width: 44rpx; height: 44rpx; border-radius: 12rpx; background: #eef4ff; color: #3e5ba3; font-size: 24rpx; font-weight: 600; text-align: center; line-height: 44rpx; flex-shrink: 0; }
.pd-main { flex: 1; }
.pd-title { font-size: 27rpx; font-weight: 600; }
.pd-desc { font-size: 23rpx; color: #8a95a7; line-height: 1.6; margin-top: 4rpx; }
.pd-check { width: 44rpx; height: 44rpx; border-radius: 50%; border: 2rpx solid #c9d3e8; color: transparent; font-size: 30rpx; line-height: 44rpx; text-align: center; flex-shrink: 0; margin-top: 2rpx; }
.pd-check.done { border-color: #2f8f72; background: #e2f6ee; color: #2f8f72; }
.pd-check.on { border-color: #5b8def; background: #eef4ff; color: #5b8def; }
.pd-check.do { color: #b7c1d0; }
.plan-note { margin-top: 8rpx; font-size: 23rpx; }

.week-sum { font-size: 25rpx; color: #5b6b85; background: #f7f9fd; border: 1rpx solid #edf0f6; border-radius: 16rpx; padding: 16rpx 20rpx; margin: 0 0 16rpx; line-height: 1.7; }

/* 时光信：写给 7 天后的自己 */
.letter-card { border: 2rpx dashed #cfe0ff; background: #fbfdff; }
.letter-area { width: 100%; min-height: 140rpx; background: #f7f9fd; border: 1rpx solid #e4eaf3; border-radius: 16rpx; padding: 20rpx; font-size: 26rpx; line-height: 1.6; box-sizing: border-box; }
.letter-send { margin-top: 16rpx; background: #5b8def; color: #fff; border-radius: 44rpx; font-size: 27rpx; font-weight: 600; }
.letter-due { font-size: 26rpx; color: #5b6b85; line-height: 1.7; margin-bottom: 16rpx; }
.letter-num { color: #5b8def; font-weight: 700; font-size: 30rpx; }
.letter-primary { background: #5b8def; color: #fff; border-radius: 44rpx; font-size: 27rpx; font-weight: 600; }
.letter-ghost { margin-top: 8rpx; background: #eef1f6; color: #8a94a8; border-radius: 44rpx; font-size: 26rpx; }

/* 每日心情提醒 */
.remind-card { border-top: 2rpx solid #e8eefc; }
.remind-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; }
.remind-info { flex: 1; }
.remind-sub { font-size: 23rpx; margin-top: 8rpx; line-height: 1.6; }
.remind-time { display: flex; align-items: center; gap: 20rpx; margin-top: 16rpx; padding-top: 16rpx; border-top: 1rpx dashed #e4eaf3; }
.remind-label { font-size: 25rpx; color: #5b6b85; }
.remind-pick { font-size: 26rpx; font-weight: 600; color: #3f6fd8; background: #f0f6ff; padding: 10rpx 28rpx; border-radius: 999rpx; }

/* 演示模式 */
.demo-card { border: 1rpx dashed #c9d6ec; background: #fbfcfe; }
.demo-note { font-size: 22rpx; line-height: 1.6; }
.demo-row { display: flex; gap: 20rpx; margin-top: 16rpx; }
.demo-btn { flex: 1; background: #eef4ff; color: #3f6fd8; font-size: 25rpx; border-radius: 44rpx; font-weight: 600; }
.demo-btn.ghost { background: #f1f3f7; color: #6b7b95; }

/* 情绪日记详情弹层 */
.mask { position: fixed; inset: 0; background: rgba(20,28,43,.5); z-index: 99; display: flex; align-items: flex-end; }
.sheet { width: 100%; background: #fff; border-radius: 32rpx 32rpx 0 0; padding: 40rpx 36rpx 60rpx; box-sizing: border-box; }
.sheet-title { text-align: center; font-size: 30rpx; font-weight: 700; color: #2d3b55; }
.di-emoji { text-align: center; font-size: 72rpx; margin: 20rpx 0 10rpx; }
.di-line { display: flex; justify-content: space-between; padding: 14rpx 8rpx; font-size: 27rpx; border-bottom: 1rpx dashed #eef1f6; }
.di-line .lbl { color: #8a97ad; }
.di-line .val { color: #2d3b55; font-weight: 600; }
.di-del { margin-top: 30rpx; background: #fbefec; color: #c25a3a; border-radius: 999rpx; font-size: 27rpx; }
.di-close { margin-top: 16rpx; background: #f2f4f8; color: #5b6b85; border-radius: 999rpx; font-size: 27rpx; }

/* 心情日历 */
.cal-head { display: flex; align-items: center; gap: 24rpx; }
.cal-nav { width: 44rpx; height: 44rpx; line-height: 40rpx; text-align: center; color: #5b8def; font-size: 32rpx; background: #eef4ff; border-radius: 12rpx; }
.cal-week { display: flex; margin: 14rpx 0 8rpx; }
.cal-wd { flex: 1; text-align: center; font-size: 21rpx; color: #8a97ad; }
.cal-grid { display: flex; flex-wrap: wrap; }
.cal-cell { width: 14.28%; height: 84rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; box-sizing: border-box; border-radius: 12rpx; font-size: 24rpx; color: #3a4a63; }
.cal-cell.dim { color: #c5ccd8; }
.cal-cell.today { background: #eef4ff; }
.cal-cell.has { background: #fff3f7; }
.cc-emoji { font-size: 26rpx; line-height: 1.2; }
.cc-num { font-size: 22rpx; color: #8a97ad; }
.cal-tip { margin-top: 14rpx; font-size: 22rpx; color: #8a97ad; }
.cal-day-info { margin-top: 16rpx; background: #f6f9ff; border-radius: 16rpx; padding: 20rpx 24rpx; }
.cal-day-title { font-size: 26rpx; color: #2a3b55; font-weight: 600; }
.cal-day-row { margin-top: 12rpx; font-size: 24rpx; color: #4a5b76; }
.cal-close { margin-top: 14rpx; font-size: 23rpx; color: #5b8def; }

/* 情绪健康指数 */
.health-card { background: linear-gradient(150deg, #eef6ff, #fff6ec); }
.section-sub { font-size: 21rpx; color: #93a0b8; font-weight: 400; margin-left: 10rpx; }
.health-row { display: flex; align-items: center; gap: 26rpx; margin-top: 8rpx; }
.health-num { font-size: 88rpx; font-weight: 800; color: #3f6fe0; line-height: 1.1; min-width: 150rpx; text-align: left; }
.health-meta { flex: 1; }
.health-tag { display: flex; align-items: center; }
.health-emoji { font-size: 34rpx; margin-right: 8rpx; }
.health-label { font-size: 30rpx; font-weight: 600; color: #2a3b55; }
.health-delta { font-size: 24rpx; color: #5b8def; margin-left: 12rpx; font-weight: 600; }
.health-note { margin-top: 8rpx; font-size: 24rpx; color: #5a6b85; line-height: 1.6; }
.health-bar { height: 14rpx; border-radius: 999rpx; background: #e6ebf4; margin-top: 16rpx; overflow: hidden; }
.health-bar-fill { height: 100%; border-radius: 999rpx; background: linear-gradient(90deg, #8fb1f2, #5d8def); transition: width .4s; }

/* 今日三件小事 */
.small-card { margin-top: 8rpx; }
.sm-row { display: flex; align-items: center; gap: 18rpx; margin-top: 16rpx; }
.sm-check { width: 44rpx; height: 44rpx; border-radius: 50%; border: 2rpx solid #c9d4e6; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 28rpx; flex-shrink: 0; }
.sm-check.on { background: #5b8def; border-color: #5b8def; }
.sm-input { flex: 1; font-size: 26rpx; color: #3a4a63; }
.sm-input.done { color: #b0b8c8; text-decoration: line-through; }
.sm-hint { margin-top: 18rpx; font-size: 23rpx; }

/* 近 14 天情绪色带 */
.band-wrap { margin-top: 26rpx; border-top: 1rpx solid #f0f2f7; padding-top: 20rpx; }
.band-title { font-size: 23rpx; color: #98a2b5; margin-bottom: 12rpx; }
.band-row { display: flex; justify-content: space-between; }
.band-cell { display: flex; flex-direction: column; align-items: center; width: 44rpx; }
.band-e { font-size: 30rpx; height: 40rpx; line-height: 40rpx; }
.band-cell.empty .band-e { color: #d7dde8; font-size: 26rpx; }
.band-d { font-size: 18rpx; color: #b3bdcf; margin-top: 4rpx; transform: scale(0.86); white-space: nowrap; }
.band-tip { margin-left: 12rpx; color: #b3bdcf; transform: scale(0.92); display: inline-block; }

/* 情绪日记入口：写一句按钮 */
.band-write-btn { float: right; font-size: 23rpx; color: #5b8def; font-weight: 600; }

/* 今日未记录轻提醒 */
.today-tip { display: flex; align-items: center; gap: 12rpx; padding: 12rpx 16rpx;
  background: #fff8ef; border: 1rpx solid #f4e3c2; border-radius: 12rpx; margin-bottom: 14rpx; }
.tt-text { flex: 1; font-size: 24rpx; color: #966a2b; line-height: 1.6; }
.tt-close { flex-shrink: 0; font-size: 26rpx; color: #c9a25f; padding: 4rpx 8rpx; }

.health-help { font-size: 22rpx; color: #9aa3b5; margin-left: 10rpx; }

.small-yay { margin-top: 12rpx; font-size: 24rpx; color: #8a6d3b; background: #fdf3dd;
  border-radius: 10rpx; padding: 12rpx 14rpx; line-height: 1.6; }

.streak-go { flex-shrink: 0; font-size: 24rpx; color: #3f6fe0; margin-left: 16rpx;
  background: #eef3ff; border-radius: 999rpx; padding: 8rpx 18rpx; }

.quick-word { margin-top: 14rpx; font-size: 24rpx; color: #7b6b52; background: #faf3e6;
  border-radius: 10rpx; padding: 10rpx 16rpx; line-height: 1.6; }
.stat-tip { margin-top: 10rpx; font-size: 24rpx; color: #8b7a60; line-height: 1.6; background:#faf7f0; border-radius:10rpx; padding:10rpx 16rpx; }
