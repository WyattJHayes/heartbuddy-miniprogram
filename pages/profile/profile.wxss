.user { display: flex; align-items: center; }
.avatar { width: 96rpx; height: 96rpx; font-size: 60rpx; background: #eef3ff; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
.user-info { margin-left: 24rpx; }
.user-name { font-size: 34rpx; font-weight: 600; }

.stats { display: flex; }
.stat { flex: 1; display: flex; flex-direction: column; align-items: center; padding: 12rpx 0; }
.stat-num { font-size: 44rpx; font-weight: 700; color: #5b8def; }
.stat-label { font-size: 24rpx; color: #9ca3af; margin-top: 4rpx; }

.ta { width: 100%; height: 160rpx; background: #f7f8fb; border-radius: 16rpx; padding: 20rpx; box-sizing: border-box; font-size: 28rpx; margin-bottom: 16rpx; }
.full { width: 100%; }

.row { display: flex; justify-content: space-between; align-items: center; padding: 24rpx 0; border-bottom: 1rpx solid #f3f4f6; font-size: 28rpx; }
.row:last-child { border-bottom: none; }
.arrow { color: #c4c9d4; font-size: 36rpx; }
.row.danger { color: #e05c4e; }
.muted { color: #9ca3af; }
.stat-tip { margin-top: 12rpx; font-size: 22rpx; line-height: 1.6; }
/* 成就徽章 */
.badges { display: flex; flex-wrap: wrap; gap: 20rpx; margin-top: 8rpx; }
.badge { flex: 1 1 42%; min-width: 280rpx; display: flex; flex-direction: column; align-items: center; padding: 24rpx 16rpx; border-radius: 20rpx; background: #f4f6fa; border: 2rpx solid transparent; }
.badge.got { background: #f0f7ff; border-color: #bcd9ff; }
.badge.lock { opacity: 0.65; }
.b-emoji { font-size: 52rpx; line-height: 1; }
.b-title { font-size: 26rpx; font-weight: 600; color: #3a4a63; margin-top: 10rpx; }
.b-desc { font-size: 21rpx; color: #98a2b5; margin-top: 4rpx; text-align: center; }
.export-btn { margin-top: 18rpx; background: #eef4ff; color: #3f6fd8; border-radius: 44rpx; font-size: 26rpx; font-weight: 600; }

/* 徽章进度 + 数据足迹 */
.badge-progress { height: 12rpx; background: #eef1f6; border-radius: 999rpx; margin: 8rpx 0 18rpx; overflow: hidden; }
.badge-progress-fill { height: 100%; background: linear-gradient(90deg, #ffd48a, #ffb054); border-radius: 999rpx; }
.foot-stats { display: flex; margin: 6rpx 0 18rpx; }
.foot-item { flex: 1; text-align: center; }
.foot-num { display: block; font-size: 34rpx; font-weight: 700; color: #3a4a63; }
.foot-label { display: block; margin-top: 6rpx; font-size: 22rpx; color: #8a97ad; }
.foot-week { display: flex; gap: 12rpx; }
.fw-cell { flex: 1; height: 44rpx; border-radius: 12rpx; background: #f0f2f7; }
.fw-cell.on { background: linear-gradient(135deg, #9dc2ff, #5b8def); }

/* 我的珍藏 */
.fav-mask { position: fixed; inset: 0; background: rgba(20, 28, 46, .45); z-index: 99; display: flex; align-items: flex-end; }
.fav-sheet { width: 100%; background: #fff; border-radius: 28rpx 28rpx 0 0; padding: 26rpx 30rpx calc(34rpx + env(safe-area-inset-bottom)); max-height: 74vh; display: flex; flex-direction: column; }
.fav-head { display: flex; align-items: center; justify-content: space-between; }
.fav-title { font-size: 30rpx; font-weight: 700; color: #2a3b55; }
.fav-clear { font-size: 24rpx; color: #e8666b; }
.fav-list { flex: 1; overflow: hidden; margin-top: 18rpx; }
.fav-empty { text-align: center; color: #a5b0c2; font-size: 25rpx; padding: 40rpx 0; }
.fav-item { padding: 20rpx 0; border-bottom: 1rpx solid #f1f3f8; }
.fav-time { font-size: 21rpx; color: #a3aec4; }
.fav-text { margin-top: 8rpx; font-size: 27rpx; color: #3a4a63; line-height: 1.6; }
.fav-foot { margin-top: 18rpx; text-align: center; font-size: 27rpx; color: #5b8def; font-weight: 600; }

/* 数据足迹扩展行 */
.foot-extra { margin-top: 14rpx; font-size: 24rpx; color: #7a8698; }
.foot-hl { color: #3f6fe0; font-weight: 700; }

/* 日签问候 */
.daily-greet { display: flex; align-items: center; gap: 10rpx; padding: 14rpx 18rpx;
  background: #eef4ff; border-radius: 14rpx; margin-bottom: 14rpx; }
.dg-emoji { font-size: 30rpx; }
.dg-text { font-size: 25rpx; color: #4a5f8f; line-height: 1.5; }

.fav-ops { display: flex; gap: 24rpx; }

.practice-line { margin-top: 14rpx; font-size: 24rpx; color: #6d7a5a; line-height:1.7; }

.assess-line { margin-top: 14rpx; font-size: 26rpx; color: #3f6fe0; line-height:1.6;
  background: #eef3ff; border-radius: 10rpx; padding: 12rpx 16rpx; }

.dg-days { margin-left: 8rpx; color: #b98a4d; font-size: 24rpx; }

.miss-card { display:flex; align-items:center; gap:16rpx; margin:18rpx 0; background:#fdf3e3; border:1rpx solid #f0dfc0; border-radius:16rpx; padding:20rpx; }
.mc-emoji{font-size:40rpx;}
.mc-main{flex:1;}
.mc-title{font-size:28rpx;color:#7a5a2e;font-weight:600;}
.mc-sub{font-size:24rpx;color:#a08a5c;margin-top:4rpx;}
.mc-btn{color:#b06f2c;font-size:24rpx;}

.plan-progress { margin-top: 8rpx; }
.plan-btn { margin-top: 14rpx; display:inline-block; background:#5b8def; color:#fff; border-radius:999rpx; padding:8rpx 26rpx; font-size:24rpx; }


.share-btn { display:flex; align-items:center; justify-content:center; margin:16rpx 24rpx 0; background:linear-gradient(135deg,#ffe9d6,#fff3e3); color:#8f6b1f; border:1rpx solid #f4dfc6; border-radius:16rpx; padding:20rpx 0; font-size:26rpx; font-weight:600; }
.share-slot { position:absolute; left:-999px; top:0; width:300px; height:220px; pointer-events:none; }
