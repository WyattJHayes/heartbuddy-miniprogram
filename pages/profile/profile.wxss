.user { display: flex; align-items: center; }
.avatar { width: 96rpx; height: 96rpx; font-size: 60rpx; background: #eef3ff; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
.user-info { margin-left: 24rpx; }
.user-name { font-size: 34rpx; font-weight: 600; }

.stats { display: flex; }
.stat { flex: 1; display: flex; flex-direction: column; align-items: center; padding: 12rpx 0; }
.stat-num { font-size: 44rpx; font-weight: 700; color: #5b8def; }
.stat-label { font-size: 24rpx; color: #9ca3af; margin-top: 4rpx; }

.ta { width: 100%; height: 160rpx; background: #f7f8fb; border-radius: 16rpx; padding: 20rpx; box-sizing: border-box; font-size: 28rpx; margin-bottom: 16rpx; }
.full { width: 100%; }

.row { display: flex; justify-content: space-between; align-items: center; padding: 24rpx 0; border-bottom: 1rpx solid #f3f4f6; font-size: 28rpx; }
.row:last-child { border-bottom: none; }
.arrow { color: #c4c9d4; font-size: 36rpx; }
.muted { color: #9ca3af; }
.stat-tip { margin-top: 12rpx; font-size: 22rpx; line-height: 1.6; }