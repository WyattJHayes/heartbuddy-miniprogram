<view class="container">
  <!-- 日签问候（按时段轮换，轻仪式感） -->
  <view class="daily-greet" role="note" aria-label="今日问候">
    <text class="dg-emoji">{{greetEmoji}}</text>
    <text class="dg-text">{{greetText}}</text>
    <text class="dg-days" wx:if="{{accompanyDays}}" role="img" aria-label="累计陪伴天数"> · 已陪伴 {{accompanyDays}} 天</text>
  </view>
  <view class="accompany-milestone" wx:if="{{accompanyMilestoneText}}" role="note" aria-label="陪伴里程碑" bindtap="copyMilestone" data-t="{{accompanyMilestoneText}}">
    🏅 {{accompanyMilestoneText}}<text class="am-copy">复制</text>
  </view>

  <!-- 好久不见：>3 天没记记录，温柔接你回来 -->
  <view class="miss-card" wx:if="{{missDays >= 3}}" bindtap="goMoodBack" role="button" aria-label="好久没记录心情了，回心情页看看">
    <text class="mc-emoji">🍵</text>
    <view class="mc-main">
      <view class="mc-title">好久不见 · 已经 {{missDays}} 天没记心情了</view>
      <view class="mc-sub">不着急，回来看看现在的自己就好</view>
    </view>
    <text class="mc-btn">去记录 ›</text>
  </view>

  <!-- 用户信息 -->
  <view class="card share-btn-row">
    <view class="share-btn" bindtap="drawShareCard" role="button" aria-label="生成今日心情卡保存到相册">
      🖼️ 今日心情卡（保存·可分享）
    </view>
    <view class="share-btn alt" bindtap="drawBadgeWall" role="button" aria-label="生成我的徽章墙保存到相册">
      🏅 我的徽章墙（已点亮拾起·保存）
    </view>
  </view>

  <view class="share-slot"><canvas type="2d" id="shareCard"></canvas></view>
  <view class="share-slot"><canvas type="2d" id="badgeWall"></canvas></view>

  <view class="card user">
    <view class="avatar">🌱</view>
    <view class="user-info">
      <view class="user-name">心语伴的用户</view>
      <view class="text-muted">ID {{shortId || '—'}}</view>
    </view>
  </view>

  <!-- 考前倒计时：设一次考试日，考前陪你倒数 + 考前3天起深呼吸 -->
  <view class="card exam-card" wx:if="{{!examInfo}}">
    <picker mode="date" value="{{examToday}}" start="{{examToday}}" bindchange="examDateChange">
      <view class="exam-set">
        <text class="exam-emoji">📝</text>
        <view class="exam-main">
          <view class="exam-title">考前倒计时</view>
          <view class="exam-sub">填上最近一场考试的日子，心里有数</view>
        </view>
        <text class="exam-go">设置 ›</text>
      </view>
    </picker>
  </view>
  <view class="card exam-card exam-on" wx:if="{{examInfo}}" role="note" aria-label="考前倒计时：{{examInfo.name}}还有{{examInfo.days}}天">
    <view class="exam-hd">
      <text class="exam-emoji">{{examInfo.days >= 0 ? '📝' : '🎉'}}</text>
      <view class="exam-main">
        <view class="exam-title">{{examInfo.name}}<text class="exam-date"> · {{examInfo.dateStr}}</text></view>
        <view class="exam-body">{{examInfo.body}}</view>
      </view>
    </view>
    <view class="exam-ops">
      <view class="exam-btn" bindtap="examAction">{{examInfo.btn.text}}</view>
      <picker mode="date" value="{{examToday}}" start="{{examToday}}" bindchange="examDateChange">
        <view class="exam-btn ghost" wx:if="{{examInfo.days >= 0}}">换日期</view>
      </picker>
    </view>
  </view>

  <!-- 统计 -->
  <view class="card">
    <view class="section-title">我的数据</view>
    <view class="stats">
      <view class="stat" bindtap="goReport">
        <text class="stat-num">{{chatTotal}}</text>
        <text class="stat-label">累计倾诉</text>
      </view>
      <view class="stat" bindtap="goReport">
        <text class="stat-num">→</text>
        <text class="stat-label">查看周报</text>
      </view>
    </view>
    <view class="practice-line" wx:if="{{pBreath || pScan || pWrite}}" role="note" aria-label="本月练习统计">
      🌿 本月练习：<text wx:if="{{pBreath}}">呼吸 ×{{pBreath}}</text>
      <text wx:if="{{pScan}}"> · 身体扫描 ×{{pScan}}</text>
      <text wx:if="{{pWrite}}"> · 写给自己 ×{{pWrite}}</text>
    </view>
    <view class="assess-line" wx:if="{{lastAssess}}" bindtap="goAssess" role="button" aria-label="查看最近一次自评并可重测">
      📋 最近一次自评：{{lastAssess.label}}（总分 {{lastAssess.total}}）· {{lastAssessDate}} ›
    </view>
  </view>

  <!-- 陪伴计划进行中：今天第几天 · 今天任务 -->
  <view class="card" wx:if="{{planInfo}}">
    <view class="section-title">🧭 陪伴计划 <text class="plan-sub">第 {{planInfo.cur}}/{{planInfo.total}} 天{{planInfo.done ? ' · 已完成今天' : ''}}</text></view>
    <view class="plan-line">今天想陪你做：{{planInfo.title}}</view>
    <view class="badge-progress"><view class="badge-progress-fill" style="width: {{planInfo.cur / planInfo.total * 100}}%"></view></view>
    <view class="plan-btn" bindtap="goPlan" role="button" aria-label="去看看今天的小任务">{{planInfo.done ? '看看明天 ›' : '去做今天的小任务 ›'}}</view>
  </view>

  <!-- 成就徽章 -->
  <view class="card">
    <view class="section-title">成就徽章<text class="plan-sub">{{gotCount}}/{{badgeTotal}} 已点亮</text></view>
    <view class="badge-copy" bindtap="copyBadges" role="button" aria-label="复制已点亮徽章列表">📋 复制徽章列表</view>
    <view class="badge-progress"><view class="badge-progress-fill" style="width: {{badgeTotal ? gotCount / badgeTotal * 100 : 0}}%"></view></view>
    <view class="badge-pct" wx:if="{{badgeTotal}}" role="note" aria-label="徽章完成度">点亮率 {{gotCount}}/{{badgeTotal}}（{{badgePct}}%）</view>
    <view class="badge-next" wx:if="{{nextBadge}}" role="note" aria-label="下一枚徽章提示">
      🔒 下一枚：{{nextBadge.emoji}} {{nextBadge.title}} —— {{nextBadge.desc}}
    </view>
    <view class="badges">
      <view class="badge {{item.got ? 'got' : 'lock'}}" wx:for="{{badges}}" wx:key="key">
        <text class="b-emoji">{{item.got ? item.emoji : '🔒'}}</text>
        <text class="b-title">{{item.title}}<text class="b-date" wx:if="{{item.got && item.gotDate}}"> · {{item.gotDate}}</text></text>
        <text class="b-desc">{{item.desc}}</text>
      </view>
    </view>
  </view>

  <!-- 数据足迹 -->
  <view class="card">
    <view class="section-title">我的数据足迹</view>
    <view class="foot-stats">
      <view class="foot-item"><text class="foot-num">{{footprintSum}}</text><text class="foot-label">累计记录</text></view>
      <view class="foot-item"><text class="foot-num">{{streakDays}}</text><text class="foot-label">连续打卡(天)</text></view>
      <view class="foot-item"><text class="foot-num">{{firstDate}}</text><text class="foot-label">最早记录</text></view>
      <view class="foot-item"><text class="foot-num">{{breatheTotal + scanTotal}}</text><text class="foot-label">呼吸+扫描</text></view>
      <view class="foot-item"><text class="foot-num">{{noteTotal}}</text><text class="foot-label">晚间小结</text></view>
    </view>
    <view class="month-prog" wx:if="{{monthProg}}" role="note" aria-label="本月记录进度">
      <text class="mp-t">📅 本月已记录 {{monthProg.done}}/{{monthProg.passed}} 天</text>
      <view class="mp-bar"><view class="mp-fill" style="width: {{monthProg.pct}}%"></view></view>
    </view>
    <view class="edu-mini" bindtap="goEdu" role="button" aria-label="查看心理小课进度 {{eduDone}}/{{eduTotal}}">
      <text class="em-t">📚 心理小课 {{eduDone}}/{{eduTotal}}</text>
      <view class="em-bar"><view class="em-fill" style="width: {{eduTotal ? eduDone / eduTotal * 100 : 0}}%"></view></view>
      <text class="em-go">{{eduDone >= eduTotal ? '全部学完 🎉' : '继续学 ›'}}</text>
    </view>
    <view class="foot-week">
      <view class="fw-col" wx:for="{{mood7Days}}" wx:key="index">
        <view class="fw-cell mood {{item ? 'on' : ''}}" aria-label="{{wkLabels[index] === '今' ? '今天' : '星期' + wkLabels[index]}}{{item ? '已记录心情' : '未记录心情'}}"></view>
        <text class="fw-label">{{wkLabels[index]}}</text>
      </view>
      <view class="fw-col" wx:for="{{practice7Days}}" wx:key="index">
        <view class="fw-cell practice {{item ? 'on' : ''}}" aria-label="{{wkLabels[index] === '今' ? '今天' : '星期' + wkLabels[index]}}{{item ? '做过放松练习' : '未做练习'}}"></view>
        <text class="fw-label p">{{item ? '练习' : ''}}</text>
      </view>
    </view>
    <view class="fw-tip">上排：记录心情 · 下排：做过放松练习（呼吸/扫描）</view>
    <view class="year-stat" wx:if="{{yearStat}}" role="note" aria-label="年度统计">
      📅 {{yearStat.y}} 年，你已经记下了 <text class="ys-n">{{yearStat.n}}</text> 条心情、覆盖 <text class="ys-n">{{yearStat.days}}</text> 天
    </view>
    <view class="text-muted stat-tip">近 7 天：点亮的小格是你记录过心情的日子。</view>
    <view class="foot-extra" wx:if="{{monthAvgInt || topTrig}}">
      <text wx:if="{{monthAvgInt}}">本月平均强度 <text class="foot-hl">{{monthAvgInt}}</text>/5</text>
      <text wx:if="{{topTrig}}"> · 最常用入口 <text class="foot-hl">{{topTrig}}</text></text>
    </view>
  </view>

  <!-- 数据与隐私 -->
  <view class="card">
    <view class="section-title">数据与隐私</view>
    <view class="stats">
      <view class="stat"><text class="stat-num">{{assessTotal}}</text><text class="stat-label">自评次数</text></view>
      <view class="stat"><text class="stat-num">{{crisisTotal}}</text><text class="stat-label">危机提醒</text></view>
      <view class="stat"><text class="stat-num">{{chatTotal}}</text><text class="stat-label">情绪记录</text></view>
    </view>
    <view class="text-muted stat-tip">以上仅本地展示·对话正文不入库，详阅「隐私政策（全文）」。</view>
    <view class="row" bindtap="copyMySummary">
      <text>复制文字版「我的概览」</text><text class="arrow">›</text>
    </view>
    <view class="row" bindtap="clearLocalData">
      <text>清除本机记录<text class="muted">（云端心情与徽章保留）</text></text><text class="arrow">›</text>
    </view>
    <view class="row" bindtap="viewDataMap">
      <text>数据都放在哪 · 一看就懂</text><text class="arrow">›</text>
    </view>
    <button class="export-btn" bindtap="exportData">导出本人数据（JSON）</button>
  </view>

  <!-- 反馈 -->
  <view class="card">
    <view class="section-title">给心语伴留言</view>
    <textarea
      class="ta"
      placeholder="说说你的使用感受 / 想增加的陪伴功能…"
      value="{{feedback}}"
      bindinput="onFeedback"
      maxlength="200"
    />
    <button class="btn-primary full" bindtap="submitFeedback" loading="{{submitting}}">提交反馈</button>
  </view>

  <!-- 设置 -->
  <view class="card">
    <view class="row" bindtap="openFavs">
      <text>我的珍藏<text class="muted" wx:if="{{favCount}}">（{{favCount}} 条）</text></text><text class="arrow">›</text>
    </view>
    <view class="row" bindtap="openStickies">
      <text>📌 我的便签本<text class="muted" wx:if="{{stickies.length}}">（{{stickies.length}} 条）</text></text><text class="arrow">›</text>
    </view>
    <view class="row" bindtap="exportMyData">
      <text>📦 导出我的本地数据</text><text class="arrow">›</text>
    </view>
    <view class="row" bindtap="tellParents">
      <text>💌 说给爸妈听（生成一段成长小结）</text><text class="arrow">›</text>
    </view>
    <view class="row" bindtap="encourageFriend">
      <text>🍀 送给朋友的一句鼓励</text><text class="arrow">›</text>
    </view>
    <view class="row" bindtap="myPhrases">
      <text>🗣 我的常用语（点开看/写一条）</text><text class="arrow">›</text>
    </view>
    <view class="row" wx:if="{{stoodBadge}}" role="note" aria-label="撑过来的天数">
      <text>{{stoodBadge}}</text><text class="arrow">✓</text>
    </view>
    <view class="row" bindtap="showRole">
      <text>🪪 我的身份{{roleName ? ' · ' + roleName : ''}}（点去换）</text><text class="arrow">›</text>
    </view>
    <view class="row" wx:if="{{safeLine}}" bindtap="goHelperSafe">
      <text>🛟 安全包 · {{safeLine}}</text><text class="arrow">›</text>
    </view>
    <view class="row" bindtap="exportProfile">
      <text>📋 导出我的心情档案（复制成一段话）</text><text class="arrow">›</text>
    </view>
    <view class="row" bindtap="viewPrivacy">
      <text>隐私声明</text><text class="arrow">›</text>
    </view>
    <view class="row" bindtap="goPrivacy">
      <text>隐私政策（全文）</text><text class="arrow">›</text>
    </view>
    <view class="row" bindtap="resetPrivacy">
      <text>重新查看隐私指引</text><text class="arrow">›</text>
    </view>
    <view class="row" bindtap="goOps">
      <text>运营看板（演示）</text><text class="arrow">›</text>
    </view>
    <view class="row danger" bindtap="clearData">
      <text>清空我的记录（不可恢复）</text><text class="arrow">›</text>
    </view>
    <view class="row remind-row">
      <view class="remind-left">
        <text>每日轻声提醒<text class="muted" wx:if="{{remindOn}}"> · {{remindTime}}</text></text>
        <view class="remind-sub">到点提醒自己：深呼吸一次 / 记一笔心情</view>
      </view>
      <picker mode="time" value="{{remindTime}}" bindchange="remindTimeChange" wx:if="{{remindOn}}">
        <view class="remind-btn">改时间</view>
      </picker>
      <switch checked="{{remindOn}}" bindchange="remindSwitch" color="#5b8def" style="transform: scale(.8);" aria-label="每日轻声提醒开关"/>
    </view>
    <view class="row">
      <text>版本</text><text class="muted">v0.3.0（参赛 MVP）</text>
    </view>
  </view>

<!-- 我的珍藏弹层 -->
<view class="fav-mask" wx:if="{{showFavs}}" bindtap="closeFavs">
  <view class="fav-sheet" catchtap="noop">
    <view class="fav-head">
      <text class="fav-title">💛 我的珍藏</text>
      <view class="fav-ops">
        <text class="fav-clear" bindtap="copyAllFavs" role="button" aria-label="一键复制全部珍藏">复制全部</text>
        <text class="fav-clear" bindtap="clearFavs" role="button" aria-label="清空珍藏">清空</text>
      </view>
    </view>
    <scroll-view scroll-y class="fav-list" aria-label="我的珍藏列表">
      <view class="fav-empty" wx:if="{{!favs.length}}">长按聊天消息即可珍藏一句</view>
      <block wx:if="{{favs.length}}">
        <view class="fav-group-t" wx:if="{{favsToday.length}}">🌤 今天（{{favsToday.length}}）</view>
        <view class="fav-item" wx:for="{{favsToday}}" wx:key="time" bindlongpress="delFav" data-i="{{favs.indexOf(item)}}" aria-label="长按可删除这条珍藏">
          <view class="fav-time">{{item.role === 'user' ? '我' : '心语伴'}} · {{item.time}}</view>
          <view class="fav-text" bindtap="copyFav" data-text="{{item.text}}">{{item.text}}</view>
        </view>
        <view class="fav-group-t" wx:if="{{favsEarlier.length}}">🕘 更早（{{favsEarlier.length}}）</view>
        <view class="fav-item" wx:for="{{favsEarlier}}" wx:key="time" bindlongpress="delFav" data-i="{{favs.indexOf(item)}}" aria-label="长按可删除这条珍藏">
          <view class="fav-time">{{item.role === 'user' ? '我' : '心语伴'}} · {{item.time}}</view>
          <view class="fav-text" bindtap="copyFav" data-text="{{item.text}}">{{item.text}}</view>
        </view>
      </block>
    </scroll-view>
    <view class="fav-foot" bindtap="closeFavs">关闭</view>
  </view>

<!-- 我的便签本弹层 -->
  <view class="fav-mask" wx:if="{{stickiesOpen}}" bindtap="closeStickies" />
  <view class="fav-pop" wx:if="{{stickiesOpen}}">
    <view class="fav-head">
      <text class="fav-title">📌 我的便签本</text>
      <text class="fav-clear" bindtap="deleteLastSticky" wx:if="{{stickies.length}}" role="button" aria-label="删最近一条便签">删最近一条</text>
    </view>
    <scroll-view scroll-y class="fav-list" aria-label="便签列表">
      <view class="fav-empty" wx:if="{{!stickies.length}}">在聊天里点「📌 留下一句」就能存下一句话</view>
      <view class="fav-item" wx:for="{{stickies}}" wx:key="at" bindlongpress="copySticky" data-t="{{item.t}}" aria-label="点按复制这条便签">
        <view class="fav-time">{{item.when}}</view>
        <view class="fav-text">{{item.t}}</view>
      </view>
    </scroll-view>
    <view class="fav-foot" bindtap="closeStickies">关闭</view>
  </view>
</view>
</view>