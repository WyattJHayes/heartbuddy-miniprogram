<view class="container">
  <block wx:if="{{!loaded}}">
    <view class="text-muted center">生成中…</view>
  </block>

  <block wx:elif="{{empty}}">
    <view class="card center">
      <view class="big">📝</view>
      <view class="sub">本周还没有记录</view>
      <view class="text-muted">去和心语聊聊，下周这里会有一张属于你的心情卡片。</view>
      <button class="btn-primary go" bindtap="goChat">去聊聊</button>
    </view>
  </block>

  <block wx:else>
    <view class="card hero">
      <view class="section-title">本周情绪小报</view>
      <view class="hero-emoji">{{topEmoji}}</view>
      <view class="hero-label">主要情绪：{{topLabel}}</view>
      <view class="hero-stats">
        <view class="hero-item"><text class="num">{{chatCount}}</text><text class="unit">次倾诉</text></view>
        <view class="hero-item"><text class="num">{{dayCount}}</text><text class="unit">天有记录</text></view>
      </view>
      <!-- 本周情绪构成：一条彩带看全周（观察，不评判） -->
      <view class="mix-wrap" wx:if="{{mixBar.length > 1}}" role="img" aria-label="本周情绪构成彩带">
        <view class="mix-bar">
          <view class="mix-seg" wx:for="{{mixBar}}" wx:key="mood" style="width: {{item.w}}%; background: {{item.color}};"></view>
        </view>
        <view class="mix-legend">
          <view class="mix-item" wx:for="{{mixBar}}" wx:key="mood">
            <view class="mix-dot" style="background: {{item.color}};"></view>
            <text class="mix-name">{{item.emoji}} {{item.label}} {{item.pct}}%（{{item.n}} 次）</text>
          </view>
        </view>
        <view class="mix-read" role="note" aria-label="构成说明">{{mixRead}}</view>
      </view>
      <view class="hero-stats" wx:if="{{weekNotes}}" role="note" aria-label="本周晚间小结篇数" style="margin-top:10rpx;">
        <view class="hero-item"><text class="num">{{weekNotes}}</text><text class="unit">篇晚间小结</text></view>
      </view>
      <view wx:if="{{weekAvg}}" class="avg-line">
        <text class="avg-num">本周均值 {{weekAvg}}</text>
        <text wx:if="{{prevAvg}}" class="avg-cmp">上周 {{prevAvg}}</text>
        <text class="avg-delta {{deltaText[0] === '↘' ? 'down' : ''}}">{{deltaText}}</text>
        <text wx:if="{{weekInt}}" class="avg-cmp">· 平均强度 {{weekInt}}/5</text>
      </view>
    </view>

    <view class="card">
      <view class="section-title">给这周的你</view>
      <view class="advice">{{suggestion}}</view>
      <!-- 连续低日提醒（低日优先）与正向鼓励条（互斥，不同时出现） -->
      <view class="low-tip" wx:if="{{lowStreakTip}}" role="note" aria-label="连续低情绪提醒">
        {{lowStreakTip}}
        <view class="low-act" bindtap="goStation" role="button" aria-label="去充电站缓一缓">⚡ 去「充电站」缓一缓 →</view>
      </view>
      <view class="high-tip" wx:elif="{{highStreakTip}}" role="note" aria-label="连续好状态鼓励">{{highStreakTip}}</view>
      <!-- 本周「相对最好的一天」正向叙事 -->
      <view class="best-tip" wx:if="{{bestDayText}}" role="note" aria-label="本周最好一天肯定">{{bestDayText}}</view>
      <!-- 本周「练习足迹」：数一数自我照顾的次数 -->
      <view class="best-tip" wx:if="{{practiceText}}" role="note" aria-label="本周练习足迹">{{practiceText}}<text wx:if="{{weekSmallN}}"> · 三件小事做了 {{weekSmallN}} 件</text></view>
    </view>

    <!-- 一句话总结：拼词不加判断，开头先给一句安心的 -->
    <view class="card one-liner" wx:if="{{oneLiner}}" role="note" aria-label="本周一句话总结">
      <text class="ol-mark">🗒</text>
      <text class="ol-text">{{oneLiner}}</text>
    </view>

    <!-- 本周对自己说（可写进文字版周报） -->
    <view class="card mt">
      <view class="section-title">想对本周的自己说<text class="section-sub">会附在文字版周报末尾</text></view>
      <textarea class="note-input" value="{{weekNote}}" bindinput="onNoteInput" placeholder="例：这周考试很多，辛苦你撑住，周末去吃顿好的" maxlength="60" />
      <button class="btn-ghost small mt" bindtap="saveNote">保存备注</button>
    </view>

    <!-- 近 4 周记录节奏：每周条数小柱 + 一句趋势 -->
    <view class="card mt" wx:if="{{weekBars && weekBars.length}}">
      <view class="section-title">近 4 周记录节奏<text class="section-sub">看变化，不评判</text></view>
      <view class="week-row">
        <view class="week-col" wx:for="{{weekBars}}" wx:key="index">
          <view class="week-bar-bg"><view class="week-bar {{index === 3 ? 'cur' : ''}}" style="height:{{item.c ? item.c / 6 * 100 : 4}}%"></view></view>
          <text class="week-num">{{item.c}}</text>
          <text class="week-label">{{item.label}}</text>
        </view>
      </view>
      <view class="best-tip" wx:if="{{weekTrend}}" role="note" aria-label="近四周趋势一句话">{{weekTrend}}</view>
    </view>

    <!-- 今年以来小结：全年足迹一句话（年复一年，看见坚持） -->
    <view class="card mt" wx:if="{{yearInfo}}">
      <view class="section-title">🗓 {{yearInfo.label}} 心情小结<text class="section-sub">今年至今</text></view>
      <view class="month-line">你记录了 <text class="hl">{{yearInfo.total}}</text> 条心情，覆盖 <text class="hl">{{yearInfo.days}}</text> 天 · 出现最多的是「{{yearInfo.topEmoji}} {{yearInfo.topLabel}}」<text wx:if="{{yearInfo.bestRun}}"> · 最长连续 {{yearInfo.bestRun}} 天</text></view>
      <view class="year-copy" bindtap="copyYearText" role="button" aria-label="复制全年小结文字版">📋 复制全年小结（可发给老师/家长）</view>
    </view>

    <!-- 月度小结：本月构成 + 与上月对比 -->
    <view class="card mt" wx:if="{{monthInfo}}">
      <view class="section-title">📅 {{monthInfo.label}} 心情小结</view>
      <view class="month-line">这个月你记录了 <text class="hl">{{monthInfo.total}}</text> 条心情，覆盖 <text class="hl">{{monthInfo.days}}</text> 天<text wx:if="{{monthInfo.bestRun}}"> · {{monthInfo.bestRun}}</text></view>
      <view class="month-count" wx:if="{{monthInfo.monthCountText}}" role="note" aria-label="本月与上月条数对比">📊 {{monthInfo.monthCountText}}</view>
      <view class="month-hl" wx:if="{{monthInfo.highlight}}" role="note" aria-label="本月情绪亮点">✨ {{monthInfo.highlight}}</view>
      <view class="month-copy" bindtap="copyMonthText" role="button" aria-label="复制月度小结文字版">📋 复制月度小结（可发给老师/家长）</view>
      <view class="mtop" wx:for="{{monthInfo.top3}}" wx:key="index">
        <text class="mtop-e">{{item.emoji}}</text>
        <text class="mtop-l">{{item.label}}</text>
        <view class="mtop-bar-bg"><view class="mtop-bar" style="width:{{item.count / monthInfo.total * 100}}%"></view></view>
        <text class="mtop-n">{{item.count}} 次</text>
      </view>
      <!-- 情绪词云：情绪标签为主、触发来源为辅，字号按频次加权 -->
      <view class="cloud-wrap" wx:if="{{monthInfo.cloud.length}}">
        <view class="cloud-title">☁️ 情绪词云 · 本月</view>
        <view class="cloud-row" aria-label="本月情绪词云">
          <text class="cloud-w" style="font-size:{{item.size}}rpx; color:{{item.color}}" wx:for="{{monthInfo.cloud}}" wx:key="text">{{item.emoji ? item.emoji + ' ' : ''}}{{item.text}}<text class="cloud-n">{{item.count}}</text></text>
        </view>
      </view>
      <view class="text-muted mdelta" wx:if="{{monthInfo.delta}}">{{monthInfo.delta}}<text wx:if="{{monthInfo.avgInt}}"> · 平均强度 {{monthInfo.avgInt}}</text></view>
    </view>

    <button class="btn-ghost full mt" bindtap="openShare">生成分享卡片</button>
    <button class="btn-ghost full mt" bindtap="copyWeekText">复制文字版周报</button>
    <button class="btn-primary full mt" bindtap="goChat">继续和心语聊聊</button>

    <view wx:if="{{history.length}}" class="card mt">
      <view class="section-title">往期周报<text class="text-muted">（点击可复制该周）</text></view>
      <view class="hrow" wx:for="{{history}}" wx:key="date" data-i="{{index}}" bindtap="copyHistoryWeek" role="button" aria-label="复制往期周报{{item.date}}">
        <text class="hdate">{{item.date}}</text>
        <text class="htext">{{item.topLabel}} {{item.topEmoji}} · 倾诉 {{item.chatCount}} 次 · {{item.dayCount}} 天</text>
      </view>
    </view>

    <!-- 给下个月的我一句：现在写给未来的自己，下月 1 号回看（本地） -->
    <view class="card mt future-card" role="note" aria-label="给下个月的我一句">
      <block wx:if="{{futureDue}}">
        <view class="future-title">☁️ 上个月，你写给自己的话</view>
        <view class="future-seen">「{{futureDue}}」</view>
        <view class="future-you">下个月的你，也辛苦了。这句话已经收到 🌥</view>
        <view class="future-clear" bindtap="clearFutureDue" role="button" aria-label="收下这段话">收下</view>
      </block>
      <block wx:elif="{{futureSaved}}">
        <view class="future-title">☁️ 你已写给下个月的自己</view>
        <view class="future-seen">「{{futureSaved}}」</view>
        <view class="future-you">下月 1 号会自动回看——先交给时间。</view>
      </block>
      <block wx:else>
        <view class="future-title">☁️ 给下个月的我一句</view>
        <view class="future-desc">现在的心情，下个月会不一样。写一句留给未来的自己，下月 1 号带着温柔回看。</view>
        <textarea class="future-ta" value="{{futureNote}}" bindinput="futureInput" placeholder="例：下个月的你，辛苦了，记得吃饭和睡觉" maxlength="60" auto-height />
        <view class="future-save" bindtap="saveFuture" role="button" aria-label="写给下个月的自己">写下，约好下月回看</view>
      </block>
    </view>
  </block>
</view>

<!-- 分享卡浮层 -->
<view class="mask" wx:if="{{showShare}}" bindtap="closeShare">
  <view class="sheet" catchtap="noop">
    <view class="sheet-tip text-muted">长按图片可预览/保存，也可以直接分享给好友</view>
    <view class="tpls">
      <view class="tpl {{tpl === 'light' ? 'on' : ''}}" bindtap="setTpl" data-tpl="light">清新浅色</view>
      <view class="tpl {{tpl === 'dark' ? 'on' : ''}}" bindtap="setTpl" data-tpl="dark">深夜深色</view>
    </view>
    <share-card id="shareCard" card="{{cardData}}" tpl="{{tpl}}"></share-card>
    <view class="rowbtns">
      <button class="btn-primary" bindtap="saveCard">保存到相册</button>
      <button class="btn-ghost" open-type="share">转发给好友</button>
      <button class="btn-ghost" bindtap="closeShare">关闭</button>
    </view>
  </view>
</view>