.center { text-align: center; }
.big { font-size: 90rpx; margin: 24rpx 0; }
.go { width: 60%; margin-top: 24rpx; }

.hero { text-align: center; }
.hero-emoji { font-size: 120rpx; margin: 20rpx 0; }
.hero-label { font-size: 32rpx; font-weight: 600; }
.hero-stats { display: flex; justify-content: center; gap: 80rpx; margin-top: 24rpx; }
.hero-item { display: flex; flex-direction: column; align-items: center; }
.num { font-size: 44rpx; font-weight: 700; color: #5b8def; }
.unit { font-size: 24rpx; color: #9ca3af; }

.advice { font-size: 28rpx; line-height: 1.7; }
.full { width: 100%; }
.mt { margin-top: 20rpx; }
.hrow { display: flex; align-items: center; padding: 16rpx 0; border-bottom: 1rpx solid #f3f4f6; }
.hrow:last-child { border-bottom: none; }
.hdate { font-size: 24rpx; color: #9ca3af; width: 180rpx; flex-shrink: 0; }
.htext { font-size: 26rpx; }

/* 分享卡浮层 */
.mask { position: fixed; inset: 0; background: rgba(20, 26, 40, 0.55); display: flex; align-items: center; justify-content: center; z-index: 999; }
.sheet { width: 640rpx; background: #fff; border-radius: 32rpx; padding: 32rpx; display: flex; flex-direction: column; align-items: center; }
.sheet-tip { font-size: 24rpx; margin-bottom: 20rpx; text-align: center; }
.tpls { display: flex; gap: 16rpx; margin-bottom: 20rpx; }
.tpl { padding: 12rpx 28rpx; border-radius: 999rpx; font-size: 25rpx; color: #7b88a2; background: #f0f3fa; border: 2rpx solid transparent; }
.tpl.on { color: #5b8def; border-color: #5b8def; background: #eef4ff; font-weight: 600; }
.rowbtns { width: 100%; display: flex; flex-direction: column; gap: 16rpx; margin-top: 24rpx; }
/* 本周 vs 上周均值 */
.avg-line { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 14rpx; margin-top: 18rpx; padding-top: 16rpx; border-top: 1rpx dashed #e4eaf3; }
.avg-num { font-size: 26rpx; font-weight: 700; color: #3f6fd8; }
.avg-cmp { font-size: 23rpx; color: #8a97ad; }
.avg-delta { font-size: 23rpx; color: #28a06b; font-weight: 600; }
.avg-delta.down { color: #c25b3a; }

/* 月度小结 */
.month-line { font-size: 25rpx; color: #5a6a85; margin-top: 8rpx; line-height: 1.6; }
.hl { color: #3f6fe0; font-weight: 700; }
.mtop { display: flex; align-items: center; gap: 14rpx; margin-top: 16rpx; }
.mtop-e { font-size: 40rpx; width: 40rpx; }
.mtop-l { font-size: 24rpx; color: #3a4a63; width: 72rpx; }
.mtop-bar-bg { flex: 1; height: 14rpx; background: #f0f2f7; border-radius: 999rpx; overflow: hidden; }
.mtop-bar { height: 100%; background: linear-gradient(90deg, #6c9ef5, #5b8def); border-radius: 999rpx; }
.mtop-n { font-size: 24rpx; color: #9aa5b8; width: 84rpx; text-align: right; }
.mdelta { margin-top: 16rpx; font-size: 25rpx; }

/* 本周对自己说 */
.note-input { width: 100%; box-sizing: border-box; min-height: 120rpx; font-size: 26rpx; color: #3a4a63; background: #f6f8fc; border-radius: 12rpx; padding: 18rpx; margin-top: 16rpx; }
.btn-ghost.small { font-size: 24rpx; padding: 10rpx 0; margin-top: 16rpx; }

/* 情绪词云 */
.cloud-wrap { margin-top: 22rpx; border-top: 1rpx dashed #e7ebf3; padding-top: 18rpx; }
.cloud-title { font-size: 23rpx; color: #98a2b5; margin-bottom: 14rpx; }
.cloud-row { display: flex; flex-wrap: wrap; align-items: baseline; gap: 16rpx 26rpx; line-height: 1.5; }
.cloud-w { font-weight: 700; }
.cloud-n { font-size: 20rpx; color: #b3bdcf; font-weight: 400; margin-left: 4rpx; }

/* 连续低日提醒 */
.low-tip { margin-top: 16rpx; padding: 16rpx 20rpx; border-radius: 12rpx; background: #fff7ef; border: 1rpx solid #ffdcc9;
  font-size: 26rpx; color: #b06a3c; line-height: 1.7; }

/* 正向鼓励条（与低日提醒互斥） */
.high-tip { margin-top: 16rpx; padding: 16rpx 20rpx; border-radius: 12rpx; background: #eefaf1;
  border: 1rpx solid #cdeeda; font-size: 26rpx; color: #2f7d4f; line-height: 1.7; }

/* 本周最好一天（正向叙事条） */
.best-tip { margin-top: 10rpx; padding: 12rpx 16rpx; background: #fffaf0;
  border: 1rpx solid #f5e6c4; border-radius: 10rpx; font-size: 24rpx;
  color: #966a2b; line-height: 1.65; }

.week-row { display:flex; gap:18rpx; align-items:flex-end; justify-content:space-around; margin:14rpx 0; }
.week-col { display:flex; flex-direction:column; align-items:center; gap:6rpx; width: 22%; }
.week-bar-bg { height:120rpx; width:44rpx; background:#f0f2f7; border-radius:8rpx; display:flex; align-items:flex-end; overflow:hidden; }
.week-bar { width:100%; background:#a9bff5; border-radius:8rpx; }
.week-bar.cur { background:#4f7ef0; }
.week-num { font-size:24rpx; color:#33415c; font-weight:600; }
.week-label { font-size:20rpx; color:#98a2b6; }

.one-liner { display:flex; align-items:flex-start; gap:12rpx; background:#f3f8ff; border:1rpx solid #dcebfb; }
.one-liner .ol-mark { font-size:32rpx; line-height:1.4; }
.one-liner .ol-text { font-size:28rpx; line-height:1.6; color:#33415c; }

.mix-wrap { margin-top: 20rpx; }
.mix-bar { display: flex; height: 22rpx; border-radius: 99rpx; overflow: hidden; background: #eef0f5; }
.mix-seg { height: 100%; }
.mix-legend { display: flex; flex-wrap: wrap; margin-top: 14rpx; }
.mix-item { display: flex; align-items: center; margin: 6rpx 22rpx 6rpx 0; }
.mix-dot { width: 16rpx; height: 16rpx; border-radius: 50%; margin-right: 8rpx; }
.mix-name { font-size: 22rpx; color: #6b7690; }

.month-copy { display: inline-block; margin-top: 12rpx; font-size: 22rpx; color: #5b8def; background: #eef3ff; border-radius: 999rpx; padding: 8rpx 22rpx; }
