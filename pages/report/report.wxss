.center { text-align: center; }
.big { font-size: 90rpx; margin: 24rpx 0; }
.go { width: 60%; margin-top: 24rpx; }

.hero { text-align: center; }
.hero-emoji { font-size: 120rpx; margin: 20rpx 0; }
.hero-label { font-size: 32rpx; font-weight: 600; }
.hero-stats { display: flex; justify-content: center; gap: 80rpx; margin-top: 24rpx; }
.hero-item { display: flex; flex-direction: column; align-items: center; }
.num { font-size: 44rpx; font-weight: 700; color: #5b8def; }
.unit { font-size: 24rpx; color: #9ca3af; }

.advice { font-size: 28rpx; line-height: 1.7; }
.full { width: 100%; }
.mt { margin-top: 20rpx; }
.hrow { display: flex; align-items: center; padding: 16rpx 0; border-bottom: 1rpx solid #f3f4f6; }
.hrow:last-child { border-bottom: none; }
.hdate { font-size: 24rpx; color: #9ca3af; width: 180rpx; flex-shrink: 0; }
.htext { font-size: 26rpx; }

/* 分享卡浮层 */
.mask { position: fixed; inset: 0; background: rgba(20, 26, 40, 0.55); display: flex; align-items: center; justify-content: center; z-index: 999; }
.sheet { width: 640rpx; background: #fff; border-radius: 32rpx; padding: 32rpx; display: flex; flex-direction: column; align-items: center; }
.sheet-tip { font-size: 24rpx; margin-bottom: 20rpx; text-align: center; }
.tpls { display: flex; gap: 16rpx; margin-bottom: 20rpx; }
.tpl { padding: 12rpx 28rpx; border-radius: 999rpx; font-size: 25rpx; color: #7b88a2; background: #f0f3fa; border: 2rpx solid transparent; }
.tpl.on { color: #5b8def; border-color: #5b8def; background: #eef4ff; font-weight: 600; }
.rowbtns { width: 100%; display: flex; flex-direction: column; gap: 16rpx; margin-top: 24rpx; }
/* 本周 vs 上周均值 */
.avg-line { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 14rpx; margin-top: 18rpx; padding-top: 16rpx; border-top: 1rpx dashed #e4eaf3; }
.avg-num { font-size: 26rpx; font-weight: 700; color: #3f6fd8; }
.avg-cmp { font-size: 23rpx; color: #8a97ad; }
.avg-delta { font-size: 23rpx; color: #28a06b; font-weight: 600; }
.avg-delta.down { color: #c25b3a; }
