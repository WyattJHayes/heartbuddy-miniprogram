<view class="wrap">
  <view class="logo">🌱</view>
  <view class="title">心语伴</view>
  <view class="slogan">随时在线的情绪陪伴者</view>

  <!-- 今日一句：每天换一句话给你 -->
  <view class="welcome-line" wx:if="{{todayLine}}" bindtap="copyTodayLine" role="button" aria-label="今日一句，点击复制">{{todayLine}}</view>
  <view class="welcome-week" wx:if="{{weekGreet}}" role="note" aria-label="星期特别句">{{weekGreet}}</view>

  <!-- 来自朋友的分享 -->
  <view class="share-banner" wx:if="{{shared}}">
    🌱 你的朋友把「心语伴」分享给了你。看完须知就能开始，随时聊聊。
  </view>

  <!-- 快捷入口：演示/新用户 1 步触发核心能力 -->
  <view class="quick-entries">
    <view class="qentry q-last" wx:if="{{lastRoute}}" bindtap="goLast">
      <view class="qe-emoji">↩️</view>
      <view class="qe-t">{{lastLabel}}</view>
      <view class="qe-d">接着上次的节奏</view>
    </view>
    <view class="qentry q-chat" bindtap="goChat">
      <view class="qe-emoji">💬</view>
      <view class="qe-t">和心语聊聊</view>
      <view class="qe-d">AI 情绪陪伴对话</view>
    </view>
    <view class="qentry q-mood" bindtap="goMood">
      <view class="qe-emoji">🎨</view>
      <view class="qe-t">记此刻心情</view>
      <view class="qe-d">一笔一画 · 情绪可视化</view>
    </view>
    <view class="qentry q-test" bindtap="goTest">
      <view class="qe-emoji">📋</view>
      <view class="qe-t">情绪自评</view>
      <view class="qe-d">7 题 · 约 3 分钟</view>
    </view>
    <view class="qentry q-breathe" bindtap="goBreathe">
      <view class="qe-emoji">🌬️</view>
      <view class="qe-t">去呼吸</view>
      <view class="qe-d">4 分钟帮身体先松下来</view>
    </view>
  </view>

  <!-- 考试当天早晨：就是今天——把「考试」交给稳的早晨 -->
  <view class="exam-morning" wx:if="{{examMorning}}" role="note" aria-label="考试当天早晨清单">
    <view class="em-title">就是今天：{{examMorning.name}} 🍀</view>
    <view class="em-line">① 早喝一杯温水，慢慢来</view>
    <view class="em-line">② 吃和平常一样的早饭：胃稳了心才稳</view>
    <view class="em-line">③ 证件笔放门口，出门前扫一眼</view>
    <view class="em-line">④ 路上做 3 次深呼吸，把「难」换成「到考场再说」</view>
    <view class="em-line">⑤ 到场先对自己说：你已经准备很久了</view>
  </view>

  <view class="nurture" role="group" aria-label="今日滋养三连">
    <view class="nu-key">今天滋养过了吗？</view>
    <view class="nu-row">
      <view class="nu-chip {{nurture.water ? 'on' : ''}}" data-k="water" bindtap="toggleNurture" role="button" aria-label="喝水打卡">💧 喝水</view>
      <view class="nu-chip {{nurture.food ? 'on' : ''}}" data-k="food" bindtap="toggleNurture" role="button" aria-label="好好吃饭打卡">🍚 好好吃饭</view>
      <view class="nu-chip {{nurture.sleep ? 'on' : ''}}" data-k="sleep" bindtap="toggleNurture" role="button" aria-label="睡够了打卡">😴 睡够了</view>
    </view>
  </view>

  <!-- 本周小结：这一周你照顾自己的总账 -->
  <view class="week-care" wx:if="{{weekCare}}" role="note" aria-label="本周照顾小结">
    <view class="wc-key">这一周你做过的照顾</view>
    <view class="wc-row">
      <text class="wc-val" wx:if="{{weekCare.relaxMin}}">🌬 放松 {{weekCare.relaxMin}} 分</text>
      <text class="wc-val" wx:if="{{weekCare.scanN}}">🧘 扫描 {{weekCare.scanN}} 次</text>
      <text class="wc-val" wx:if="{{weekCare.smallN}}">📝 三件小事 {{weekCare.smallN}} 天</text>
      <text class="wc-none" wx:if="{{!weekCare.relaxMin && !weekCare.scanN && !weekCare.smallN}}">这周先别急着添任务——从今天喘口气开始 🌿</text>
    </view>
  </view>

  <!-- 今日状态卡：今天对自己照顾了什么（临时备注口径，点击直达） -->
  <view class="today-care" wx:if="{{todayCare}}" role="note" aria-label="今日照顾状态，点击直达">
    <view class="tc-line">
      <text class="tc-key">今日照顾</text>
      <text class="tc-val tap" wx:if="{{todayCare.relaxMin}}" data-r="breathe" bindtap="goTodayTap">🌬 放松 {{todayCare.relaxMin}} 分</text>
      <text class="tc-val tap" wx:if="{{todayCare.scanN}}" data-r="scan" bindtap="goTodayTap">🧘 扫描 {{todayCare.scanN}} 次</text>
      <text class="tc-val tap" wx:if="{{todayCare.mood}}" data-r="mood" bindtap="goTodayTap">🎨 记了心情</text>
      <text class="tc-val tap" wx:if="{{todayCare.small}}" data-r="mood" bindtap="goTodayTap">📝 三件小事</text>
      <text class="tc-none" wx:if="{{!todayCare.relaxMin && !todayCare.scanN && !todayCare.mood && !todayCare.small}}">今天还没有照顾自己的记录——从一次呼吸开始 🍃</text>
    </view>
  </view>

  <!-- 把温柔带给朋友：今日一句即成分享首页 -->
  <button class="share-line" open-type="share">💌 把今天这句分享给朋友</button>

  <!-- 第一次来：4 步教你用心语伴（一次性，看过就收起） -->
  <view class="card first-guide" wx:if="{{!welcomed}}" role="note" aria-label="第一次使用引导">
    <view class="section-title">第一次来？4 步开始 🌱</view>
    <view class="fg-item" bindtap="goFromGuide" data-u="/pages/chat/chat"><text class="fg-num">1</text>心里有事 → 去「陪伴」和心语聊聊，它会接住你</view>
    <view class="fg-item" bindtap="goFromGuide" data-u="/pages/mood/mood"><text class="fg-num">2</text>顺手记心情 → 「心情」页一键记录，周报自动生成</view>
    <view class="fg-item" bindtap="goFromGuide" data-u="/pages/breathe/breathe"><text class="fg-num">3</text>紧绷的时候 → 「呼吸」页 4 分钟帮身体先松下来</view>
    <view class="fg-item" bindtap="goFromGuide" data-u="/pages/helper/helper"><text class="fg-num">4</text>难受的时候 → 「求助」页有热线，「充电站」有能马上做的事</view>
    <view class="fg-ok" bindtap="hideGuide" role="button" aria-label="收起新手引导">知道了，开始吧</view>
    <view class="fg-skip" bindtap="hideGuide" role="button" aria-label="直接进入须知">跳过引导，直接开始 ›</view>
  </view>

  <!-- 更新日志：最新版本做了什么（可折叠） -->
  <view class="card changelog-card">
    <view class="cl-head">
      <view class="cl-title" bindtap="toggleLog" role="button" aria-label="展开或收起更新日志">
        <text>🆕 最近更新了什么</text>
        <text class="cl-arrow {{showLog ? 'up' : ''}}">▾</text>
      </view>
      <view class="cl-copy" bindtap="copyLog" role="button" aria-label="复制版本说明">📋 复制</view>
    </view>
    <view class="cl-list" wx:if="{{showLog}}">
      <view class="cl-item" wx:for="{{changelog}}" wx:key="v">
        <text class="cl-v">v{{item.v}}</text>
        <text class="cl-t">{{item.t}}</text>
      </view>
    </view>
  </view>

  <!-- 你是谁：帮助心语更贴近你（可选，本地记住，不涉及账号） -->
  <view class="card role-card">
    <view class="section-title">谁在用你？<text class="muted">（选一个更贴，可不选）</text></view>
    <view class="role-row">
      <view class="role-chip {{role === 'student' ? 'on' : ''}}" data-r="student" bindtap="pickRole" role="button" aria-label="我是学生">🎒 学生</view>
      <view class="role-chip {{role === 'teacher' ? 'on' : ''}}" data-r="teacher" bindtap="pickRole" role="button" aria-label="我是老师">📚 老师</view>
      <view class="role-chip {{role === 'parent' ? 'on' : ''}}" data-r="parent" bindtap="pickRole" role="button" aria-label="我是家长">🏠 家长</view>
      <view class="role-chip {{role === 'other' ? 'on' : ''}}" data-r="other" bindtap="pickRole" role="button" aria-label="其他身份">🌱 其他</view>
    </view>
    <view class="role-hint" wx:if="{{roleTip}}">{{roleTip}}</view>
  </view>

  <view class="card notice">
    <view class="section-title">在开始前，请了解</view>
    <view class="item">· 我是 AI 心理陪伴助手，<text class="hl">不替代专业诊疗</text>。</view>
    <view class="item">· 对话中涉及的情绪数据仅用于功能服务，<text class="hl">不会泄露给第三方</text>。</view>
    <view class="item">· 如遇紧急情绪波动，请优先查看「求助」页的热线。</view>
    <view class="item text-muted">点击「同意并开始」即表示你已阅读并同意上述说明。</view>
    <view class="link" bindtap="openNotice">阅读《用户须知与免责声明》全文 ›</view>
  </view>

  <button class="btn-primary agree" bindtap="agree">同意并开始</button>
</view>

<!-- 用户须知与免责声明 -->
<view class="notice-mask" wx:if="{{showNotice}}" bindtap="closeNotice">
  <view class="notice-sheet" catchtap="noop">
    <view class="ns-title">用户须知与免责声明</view>
    <scroll-view scroll-y class="ns-body">
      <view class="ns-h">一、服务定位</view>
      <view class="ns-p">心语伴是一款基于大语言模型的 AI 情绪陪伴小程序，面向备考学生等群体提供情绪倾诉、情绪记录与自助式建议。本工具不提供心理诊断、治疗或任何医疗服务。</view>

      <view class="ns-h">二、使用说明</view>
      <view class="ns-p">· 你可以随时与 AI 对话倾诉，回复由大模型生成，可能存在误差或不适之处。</view>
      <view class="ns-p">· 「心情」「周报」「自评」等功能会记录你的情绪标签与自评得分，用于生成建议与可视化，属于必要功能数据。</view>

      <view class="ns-h">三、隐私与数据</view>
      <view class="ns-p">· 我们不收集你的姓名、手机号、位置、通讯录等敏感信息。</view>
      <view class="ns-p">· 对话正文不写入数据库，仅为本次会话使用；情绪标签、自评结果与危机预警（触发时间与等级）会脱敏存库，用于改进产品安全。</view>

      <view class="ns-h">四、免责声明</view>
      <view class="ns-p">AI 内容仅供自助参考，不构成医疗、心理诊断或治疗建议。若你正处于自伤/他伤风险之中，请立即：
        拨打全国心理援助热线 <text class="ns-strong">12356</text>，或 120，或直接联系身边信任的人；紧急情况下请使用「求助」页提供的所有可用途径。</view>

      <view class="ns-h">五、反馈与撤回</view>
      <view class="ns-p">你可以通过「我的」→ 意见反馈告诉我们如何改进；如希望停止使用，关闭即可，相关数据按微信及云开发平台规则处理。</view>
    </scroll-view>
    <button class="btn-primary full" bindtap="closeNotice">我知道了</button>
  </view>

  <!-- 版本透明 footer：当前版本 + 一句话说明 AI 边界与数据去留 -->
  <view class="wf-version" role="note" aria-label="版本与边界说明">
    <view class="wf-v">心语伴 · v2.20（持续迭代中）</view>
    <view class="wf-open" wx:if="{{openCount >= 2}}">你已经回来过 {{openCount}} 次了，谢谢你在 🌿</view>
    <view class="wf-s">AI 是陪伴者，不是医生 · 对话临时留在本机，情绪记录存在你自己的云端</view>
  </view>
</view>