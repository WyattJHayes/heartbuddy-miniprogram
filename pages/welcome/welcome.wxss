.wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 48rpx 48rpx;
}

.logo { font-size: 120rpx; }

/* 今日一句：每天一句话，点击可复制 */
.welcome-line { margin: 20rpx 8rpx 0; max-width: 560rpx; text-align: center; font-size: 27rpx; line-height: 1.8;
  color: #6b87a8; background: #eef3fb; padding: 16rpx 28rpx; border-radius: 999rpx; }
.title { font-size: 48rpx; font-weight: 700; margin-top: 16rpx; }
.slogan { color: #9ca3af; margin: 8rpx 0 48rpx; }

/* 快捷入口 */
.quick-entries { display: flex; gap: 24rpx; width: 100%; margin-bottom: 40rpx; }
.qentry {
  flex: 1; background: #fff; border: 2rpx solid #dbe4f8; border-radius: 24rpx;
  padding: 28rpx 24rpx; display: flex; flex-direction: column; gap: 6rpx;
}
.qentry:active { transform: scale(0.98); }
.q-chat { background: linear-gradient(135deg, #eef3ff, #dbe8ff); border-color: #b9cdf5; }
.q-test { background: linear-gradient(135deg, #fff7ed, #ffe9d6); border-color: #f3d9b0; }
.q-breathe { background: linear-gradient(135deg, #eefaf1, #d9f3e3); border-color: #bfe6cd; }
.share-line { width: 100%; margin: -12rpx 0 32rpx; font-size: 24rpx; color: #5b8def; background: #f5f8ff; border: 1rpx dashed #b9cdf5; border-radius: 999rpx; padding: 16rpx 0; line-height: 1; }
.wf-version { margin-top: 40rpx; text-align: center; }
.wf-v { font-size: 23rpx; color: #8b96b0; font-weight: 600; }
.wf-s { margin-top: 8rpx; font-size: 21rpx; color: #a9b2c4; line-height: 1.7; padding: 0 30rpx; }
.qe-emoji { font-size: 44rpx; }
.qe-t { font-size: 30rpx; font-weight: 700; color: #3a4a63; }
.qe-d { font-size: 22rpx; color: #8b96b0; }

.card { width: 100%; }
.item { font-size: 28rpx; line-height: 1.7; margin-bottom: 12rpx; }
.hl { color: #5b8def; font-weight: 500; }

.agree { width: 100%; margin-top: 32rpx; }

.link { margin-top: 18rpx; color: #5b8def; font-size: 26rpx; text-decoration: underline; }

/* 用户须知弹窗 */
.notice-mask { position: fixed; inset: 0; background: rgba(20, 26, 40, 0.55); display: flex; align-items: center; justify-content: center; z-index: 999; }
.notice-sheet { width: 640rpx; max-height: 80vh; background: #fff; border-radius: 32rpx; padding: 36rpx 32rpx 28rpx; display: flex; flex-direction: column; }
.ns-title { font-size: 34rpx; font-weight: 700; text-align: center; margin-bottom: 20rpx; }
.ns-body { flex: 1; max-height: 48vh; }
.ns-h { font-size: 28rpx; font-weight: 700; color: #3a4a63; margin: 20rpx 0 8rpx; }
.ns-p { font-size: 25rpx; line-height: 1.75; color: #5b6b85; margin-bottom: 8rpx; }
.ns-strong { color: #e05c53; font-weight: 600; }
.notice-sheet .btn-primary { margin-top: 20rpx; }
.full { width: 100%; }
.share-banner { width: 100%; box-sizing: border-box; margin: 0 auto 24rpx; max-width: 620rpx; background: #eaf3ff; color: #4568c8; border: 1rpx solid #cfe1ff; border-radius: 16rpx; padding: 18rpx 24rpx; font-size: 25rpx; line-height: 1.6; }
.q-mood { background: linear-gradient(135deg, #eef9f0, #d9f0df); border-color: #b5dcbe; }

.first-guide { border: 1rpx solid #dbe9d5; background: #f7fbf5; }
.fg-item { display: flex; align-items: flex-start; font-size: 25rpx; color: #4a5a4e; line-height: 1.7; margin-top: 12rpx; }
.fg-num { flex-shrink: 0; width: 36rpx; height: 36rpx; line-height: 36rpx; text-align: center; border-radius: 50%; background: #6fae7f; color: #fff; font-size: 22rpx; margin-right: 14rpx; margin-top: 6rpx; }
.fg-ok { margin-top: 18rpx; background: #6fae7f; color: #fff; text-align: center; border-radius: 999rpx; padding: 14rpx 0; font-size: 26rpx; }

.changelog-card { border: 1rpx solid #dbe7fb; background: #f7faff; }
.cl-head { display: flex; align-items: center; justify-content: space-between; }
.cl-title { display: flex; align-items: center; gap: 8rpx; font-size: 26rpx; font-weight: 600; color: #3f5c95; flex: 1; }
.cl-copy { font-size: 22rpx; color: #8a95ad; padding: 4rpx 14rpx; background: #f2f5fc; border-radius: 999rpx; }
.cl-arrow { color: #b0b7c8; transition: transform .2s; }
.cl-arrow.up { transform: rotate(180deg); }
.cl-list { margin-top: 12rpx; }
.cl-item { display: flex; margin-top: 10rpx; }
.cl-v { flex-shrink: 0; width: 90rpx; font-size: 22rpx; color: #5b8def; font-weight: 700; }
.cl-t { flex: 1; font-size: 22rpx; color: #5b6b8c; line-height: 1.7; }

.fg-skip { margin-top: 12rpx; text-align: center; font-size: 22rpx; color: #9aa3b8; }

.fg-item:active { opacity: .6; }

.qentry.q-last { border: 2rpx dashed #b9c9e8; background: #f6f9ff; }

/* 今日状态卡 */
.today-care { margin-top: 16rpx; background: #f6f9ff; border: 1rpx solid #dbe6f8; border-radius: 14rpx; padding: 14rpx 18rpx; }
.tc-line { display: flex; flex-wrap: wrap; gap: 12rpx; align-items: center; font-size: 24rpx; }
.tc-key { font-weight: 600; color: #4a6a9a; }
.tc-val { color: #6b86b8; background: #eaf2ff; border-radius: 20rpx; padding: 4rpx 14rpx; }
.tc-none { color: #9aa8bd; }

/* 谁在用 */
.role-card { }
.role-row { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 12rpx; }
.role-chip { padding: 10rpx 26rpx; border-radius: 28rpx; background: #f1f4fa; color: #6b7a8e; font-size: 24rpx; }
.role-chip.on { background: #e3eeff; color: #3f6aa8; }
.role-hint { margin-top: 12rpx; font-size: 23rpx; color: #7a88a0; background: #f6f9ff; border-radius: 10rpx; padding: 12rpx 14rpx; line-height: 1.6; }

.tc-val.tap { border: 1rpx solid transparent; }
.tc-val.tap:active { border-color: #3f6aa8; background: #dcebff; }

.wf-open { margin-top: 6rpx; font-size: 21rpx; color: #9aa8bd; }

.week-care { margin-top: 12rpx; background: #f7faf5; border: 1rpx solid #e3ecdc; border-radius: 14rpx; padding: 14rpx 16rpx; }
.wc-key { font-size: 23rpx; color: #7a8a6a; margin-bottom: 8rpx; }
.wc-row { display: flex; flex-wrap: wrap; gap: 10rpx; }
.wc-val { color: #5f8a4f; background: #eaf4e6; border-radius: 18rpx; padding: 4rpx 14rpx; font-size: 23rpx; }
.wc-none { font-size: 22rpx; color: #9aa88a; }

.nurture { margin-top: 12rpx; display: flex; align-items: center; gap: 10rpx; flex-wrap: wrap; }
.nu-key { font-size: 23rpx; color: #8a93a8; }
.nu-row { display: flex; gap: 10rpx; flex-wrap: wrap; }
.nu-chip { padding: 8rpx 20rpx; border-radius: 24rpx; background: #f2f5fa; color: #7a8ba0; font-size: 23rpx; }
.nu-chip.on { background: #e3f6e3; color: #3f7a4f; }
